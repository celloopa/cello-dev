{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cello-kit.invalid/household/chore.schema.json",
  "title": "HouseholdChore",
  "description": "Payload of kind crest.chore: a recurring chore the household shares. It carries its own title, because the task behind it stays in the planner of whoever made it.",
  "x-schemaVersion": 1,
  "type": "object",
  "required": ["title", "rhythm", "who", "since", "doneDays", "handedOver"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "rhythm": { "$ref": "#/$defs/rhythm" },
    "who": {
      "type": "string",
      "maxLength": 200,
      "description": "A member id, or empty when it's anyone's. Never a typed name, and never relative to the reader: Crest's own 'nil is Cello' stops at its door."
    },
    "since": { "$ref": "#/$defs/day" },
    "doneDays": { "type": "array", "items": { "$ref": "#/$defs/day" }, "uniqueItems": true },
    "handedOver": { "type": "array", "items": { "$ref": "#/$defs/day" }, "uniqueItems": true }
  },
  "additionalProperties": false,
  "$defs": {
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A local day." },
    "rhythm": {
      "title": "HouseholdChoreRhythm",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "title": "HouseholdChoreRhythmKind", "enum": ["weekdays", "everyNDays"] },
        "weekdayMinutes": {
          "type": "object",
          "description": "ISO weekday, 1 is Monday, to minutes.",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[1-7]$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "days": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "weekdays" } } },
          "then": { "required": ["weekdayMinutes"] },
          "else": { "required": ["days", "minutes"] }
        }
      ]
    }
  }
}
