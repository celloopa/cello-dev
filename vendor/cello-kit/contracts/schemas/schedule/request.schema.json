{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cello-kit.invalid/schedule/request.schema.json",
  "title": "ScheduleRequest",
  "x-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "source",
    "sourceId",
    "revision",
    "intent",
    "kind",
    "title",
    "durationMinutes",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260
    },
    "source": {
      "type": "string",
      "const": "exercise"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intent": {
      "enum": [
        "schedule",
        "cancel"
      ]
    },
    "kind": {
      "type": "string",
      "const": "workout"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "deepLink": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^exercise://[^?\\s#]+$"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
