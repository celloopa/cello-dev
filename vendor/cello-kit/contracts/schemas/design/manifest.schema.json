{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cello-kit.invalid/design/manifest.schema.json",
  "title": "DesignManifest",
  "description": "Everything an agent or app needs to build with the kit's UI in one document (decision 18): the semantic roles, every app mode with its values and where each came from, the Figma ledger, the shared components with their states and stories, and the API contracts. Generated by `pnpm design:manifest` into design/manifest.json and served read-only by the kit's service (GET /v1/design/manifest, MCP tool design_manifest, `kit design manifest`). Never hand-edited.",
  "x-schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "kit", "generatedAt", "sources", "css", "roles", "modes", "space", "figma", "components", "contracts", "notes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kit": {
      "type": "object",
      "description": "The kit release this manifest was built from: the root package's name and version, and each workspace package's version.",
      "required": ["name", "version", "packages"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "packages": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 50 } }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time", "description": "When the content last changed. Regenerating without a change keeps it." },
    "sources": {
      "type": "object",
      "description": "The repo files the manifest was built from, relative to the kit's root.",
      "required": ["roles", "tokenSources", "tokenSync", "figmaLedger", "components", "contracts"],
      "additionalProperties": false,
      "properties": {
        "roles": { "type": "string" },
        "tokenSources": { "type": "string" },
        "tokenSync": { "type": "string" },
        "figmaLedger": { "type": "string" },
        "components": { "type": "string" },
        "contracts": { "type": "string" }
      }
    },
    "css": {
      "type": "object",
      "description": "How the roles reach CSS: every role is a custom property (prefix + role with / as -), set per mode under the mode selector, from the tokens package's stylesheet.",
      "required": ["prefix", "modeAttribute", "stylesheet"],
      "additionalProperties": false,
      "properties": {
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "modeAttribute": { "type": "string", "pattern": "^data-[a-z0-9-]+$" },
        "stylesheet": { "type": "string", "description": "The import an app adds, e.g. @scope/tokens/tokens.css." }
      }
    },
    "roles": {
      "type": "array",
      "description": "Every semantic role. Components bind only to these.",
      "items": {
        "type": "object",
        "required": ["name", "type", "cssVar"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/roleName" },
          "type": { "enum": ["color", "number", "string"], "description": "color: hex (8 digits = RGBA). number: px (radii). string: a font family name." },
          "cssVar": { "type": "string", "pattern": "^--[a-z0-9-]+$" }
        }
      }
    },
    "modes": {
      "type": "array",
      "description": "One mode per app theme. An app sets the mode attribute on its root (or any subtree) to its slug.",
      "items": { "$ref": "#/$defs/mode" }
    },
    "space": {
      "type": "object",
      "description": "The kit's spacing steps in px, the same in every mode.",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "figma": {
      "type": "object",
      "description": "The Figma file the primitives are designed in (design/figma-ledger.json).",
      "required": ["fileKey", "url"],
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "team": { "type": "string" },
        "collections": { "$ref": "#/$defs/idMap" },
        "modes": { "$ref": "#/$defs/idMap" },
        "pages": { "$ref": "#/$defs/idMap" },
        "components": { "$ref": "#/$defs/idMap" },
        "variables": { "$ref": "#/$defs/idMap" },
        "textStyles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": {
      "type": "array",
      "description": "The shared primitives, with their states, the contracts they render and links to their stories.",
      "items": { "$ref": "#/$defs/component" }
    },
    "contracts": {
      "type": "array",
      "description": "Every API contract (JSON Schema in the kit's contracts/), with its schema.",
      "items": {
        "type": "object",
        "required": ["path", "id", "title", "schemaVersion", "schema"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z]+/[a-z-]+$", "description": "<area>/<name>, e.g. tickets/ticket." },
          "id": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "schema": { "type": "object", "description": "The schema as published in the contracts package." }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Notes on the role values (design/kit-roles.json)." }
  },
  "$defs": {
    "roleName": { "type": "string", "pattern": "^[a-z]+(?:[/-][a-z0-9]+)*$" },
    "idMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "value": { "type": ["string", "number"] },
    "modeValue": {
      "title": "DesignModeValue",
      "description": "A role's value in a mode. synced: read from the app's own token source (from names the token or rule). unsynced: the kit keeps its current value, for the reason given.",
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "sync", "from"],
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/value" }, "sync": { "const": "synced" }, "from": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["value", "sync", "reason"],
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/value" }, "sync": { "const": "unsynced" }, "reason": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "mode": {
      "title": "DesignMode",
      "type": "object",
      "required": ["name", "slug", "selector", "app", "source", "values"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "selector": { "type": "string", "description": "The CSS selector that turns the mode on, e.g. [data-kit-mode=\"ghosted-light\"]." },
        "figmaModeId": { "type": "string" },
        "app": { "type": "string", "description": "The app whose tokens the mode follows." },
        "source": {
          "type": "object",
          "description": "The app's token source as the last sync found it: read (with its commit) or not (with why).",
          "required": ["file", "read"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string" },
            "read": { "type": "boolean" },
            "commit": { "type": ["string", "null"] },
            "dirty": { "type": "boolean" },
            "reason": { "type": "string" },
            "syncedAt": { "type": "string", "format": "date-time" }
          }
        },
        "values": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/roleName" },
          "additionalProperties": { "$ref": "#/$defs/modeValue" }
        }
      }
    },
    "component": {
      "title": "DesignComponent",
      "type": "object",
      "required": ["name", "label", "status", "summary", "axes", "states", "contracts", "stories"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "label": { "type": "string" },
        "status": { "enum": ["planned", "building", "built", "retired"], "description": "planned: designed in Figma, not in code. building: in code, not released. built: released with its stories. retired: kept only for old pins." },
        "summary": { "type": "string" },
        "platform": { "enum": ["web", "watchOS"], "description": "Where the component is built. Absent means web (packages/ui); watchOS is swift/CelloWatch (design/watch.md)." },
        "figma": {
          "type": "object",
          "required": ["componentSet", "componentSetId"],
          "additionalProperties": false,
          "properties": {
            "componentSet": { "type": "string" },
            "componentSetId": { "type": "string" },
            "page": { "type": "string" },
            "pageId": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "axes": { "type": "object", "description": "Figma variant properties and their values.", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "states": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "codeOnlyStates": { "type": "array", "items": { "type": "string" }, "description": "States left to code, not drawn in Figma (Hover, Pressed)." },
        "rules": { "type": "array", "items": { "type": "string" } },
        "contracts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+/[a-z-]+$" }, "description": "The contracts whose states the component renders." },
        "stories": {
          "type": "array",
          "description": "Links to the component's stories (empty until the UI package exists).",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    }
  }
}
