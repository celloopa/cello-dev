{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cello-kit.invalid/ai/usage-record.schema.json",
  "title": "AiUsageRecord",
  "description": "What one model call took: counts only, never prompt or answer text. A JSON retry is a second call and a second record. From Ghosted's CallUsage and onUsage.",
  "x-schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "at", "feature", "model", "ms", "ok", "inputTokens", "cachedTokens", "outputTokens", "reasoningTokens"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "at": { "type": "string", "format": "date-time" },
    "feature": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "effort": { "enum": ["low", "medium", "high"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 100, "description": "The model that actually ran the call." },
    "fallback": { "type": "boolean", "description": "It stood in for a busy model." },
    "ms": { "type": "integer", "minimum": 0 },
    "ok": { "type": "boolean" },
    "failure": { "$ref": "failure.schema.json#/$defs/failureKind" },
    "inputTokens": { "type": "integer", "minimum": 0 },
    "cachedTokens": { "type": "integer", "minimum": 0, "description": "Of the input tokens, how many the prompt cache served." },
    "outputTokens": { "type": "integer", "minimum": 0 },
    "reasoningTokens": { "type": "integer", "minimum": 0, "description": "Of the output tokens, how many were reasoning. 0 when the provider doesn't say." },
    "user": { "type": "string", "maxLength": 200, "description": "An opaque user ref, never an email." }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "ok": { "const": false } } }, "then": { "required": ["failure"] } },
    { "if": { "properties": { "ok": { "const": true } } }, "then": { "not": { "required": ["failure"] } } }
  ]
}
