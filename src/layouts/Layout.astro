---
import { ClientRouter } from "astro:transitions";
import { basics } from "@cv";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
import "@fontsource/geist-mono/800.css";
import "@fontsource/geist-mono/900.css";
import geistMono400 from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
import geistMono700 from "@fontsource/geist-mono/files/geist-mono-latin-700-normal.woff2?url";
import "@fontsource-variable/national-park";
import nationalParkLatin from "@fontsource-variable/national-park/files/national-park-latin-wght-normal.woff2?url";
import "@/styles/colors.css";
import "@/styles/animations.css";
import "@/styles/print.css";
import Header from "@/components/Header.astro";
import ThemeInit from "@/components/ThemeInit.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";
import AnimatedLogo from "@/components/AnimatedLogo.astro";
import Mail from "@/icons/Mail.astro";
import GitHub from "@/icons/GitHub.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import Bsky from "@/icons/Bsky.astro";
import type { SocialIcon } from "@/types";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
}

const siteName = "Cello - Product Designer & Design Engineer";
const siteDescription =
  "Product designer and design engineer focused on design systems and human-centered AI tools. I build and run what I design.";
const siteImage = "/images/thumbnail.png";

const {
  title = siteName,
  description = siteDescription,
  image,
  canonicalPath,
} = Astro.props;
const { url, email, profiles } = basics;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, url).toString() : url;
const ogImage = image
  ? new URL(image, url).toString()
  : new URL(siteImage, url).toString();
const currentYear = new Date().getFullYear();

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  Bsky,
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#001A11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3EDE2" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href={geistMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nationalParkLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/logos/SVG/full-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/logos/SVG/full-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeInit />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="texture-layer" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="content-layer">
      <Header />
      <main transition:name="page">
        <slot />
      </main>
      <footer class="site-footer no-print">
        <div class="footer-inner">
          <div class="footer-row footer-row--top">
            <a href="/" class="footer-logo" aria-label="Home">
              <AnimatedLogo />
            </a>
            <nav class="footer-nav" aria-label="Footer navigation">
              <a href="/projects">Work</a>
              <!--<a href="/lab">Lab</a>-->
              <!--<a href="/blog">Writing</a>-->
              <!--<a href="/visuals">Visuals</a>-->
              <a href="/resume">Resume</a>
            </nav>
          </div>
          <div class="footer-row footer-row--bottom">
            <ul class="footer-socials" aria-label="Social links">
              {
                email && (
                  <li>
                    <a
                      href={`mailto:${email}`}
                      title="Email"
                      aria-label="Email Marcelo Rondon"
                    >
                      <Mail />
                    </a>
                  </li>
                )
              }
              {
                profiles.map(({ network, url }) => {
                  const Icon = SOCIAL_ICONS[network];
                  if (!Icon) return null;

                  return (
                    <li>
                      <a
                        href={url}
                        title={network}
                        aria-label={network === "Bsky" ? "Bluesky" : network}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon />
                      </a>
                    </li>
                  );
                })
              }
            </ul>
            <span class="footer-meta">
              © {currentYear} Cello Rondon · Built in Astro
            </span>
          </div>
        </div>
      </footer>
      <KeyboardManager />
    </div>
    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        let revealObserver;

        function initReveals() {
          revealObserver?.disconnect();
          const els = document.querySelectorAll(
            "[data-reveal]:not(.is-revealed)",
          );
          if (!("IntersectionObserver" in window) || reducedMotion.matches) {
            els.forEach((el) => el.classList.add("is-revealed"));
            return;
          }
          revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  revealObserver.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px" },
          );
          els.forEach((el) => revealObserver.observe(el));
        }

        let progressTicking = false;
        function updateProgress() {
          progressTicking = false;
          const bar = document.querySelector(".scroll-progress span");
          if (!bar) return;
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const progress = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
          bar.style.transform = `scaleX(${progress})`;
        }
        function onScroll() {
          if (progressTicking) return;
          progressTicking = true;
          requestAnimationFrame(updateProgress);
        }

        function initMagnetic() {
          if (
            reducedMotion.matches ||
            !window.matchMedia("(pointer: fine)").matches
          ) {
            return;
          }
          document.querySelectorAll("[data-magnetic]").forEach((el) => {
            if (el.dataset.magneticBound) return;
            el.dataset.magneticBound = "true";
            const strength = 5;
            el.addEventListener("pointermove", (e) => {
              const r = el.getBoundingClientRect();
              const x = ((e.clientX - r.left) / r.width - 0.5) * 2;
              const y = ((e.clientY - r.top) / r.height - 0.5) * 2;
              el.style.transform = `translate(${(x * strength).toFixed(1)}px, ${(y * strength).toFixed(1)}px)`;
            });
            el.addEventListener("pointerleave", () => {
              el.style.transform = "";
            });
          });
        }

        function initAll() {
          initReveals();
          initMagnetic();
          updateProgress();
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        document.addEventListener("DOMContentLoaded", initAll);
        document.addEventListener("astro:page-load", initAll);
      })();
    </script>
    <style is:global>
      html {
        font-family: var(--font-mono);
        font-weight: var(--weight-regular);
        background: var(--bg-canvas);
        color: var(--text-primary);
        letter-spacing: 0;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      main {
        position: relative;
        z-index: 1;
        border: none;
        margin-top: 0;
        padding-top: 0;
        padding-bottom: 8rem;
      }

      figure {
        margin: 0;
        padding: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color var(--motion-ui) var(--ease-out);
      }

      a,
      button,
      [role="button"],
      summary {
        cursor: pointer;
      }

      .card,
      .lab-card,
      .path-card,
      .proof-item {
        cursor: cell;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      img,
      video {
        max-width: 100%;
      }

      :where(a, button, input, select, textarea, [tabindex]):focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 4px;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-footer {
        position: relative;
        z-index: 1;
        border-top: 3px solid var(--text-primary);
        padding: var(--space-32);
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
      }

      .footer-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-24);
      }

      .footer-row--bottom {
        margin-top: var(--space-24);
        padding-top: var(--space-20);
        border-top: 2px solid var(--border-muted);
      }

      .footer-logo {
        display: inline-flex;
        align-items: center;
        transition: transform var(--motion-ui) var(--ease-out);
      }

      .footer-logo:hover,
      .footer-logo:focus-visible {
        transform: scale(1.06);
      }

      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: var(--space-8);
      }

      .footer-nav a {
        display: block;
        position: relative;
        padding: var(--space-8) var(--space-12);
        border: 2px solid transparent;
        color: var(--text-primary);
        font-size: 0.8rem;
        font-weight: var(--weight-bold);
        letter-spacing: var(--track-wide);
        text-transform: uppercase;
        transition:
          border-color var(--motion-ui) var(--ease-out),
          color var(--motion-ui) var(--ease-out),
          transform var(--motion-ui) var(--ease-out);
      }

      .footer-nav a::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--color-accent);
        transform: translateX(-50%);
        transition: width var(--motion-ui) var(--ease-out);
      }

      .footer-nav a:hover,
      .footer-nav a:focus-visible {
        color: var(--color-accent);
        transform: translateY(-2px);
      }

      .footer-nav a:hover::after,
      .footer-nav a:focus-visible::after {
        width: 80%;
      }

      .footer-socials {
        display: flex;
        gap: var(--space-8);
        flex-wrap: wrap;
      }

      .footer-socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 2px solid var(--text-primary);
        background: var(--bg-canvas);
        color: var(--text-primary);
        transition:
          background-color var(--motion-ui) var(--ease-out),
          border-color var(--motion-ui) var(--ease-out),
          color var(--motion-ui) var(--ease-out),
          transform var(--motion-ui) var(--ease-out);
      }

      .footer-socials a:hover,
      .footer-socials a:focus-visible {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--bg-canvas);
        transform: translateY(-2px);
      }

      .footer-meta {
        color: var(--text-primary);
        font-size: 0.8rem;
        font-weight: var(--weight-bold);
        line-height: var(--leading-ui);
        letter-spacing: var(--track-caps);
        margin: 0;
        text-transform: uppercase;
        opacity: 0.82;
      }

      ::view-transition-new(root) {
        animation: wipe-in var(--motion-page-wipe) var(--ease-out);
      }

      ::view-transition-old(root) {
        animation: wipe-out var(--motion-page-wipe) var(--ease-out);
      }

      ::view-transition-group(root) {
        background: var(--color-accent);
      }

      p,
      span {
        text-align: start;
        font-size: var(--type-body-lg);
        line-height: var(--leading-read);
        margin-block: var(--space-8);
        margin-inline: 0;
        text-wrap: pretty;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      /* Bold Saul Bass typography. Titles (h1, h2) set in National Park (I4). */
      h1,
      h2,
      h3,
      h4,
      h5 {
        line-height: var(--leading-tight);
        margin-bottom: 0;
        margin-inline: 0;
        letter-spacing: 0;
      }

      h1,
      h2 {
        font-family: var(--font-title);
      }

      h1 {
        color: var(--text-primary);
        font-size: clamp(3.5rem, 10vw, 6rem);
        font-weight: var(--weight-black);
        line-height: var(--leading-display);
        margin-top: var(--space-16);
        text-transform: uppercase;
      }

      h2 {
        color: var(--color-accent);
        font-size: var(--type-section-title);
        font-weight: var(--weight-extrabold);
        text-align: start;
        margin-top: var(--space-32);
        text-transform: uppercase;
      }

      h3 {
        font-size: 1.6rem;
        font-weight: var(--weight-bold);
      }

      h4 {
        color: var(--color-accent);
        font-size: 1.2rem;
        font-weight: var(--weight-semibold);
        text-transform: uppercase;
        letter-spacing: var(--track-caps);
      }

      /* Bold selection */
      ::selection {
        background: var(--color-accent);
        color: var(--bg-canvas);
      }

      /* Scroll progress bar */
      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 5px;
        z-index: 2000;
        pointer-events: none;
      }

      .scroll-progress span {
        display: block;
        height: 100%;
        background: var(--color-accent);
        transform: scaleX(0);
        transform-origin: left;
      }

      /* Scroll-triggered reveals */
      [data-reveal] {
        opacity: 0;
        transform: translateY(26px);
        transition:
          opacity var(--motion-entry) var(--ease-out),
          transform var(--motion-entry) var(--ease-out);
        transition-delay: calc(var(--reveal-i, 0) * var(--motion-stagger));
      }

      [data-reveal="left"] {
        transform: translateX(-34px);
      }

      [data-reveal="right"] {
        transform: translateX(34px);
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: none;
      }

      /* Divider lines draw in instead of sliding */
      [data-reveal="line"] {
        opacity: 1;
        transform: none;
      }

      [data-reveal="line"]::before {
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--motion-entry) var(--ease-out);
      }

      [data-reveal="line"].is-revealed::before {
        transform: scaleX(1);
      }

      /* Magnetic elements */
      [data-magnetic] {
        will-change: transform;
      }

      .print {
        display: none !important;
      }

      @media print {
        .no-print {
          display: none !important;
        }

        .print {
          display: block !important;
        }

        astro-dev-toolbar {
          display: none !important;
        }

        article {
          break-inside: avoid;
        }

        .texture-layer {
          display: none !important;
        }
      }

      @media (width <= 700px) {
        .site-footer {
          padding: var(--space-24) var(--space-16);
        }

        .footer-row {
          flex-direction: column;
          justify-content: center;
          text-align: center;
        }

        .footer-nav,
        .footer-socials {
          justify-content: center;
        }

        .footer-meta {
          text-align: center;
        }
      }

      /* Reduced motion: the one contract block lives in src/styles/animations.css. */
    </style>
    <script>
      import { bindThemeToggles } from "@/utils/themeToggle.js";
      bindThemeToggles();
    </script>
  </body>
</html>
