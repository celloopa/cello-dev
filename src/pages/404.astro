---
/*
 * 404 in the landscape (landscape build S3): today's words over home's scene, arriving the way
 * home does (readable at first paint; the scene assembles behind the words).
 */
import SceneLayout from "@/layouts/SceneLayout.astro";
import { homeScene } from "@/lib/scene/pairing";
---

<SceneLayout
  title="404 - Cello Rondon"
  description="Page not found on Cello Rondon's product design portfolio."
  place={homeScene()}
>
  <section class="not-found" aria-label="Page not found" data-scene-hero>
    <div class="not-found-copy copy-scrim" data-scene-intro>
      <p class="not-found-code">404</p>
      <h1 class="not-found-title">Page Not Found</h1>
      <a href="/" class="scene-arrow">Back to home <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SceneLayout>

<style>
  .not-found {
    position: relative;
    overflow-x: clip; /* the copy scrim must not widen the page */
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    padding: var(--space-48) var(--scene-copy-end) var(--scene-copy-bottom) var(--scene-copy-start);
  }

  .not-found-copy {
    color: var(--text-on-art);
  }

  .not-found-code {
    margin: 0;
    color: var(--text-on-art);
    font-family: var(--font-title);
    font-size: var(--type-display-hero);
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
  }

  .not-found-title {
    margin: var(--space-16) 0 var(--space-24);
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .not-found {
      padding: var(--space-32) var(--space-24) var(--space-96);
    }
  }
</style>
