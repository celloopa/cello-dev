---
/*
 * /agent-kit: the Agent Studio Kit, direction C "Job tickets" (docs/agent-kit/concepts). The page
 * is complete without script (AK-3): chapters are <section>s with an id and data-chapter, in the
 * order of stops.ts, and the studio shows its end-state still. The scroll story (AK-4, story.ts)
 * enhances it: data-ch / data-seen on .ak, chapter reveals, the rails' aria-current, and the
 * studio's ticket run in [data-studio-moment].
 */
import Layout from "@/layouts/Layout.astro";
import "@/components/agent-kit/agent-kit.css";
import Hero from "@/components/agent-kit/Hero.astro";
import Brain from "@/components/agent-kit/Brain.astro";
import Notes from "@/components/agent-kit/Notes.astro";
import Studio from "@/components/agent-kit/Studio.astro";
import Proof from "@/components/agent-kit/Proof.astro";
import Setup from "@/components/agent-kit/Setup.astro";
import RateCard from "@/components/agent-kit/RateCard.astro";
import Lessons from "@/components/agent-kit/Lessons.astro";
import StoryRail from "@/components/agent-kit/StoryRail.astro";
import AgentKitScript from "@/components/agent-kit/AgentKitScript.astro";
import AgentKitStory from "@/components/agent-kit/AgentKitStory.astro";
---

<Layout
  title="Agent Studio Kit - Cello"
  description="How I run AI agents like a small software studio: one folder of notes they all read, a note on every session, and a lead, evaluator and shipper on each project, with a worker for each ticket. Three prompts set it up on your computer."
  canonicalPath="/agent-kit/"
>
  <Fragment slot="head">
    <!-- the saved Pause motion choice, before first paint (story.ts writes it; key "ak-motion") -->
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("ak-motion") === "paused") document.documentElement.dataset.motion = "paused";
        } catch {}
      })();
    </script>
  </Fragment>
  <div class="ak">
    <Hero />
    <StoryRail />
    <Brain />
    <Notes />
    <Studio />
    <Proof />
    <Setup />
    <RateCard />
    <Lessons />
  </div>
  <AgentKitScript />
  <AgentKitStory />
</Layout>
