---
/*
 * /card: the landing page for people Cello meets at events (landscape build S3). The URL is the
 * one on his QR code and in "Share Card", so it stays. Phone first: someone opens it seconds
 * after a scan.
 *
 *   1. Who he is and the two fast actions (Save Contact, Share Card) over Mirror Lake, readable
 *      and usable at first paint; the scene assembles behind them (the arrival) once the
 *      renderer is in, and is a still under reduced motion.
 *   2. The four case studies, each over its own paired scene (src/data/scene-pairings.json): a
 *      flattened copy of the place, loaded only as its panel nears, revealed as the page scrolls
 *      (each panel is a window onto a fixed picture) and settling from the focus scale to rest.
 *   3. About, the links, and the QR code (today's card).
 *
 * Words: cv.json (name, label, location, email, profiles), today's card (the action labels and
 * notes, the share payload, "Scan To Visit", "Direct contact file"), today's home page ("Selected
 * Case Studies", the About paragraph, "View Resume"), and each case study's frontmatter (role,
 * title, the first sentence of the description). Nothing new.
 * Save Contact and Share Card behave exactly as today's card: /contact.vcf, and the Web Share
 * API with the clipboard and then the bare link as fallbacks.
 */
import "@fontsource-variable/geist";
import { getCollection } from "astro:content";
import QRCode from "qrcode";
import cv from "@cv";
import SceneLayout from "@/layouts/SceneLayout.astro";
import Button from "@/components/ui/Button.astro";
import { homeScene, sceneForProject } from "@/lib/scene/pairing";
import { sceneArt } from "@/lib/scene/catalog";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";

const { basics } = cv;
const { name, label, email, phone, url, location, profiles } = basics;

const cardUrl = new URL("/card", url).toString();
const vCardUrl = new URL("/contact.vcf", url).toString();
const siteHost = new URL(url).hostname.replace(/^www\./, "");
const phoneDigits = phone ? phone.replace(/\D/g, "") : "";
const phoneHref = phoneDigits ? `tel:${phoneDigits.length === 10 ? `+1${phoneDigits}` : `+${phoneDigits}`}` : "";
const locationLabel = [location.city, location.region].filter(Boolean).join(", ");
const linkedin = profiles.find(({ network }) => network === "LinkedIn")?.url;
const github = profiles.find(({ network }) => network === "GitHub")?.url;
// cv.json's label, set as the scene hero sets home's role line: the role, then its focus
const [roleLine, roleSub] = label.split(" — ");

// Today's QR code (the portfolio URL), in the page's colors: modules in currentColor on the frame
const qrCodeSvg = (await QRCode.toString(url, { type: "svg", errorCorrectionLevel: "H", margin: 1 }))
  .replace(/fill="#[0-9a-fA-F]{3,8}"/g, 'fill="none"')
  .replace(/stroke="#[0-9a-fA-F]{3,8}"/g, 'stroke="currentColor"');

/** One line from today's description: its first sentence, or the part before a dash if that runs long. */
const oneLine = (d: string) => {
  const sentence = d.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? d;
  return sentence.length > 120 ? sentence.split(/\s+[—–]\s*|—/)[0].trim() : sentence;
};
const MONTHS = ["june", "july", "august", "september", "october"];
const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured && p.data.complete)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => {
    const art = sceneArt(sceneForProject(p.slug));
    const month = art.month.toLowerCase();
    // the panel's placeholder while its picture loads: the place's month inks (A1 art tokens)
    const inks = MONTHS.includes(month)
      ? `--panel-sky: var(--art-${month}-sky); --panel-far: var(--art-${month}-far); --panel-forest: var(--art-${month}-forest);`
      : "";
    return {
      slug: p.slug,
      title: p.data.title,
      role: p.data.role,
      line: oneLine(p.data.description),
      art,
      style: `${inks} --art-x: ${art.anchor[0] * 100}%; --art-y: ${art.anchor[1] * 100}%;`,
      artifact: `/images/card/${p.slug}.webp`,
    };
  });

const PLACE = homeScene(); // Mirror Lake, as home
---

<SceneLayout
  title={`${name} | Conference Card`}
  description="Conference card for Marcelo Rondon. Scan the QR code for the portfolio, save the contact card, or share via AirDrop."
  canonicalPath="/card"
  place={PLACE}
>
  <section class="card-hero" aria-labelledby="card-name" data-scene-hero>
    <div class="card-intro copy-scrim" data-scene-intro>
      <h1 class="card-name" id="card-name">{name}</h1>
      <p class="card-role">
        {roleLine}
        {roleSub && <span class="card-role-sub">{roleSub}</span>}
      </p>
      {locationLabel && <p class="card-where">{locationLabel}</p>}
      <div class="card-actions" aria-label="Primary actions">
        <Button class="card-action" href="/contact.vcf" detail="VCF for phone or desktop">Save Contact</Button>
        <Button
          class="card-action"
          variant="secondary"
          detail="AirDrop or copy link"
          data-share-button
          data-share-url={cardUrl}
          data-share-title={`${name} | Conference Card`}
          data-share-text={`Connect with ${name}.`}
        >
          <span data-share-label>Share Card</span>
        </Button>
      </div>
      <p class="card-note" data-share-status aria-live="polite">
        Open on iPhone to AirDrop, or copy the link anywhere else.
      </p>
    </div>
  </section>

  <section class="card-work" aria-labelledby="card-work-title" data-scene-focus>
    <header class="card-work-head container" data-scene-stop="Selected Case Studies">
      <h2 class="card-section-title" id="card-work-title">Selected Case Studies</h2>
    </header>
    {
      projects.map((p, i) => (
        <article class="panel" data-scene-stop={p.title} aria-labelledby={`panel-${p.slug}`} style={p.style}>
          <div class="panel-art" aria-hidden="true" data-panel-art>
            <picture>
              {p.art.flatTall && <source media="(max-aspect-ratio: 4/5)" data-srcset={p.art.flatTall} />}
              <img data-src={p.art.flat ?? p.art.swatch} alt="" width="1536" height="1024" decoding="async" />
            </picture>
          </div>
          <div class="panel-body container" data-flip={i % 2 === 1 ? "" : undefined}>
            <div class="panel-copy copy-scrim">
              <p class="panel-place">
                {p.art.place} · {p.art.month}
              </p>
              <p class="panel-role">{p.role}</p>
              <h3 class="panel-title" id={`panel-${p.slug}`}>
                <a href={`/projects/${p.slug}`}>
                  {p.title} <span class="panel-arrow" aria-hidden="true">→</span>
                </a>
              </h3>
              <p class="panel-line">{p.line}</p>
            </div>
            <a class="panel-artifact" href={`/projects/${p.slug}`} tabindex="-1" aria-hidden="true">
              <img data-src={p.artifact} alt="" width="960" height="600" decoding="async" />
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <section class="card-about" aria-labelledby="card-about-title" data-scene-stop="About">
    <div class="container card-about-grid">
      <div class="card-about-copy">
        <h2 class="card-section-title" id="card-about-title">About</h2>
        <p class="card-about-text">
          I came to product design through visual journalism, brand systems, and front-end
          engineering. That range lets me translate creative intent into product rules, prototype
          behavior, make constraints legible, and speak the language of the team shipping it.
        </p>
        <ul class="card-links" aria-label="Contact links">
          <li>
            <a class="card-link" href={`mailto:${email}`}>
              <Mail />
              <span>{email}</span>
            </a>
          </li>
          {
            phone && (
              <li>
                <a class="card-link" href={phoneHref}>
                  <Phone />
                  <span>{phone}</span>
                </a>
              </li>
            )
          }
          {
            linkedin && (
              <li>
                <a class="card-link" href={linkedin} target="_blank" rel="noopener noreferrer">
                  <LinkedIn />
                  <span>LinkedIn</span>
                </a>
              </li>
            )
          }
          {
            github && (
              <li>
                <a class="card-link" href={github} target="_blank" rel="noopener noreferrer">
                  <GitHub />
                  <span>GitHub</span>
                </a>
              </li>
            )
          }
        </ul>
        <div class="card-more">
          <a href="/resume" class="scene-arrow">View Resume <span aria-hidden="true">→</span></a>
          <a href={url} class="scene-arrow" target="_blank" rel="noopener noreferrer">
            Visit Portfolio · {siteHost} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <aside class="card-qr" aria-labelledby="card-qr-title">
        <p class="card-qr-title" id="card-qr-title">Scan To Visit</p>
        <a class="card-qr-frame" href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${siteHost}`} set:html={qrCodeSvg} />
        <a class="card-qr-link" href={vCardUrl}>Direct contact file</a>
      </aside>
    </div>
  </section>

  <!-- Share Card: today's card script (Web Share API → clipboard → the bare link). The only
       change: the button is above it, so it binds at once instead of at DOMContentLoaded, which
       waits for the page's module scripts. -->

  <script is:inline>
    function initCardShare() {
      const shareButton = document.querySelector("[data-share-button]");
      const shareStatus = document.querySelector("[data-share-status]");
      const shareLabel = document.querySelector("[data-share-label]");

      if (!(shareButton instanceof HTMLButtonElement) || !(shareStatus instanceof HTMLElement)) {
        return;
      }

      if (shareButton.dataset.bound === "true") {
        return;
      }

      shareButton.dataset.bound = "true";

      const shareUrl = shareButton.dataset.shareUrl;
      const shareTitle = shareButton.dataset.shareTitle;
      const shareText = shareButton.dataset.shareText;

      if (!navigator.share && shareLabel instanceof HTMLElement) {
        shareLabel.textContent = "Copy Card Link";
      }

      shareButton.addEventListener("click", async () => {
        if (!shareUrl) {
          return;
        }

        try {
          if (navigator.share) {
            await navigator.share({
              title: shareTitle,
              text: shareText,
              url: shareUrl,
            });
            shareStatus.textContent = "Share sheet opened.";
            return;
          }

          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(shareUrl);
            shareStatus.textContent = "Card link copied to the clipboard.";
            return;
          }

          shareStatus.textContent = shareUrl;
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          shareStatus.textContent = "Share failed on this browser.";
        }
      });
    }

    initCardShare();
    document.addEventListener("DOMContentLoaded", initCardShare);
    document.addEventListener("astro:after-swap", initCardShare);
  </script>

  <script>
    // Each panel's picture and artifact load only as the panel nears (the picture sits at a fixed
    // position, so native lazy loading would fetch every one at once, and on a slow connection
    // Chrome's lazy margin reaches the artifacts too). Nothing starts before the first scroll or
    // before the first screen is complete (the page loaded and the scene's renderer in, or no
    // renderer), so nothing competes with it.
    const panels = [...document.querySelectorAll<HTMLElement>(".panel")];
    const load = (panel: HTMLElement) => {
      const art = panel.querySelector<HTMLElement>("[data-panel-art]");
      if (!art || art.dataset.loaded) return;
      art.dataset.loaded = "1";
      art.querySelectorAll<HTMLSourceElement>("source[data-srcset]").forEach((s) => (s.srcset = s.dataset.srcset ?? ""));
      const artifact = panel.querySelector<HTMLImageElement>(".panel-artifact img[data-src]");
      if (artifact) artifact.src = artifact.dataset.src ?? "";
      const img = art.querySelector<HTMLImageElement>("img[data-src]");
      if (!img) return;
      const shown = () => art.classList.add("is-loaded");
      img.addEventListener("load", shown, { once: true });
      img.src = img.dataset.src ?? "";
      if (img.complete && img.naturalWidth) shown();
    };
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      if (!("IntersectionObserver" in window)) return panels.forEach(load);
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.unobserve(e.target);
            load(e.target as HTMLElement);
          }
        },
        { rootMargin: "0px 0px 100% 0px" },
      );
      panels.forEach((p) => io.observe(p));
    };
    const root = document.documentElement;
    const heroDone = () => !root.classList.contains("scene-3d") || root.classList.contains("scene-gl-on");
    const whenHeroDone = () => {
      if (heroDone()) return start();
      const mo = new MutationObserver(() => {
        if (!heroDone()) return;
        mo.disconnect();
        start();
      });
      mo.observe(root, { attributes: true, attributeFilter: ["class"] });
    };
    if (document.readyState === "complete") whenHeroDone();
    else addEventListener("load", whenHeroDone, { once: true });
    addEventListener("scroll", start, { once: true, passive: true });
  </script>
</SceneLayout>

<style>
  /* ---------- 1. who he is + the two actions, over the scene at first paint ---------- */
  .card-hero {
    position: relative;
    overflow-x: clip; /* the copy scrim must not widen the page */
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    padding: var(--space-48) var(--scene-copy-end) var(--scene-copy-bottom) var(--scene-copy-start);
  }

  .card-intro {
    max-width: 44rem;
    color: var(--text-on-art);
  }

  /* Portland, Oregon: under the role line, inside the scrim's flat middle (as the copy's first line
     it sat in the scrim's top feather and measured 4.0:1 over the still on phones) */
  .card-where {
    margin: 0 0 var(--space-24);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .card-name {
    margin: 0 0 var(--space-16);
    font-family: var(--font-title);
    font-size: var(--type-display-card);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
    white-space: nowrap;
  }

  .card-role {
    margin: 0 0 var(--space-12);
    font-family: var(--font-title);
    font-size: var(--type-hero-line);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .card-role-sub {
    display: block;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .card-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
    max-width: 36rem;
  }

  /* the two actions fill their grid cells, a little taller than the touch target */
  .card-action {
    min-height: calc(var(--touch-target) + var(--space-24));
  }

  .card-note {
    max-width: 36rem;
    margin: var(--space-16) 0 0;
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  /* ---------- 2. the case studies, each over its own place ---------- */
  .card-work-head {
    padding-block: var(--space-96) var(--space-48);
  }

  .card-section-title {
    margin: 0;
    color: var(--text-accent);
    font-family: var(--font-title);
    font-size: var(--type-section-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  /* Each panel is a window onto a picture fixed to the viewport (clip-path clips its fixed
     child), so scrolling reveals one place over the last. Nothing here may create a containing
     block for the fixed art (no transform, filter or contain on .panel). */
  .panel {
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    clip-path: inset(0);
    overflow-x: clip; /* the copy scrim must not widen the page (clip-path doesn't stop that) */
    view-timeline: --panel block;
  }

  .panel-art {
    position: fixed;
    inset: var(--scene-bar) 0 0 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--panel-sky, var(--bg-canvas)), var(--panel-far, var(--bg-canvas)) 55%, var(--panel-forest, var(--bg-canvas)));
  }

  .panel-art img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--art-x) var(--art-y);
    opacity: 0;
    transition: opacity var(--motion-scene-fade) var(--ease-out);
  }

  .panel-art.is-loaded img {
    opacity: 1;
  }

  /* The ink that grounds the copy (the arrival atmosphere) belongs to the panel, not to the fixed
     picture, so it travels with the copy: fixed to the viewport, it stayed at the bottom while the
     copy scrolled up over the bright sky (measured 1.2:1). In Dusk, the reading ink over the whole
     place too, since the flattened picture is the Day art. */
  .panel::before,
  .panel-art::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .panel::before {
    z-index: 0;
    background: var(--atmos-arrive);
  }

  :global(html:not([data-theme="light"])) .panel-art::after {
    z-index: 1;
    background: var(--atmos-read);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .panel-art img {
        animation: sceneSettle linear both;
        animation-timing-function: var(--ease-out);
        animation-timeline: --panel;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  .panel-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-48);
    align-items: end;
    padding-block: var(--space-96) var(--scene-copy-bottom);
  }

  .panel-body[data-flip] .panel-artifact {
    order: -1;
  }

  .panel-copy {
    max-width: 34rem;
    color: var(--text-on-art);
  }

  .panel-place {
    margin: 0 0 var(--space-16);
    font-family: var(--font-place);
    font-size: var(--type-place-label);
    font-weight: var(--weight-regular);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .panel-role {
    margin: 0 0 var(--space-8);
    color: var(--text-on-art-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .panel-title {
    margin: 0 0 var(--space-16);
    font-family: var(--font-title);
    font-size: var(--type-section-title);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
  }

  .panel-title a {
    background-image: linear-gradient(var(--action-primary), var(--action-primary));
    background-size: 100% var(--stroke-control);
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: color var(--motion-ui) var(--ease-out);
  }

  /* the arrow in Geist Mono: National Park's latin subset has no arrows (one font file fewer) */
  .panel-arrow {
    font-family: var(--font-mono);
  }

  .panel-title a:hover,
  .panel-title a:focus-visible {
    color: var(--action-primary);
  }

  .panel-line {
    margin: 0;
    font-family: var(--font-read);
    font-size: var(--type-body-lg);
    line-height: var(--leading-small);
  }

  .panel-artifact {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-plate);
    border: var(--stroke-frame) solid var(--text-on-art);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-ground);
  }

  .panel-artifact img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* ---------- 3. about, links and the QR code, over the focused scene ---------- */
  .card-about {
    padding-block: var(--space-96);
  }

  .card-about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-64);
    align-items: start;
  }

  .card-about-text {
    max-width: var(--layout-measure-read);
    margin: var(--space-24) 0 var(--space-32);
    color: var(--text-on-art);
    font-family: var(--font-read);
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
  }

  .card-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-8) var(--space-24);
    margin: 0 0 var(--space-24);
    padding: 0;
    list-style: none;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    min-height: var(--touch-target);
    color: var(--text-on-art);
    font-size: var(--type-ui);
    line-height: var(--leading-ui);
    overflow-wrap: anywhere;
  }

  .card-link :global(svg) {
    flex: none;
    width: var(--space-20);
    height: var(--space-20);
  }

  .card-link:hover,
  .card-link:focus-visible {
    color: var(--action-primary);
  }

  .card-more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-32);
  }

  .card-qr {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 13rem;
  }

  .card-qr-title,
  .card-qr-link {
    margin: 0;
    color: var(--text-on-art);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .card-qr-link {
    align-self: flex-start;
    padding-bottom: var(--space-4);
    border-bottom: var(--stroke-control) solid var(--action-primary);
  }

  .card-qr-frame {
    display: block;
    padding: var(--space-12);
    border: var(--stroke-frame) solid var(--text-on-art);
    background: var(--bg-inverse);
    color: var(--text-inverse);
  }

  .card-qr-frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- phones ---------- */
  @media (max-width: 768px) {
    .card-hero {
      padding: var(--space-32) var(--layout-gutter) var(--space-96);
    }

    .card-name {
      font-size: var(--type-display-scene);
      white-space: normal;
      text-wrap: balance;
    }

    .card-note {
      font-size: var(--type-label);
    }

    .panel-body {
      grid-template-columns: 1fr;
      gap: var(--space-32);
      padding-block: var(--space-96);
    }

    /* the artifact first, so the words sit lowest, in the panel's darkest ink */
    .panel-artifact,
