---
/*
 * /now (CDEV-54, CDEV-59): what Cello is building now, one entry per project, with demo-data screens where they exist (CDEV-68). Entries live in src/data/now.ts. Each entry sits on a Panel plate, so
 * its text never sits on scene art; the scene is the How I Build place, reused (no new art).
 */
import SceneLayout from "@/layouts/SceneLayout.astro";
import Panel from "@/components/ui/Panel.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import { homeSection } from "@/lib/scene/pairing";
import { nowEntries, nowPage } from "@/data/now";

const place = homeSection("how");
---

<SceneLayout
  title={`${nowPage.title} - Cello`}
  description={nowPage.description}
  canonicalPath="/now"
  place={place}
  reading={{ title: "Now", all: { href: "/#work", label: "All work" } }}
>
  <div class="now container" data-scene-focus data-scene-stop="Now" data-scene-backdrop={place}>
    <header class="now-head">
      <h1>{nowPage.title}</h1>
      <p class="now-lede">{nowPage.lede}</p>
      <p class="now-updated">{nowPage.updated}</p>
    </header>

    <ol class="now-list">
      {
        nowEntries.map((entry) => (
          <Panel as="li" class="entry" id={entry.id} aria-labelledby={`${entry.id}-hook`}>
            <h2 class="entry-hook" id={`${entry.id}-hook`}>{entry.hook}</h2>
            {entry.image && <img class="entry-image" src={entry.image.src} alt={entry.image.alt} loading="lazy" decoding="async" />}
            {entry.body.map((paragraph, i) =>
              i === 0 ? (
                <p class="entry-body"><strong>{entry.name}</strong> {paragraph}</p>
              ) : (
                <p class="entry-body">{paragraph}</p>
              ),
            )}
            <p class="entry-status"><span class="entry-status-label">Status</span> {entry.status}</p>
            {entry.links.length > 0 && (
              <div class="entry-links">
                {entry.links.map((link) => (
                  <ArrowLink href={link.href} variant={link.external ? "external" : "forward"}>
                    {link.label}
                  </ArrowLink>
                ))}
              </div>
            )}
          </Panel>
        ))
      }
    </ol>

    <WorkWithMe variant="short" source="now" />
  </div>
</SceneLayout>

<style>
  .now {
    padding-block: var(--space-96) var(--space-96);
  }

  h1 {
    margin: 0;
    font: var(--weight-bold) var(--type-display-scene) / var(--leading-tight) var(--font-title);
  }

  .now-lede {
    max-width: var(--layout-measure);
    margin: var(--space-32) 0 0;
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
  }

  .now-updated {
    margin: var(--space-16) 0 0;
    color: var(--text-on-art-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .now-list {
    display: grid;
    gap: var(--space-24);
    max-width: var(--layout-measure);
    margin: var(--space-48) 0 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    padding: var(--space-24);
    scroll-margin-top: var(--space-96);
  }

  .entry-image {
    display: block;
    width: 100%;
    height: auto;
    margin-block: var(--space-16);
    border: var(--stroke-bar) solid var(--border-strong);
  }

  .entry-hook {
    margin: 0;
    font: var(--weight-bold) var(--type-heading) / var(--leading-title) var(--font-title);
  }

  .entry-body {
    margin: var(--space-16) 0 0;
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  .entry-status {
    margin: var(--space-16) 0 0;
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .entry-status-label {
    margin-right: var(--space-8);
    color: var(--text-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-24);
    margin-top: var(--space-24);
  }

  .now :global(.work-with-me--short) {
    max-width: var(--layout-measure);
  }
</style>
