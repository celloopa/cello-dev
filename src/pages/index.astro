---
/* Home keeps the existing landscape and cursor depth. Arrival, featured work, and contact
 * share a project timeline; About and How I Build now live at /about. */
import { getCollection } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import ChapterRail from "@/components/scene/ChapterRail.astro";
import WorkItem from "@/components/scene/WorkItem.astro";
import Button from "@/components/ui/Button.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Section from "@/components/ui/Section.astro";
import { homeScene, homeSection, sceneForProject } from "@/lib/scene/pairing";
import { basics } from "@cv";

const PLACE = homeScene(); // Mirror Lake (src/data/scene-pairings.json)
const { email } = basics;

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured && p.data.complete)
  .sort((a, b) => a.data.order - b.data.order);

// the places behind the reading parts (backdrops): each case study's, then each section's
const sections = { contact: homeSection("contact"), footer: homeSection("footer") };
const backdrops = [...featuredProjects.map((p) => sceneForProject(p.slug)), ...Object.values(sections)];

const homeTitle = "Cello — Digital Designer, Brand & Design Systems";
const homeDescription =
  "I lead design across three brands through a shared Figma system, then build the components and tools that carry it into everyday use.";
---

<SceneLayout
  title={homeTitle}
  description={homeDescription}
  place={PLACE}
  backdrops={backdrops}
  footerPlace={sections.footer}
>
  <ChapterRail projects={featuredProjects.map(p => ({ slug: p.slug, title: p.data.title }))} />
  <section id="arrival" class="hero" aria-labelledby="hero-name" data-scene-hero>
    <div class="hero-copy copy-scrim" data-scene-intro>
      <h1 class="hero-name" id="hero-name">Cello</h1>
      <Eyebrow class="kicker">
        <span class="kicker-dot" aria-hidden="true"></span>
        <span>Open to design systems, brand and product design roles</span>
      </Eyebrow>
      <p class="hero-line">
        Digital Designer
        <span class="hero-line-sub">Brand &amp; Design Systems</span>
      </p>
      <p class="hero-summary">
        I lead design across three brands through a shared Figma system, then build the
        components and tools that carry it into everyday use.
      </p>
      <div class="hero-actions">
        <Button href="#work">View Case Studies</Button>
        <ArrowLink href="/resume">View Resume</ArrowLink>
      </div>
    </div>

  </section>

  <Section
    class="work"
    id="work"
    title="Selected Case Studies"
    titleId="work-title"
    stop="Selected Case Studies"
    intro="Systems first: one shared system across three brands, and a design system whose tokens and checks keep AI coding agents inside it. Then the products I designed and built on the same rules."
    data-scene-focus
  >
      <ol class="work-list">
        {
          featuredProjects.map((project, i) => (
            <WorkItem
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              url={project.data.url}
              techStack={project.data.techStack}
              role={project.data.role}
              slug={project.slug}
              index={i}
              place={sceneForProject(project.slug)}
            />
          ))
        }
      </ol>
      <ArrowLink href="/projects" class="view-all">All Case Studies</ArrowLink>
  </Section>

  <Section
    class="contact"
    id="contact"
    title="Let’s Talk"
    titleId="contact-heading"
    intro="Open to design systems, brand and product design roles, remote in the US or in Portland. The fastest way to reach me is email."
    data-scene-stop="Let’s Talk"
    data-scene-backdrop={sections.contact}
  >
      <div class="contact-actions">
        <Button href={`mailto:${email}`}>Email Me</Button>
        <ArrowLink href="/resume">View Resume</ArrowLink>
      </div>
  </Section>
  <noscript><p class="container"><a href="/about/">About and How I Build →</a></p></noscript>
  <script is:inline>
    // URL fragments never reach the server. Keep historical section links usable.
    if (location.hash === "#about" || location.hash === "#how") location.replace("/about/" + location.hash);
    addEventListener("hashchange", () => {
      if (location.hash === "#about" || location.hash === "#how") location.replace("/about/" + location.hash);
    });
  </script>
</SceneLayout>



<style>
  /* ---------- arrival: identity, role and the route to work, over the scene at once ---------- */
  .hero {
    position: relative;
    overflow-x: clip; /* the copy scrim must not widen the page */
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    padding: var(--space-48) var(--scene-copy-end) var(--scene-copy-bottom) var(--scene-copy-start);
  }

  .hero-copy {
    max-width: 42rem;
    color: var(--text-on-art);
  }

  .hero-name {
    margin: 0 0 var(--space-12);
    font-family: var(--font-title);
    font-size: var(--type-display-scene);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .kicker-dot {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-circle);
    background: var(--action-primary);
    transform: translateY(-1px);
  }

  .hero-line {
    max-width: 24ch;
    margin: 0 0 var(--space-16);
    font-family: var(--font-title);
    font-size: var(--type-hero-line);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-line-sub {
    display: block;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .hero-summary {
    max-width: var(--layout-measure-narrow);
    margin: 0 0 var(--space-24);
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
  }

  /* ---------- reading: the content over the focused scene ---------- */
  .work {
    padding-block: var(--space-96) var(--space-64);
  }

  .work-list {
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }

  .view-all {
    margin-top: var(--space-32);
  }

  .contact {
    padding-block: var(--space-64);
  }

  .contact {
    padding-bottom: var(--space-96);
  }

  .contact-actions {
    margin-top: var(--space-24);
  }

  /* ---------- phones ---------- */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-32) var(--layout-gutter) var(--space-96);
    }

    .hero-summary {
      font-size: var(--type-small);
      line-height: var(--leading-small);
    }
  }

  @media (width >= 900px) { :global(main:has(.chapter-rail)) { padding-right: var(--space-48); } }
  @media (width < 900px) { :global(body:has(.chapter-rail)) { padding-bottom: var(--space-96); } }
</style>
