---
/* Home keeps the existing landscape and cursor depth. Arrival, featured work, and contact
 * share a project timeline; About and How I Build now live at /about. */
import { getCollection } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import ChapterRail from "@/components/scene/ChapterRail.astro";
import WorkItem from "@/components/scene/WorkItem.astro";
import Button from "@/components/ui/Button.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Section from "@/components/ui/Section.astro";
import { homeScene, homeSection, sceneForProject } from "@/lib/scene/pairing";
import { basics } from "@cv";

const PLACE = homeScene(); // Mirror Lake (src/data/scene-pairings.json)
const { email } = basics;

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured && p.data.complete)
  .sort((a, b) => a.data.order - b.data.order);

// the places behind the reading parts (backdrops): each case study's, then each section's
const sections = { contact: homeSection("contact"), footer: homeSection("footer") };
const backdrops = [...featuredProjects.map((p) => sceneForProject(p.slug)), ...Object.values(sections)];

const homeTitle = "Cello — Designer, Products & Prototypes";
const homeDescription =
  "I design and prototype helpful experiences, from products and systems to the code that brings them to life.";
---

<SceneLayout
  title={homeTitle}
  description={homeDescription}
  place={PLACE}
  backdrops={backdrops}
  footerPlace={sections.footer}
  guide
>
  <ChapterRail projects={featuredProjects.map(p => ({ slug: p.slug, title: p.data.title }))} />
  <section id="arrival" class="hero" aria-labelledby="hero-name" data-scene-hero>
    <div class="hero-copy" data-scene-intro>
      <div class="hero-greeting">
        <img class="hero-avatar" data-scene-guide-foreground src="/images/characters/cello-hiker-v2.webp" alt="" aria-hidden="true" width="384" height="576" fetchpriority="high" />
        <div class="hero-bubbles copy-scrim">
          <h1 class="hero-name message-row" id="hero-name" data-intro-message><span class="message-copy">Hi, I’m Cello.</span><span class="message-visual" aria-hidden="true"></span></h1>
          <div class="message-deck">
          <p class="hero-bubble message-row" data-intro-message><span class="message-copy">Welcome to Mt. Hood. I come here a lot, so I thought I’d bring you along this time.</span><span class="message-visual" aria-hidden="true"></span></p>
          <p class="hero-bubble message-row" data-intro-message><span class="message-copy">I love to design and prototype helpful experiences, taking an idea all the way to something you can use.</span><span class="message-visual" aria-hidden="true"></span></p>
          </div>
        </div>
      </div>
      <div class="intro-controls"><button type="button" data-intro-control hidden>Skip intro</button></div>
      <nav class="hero-routes copy-scrim" aria-label="Start exploring">
        <a href="#work"><strong>Here for the work? <span aria-hidden="true">↓</span></strong><span>Scroll down, or choose a project logo on the rail to jump straight to it.</span><small class="mobile-route-hint">Scroll, or tap a project below.</small></a>
        <a href="/blog/"><strong>See what I’m learning <span aria-hidden="true">↗</span></strong><span>I document my work and share what I learn in Writing.</span></a>
        <a href="/about/"><strong>A little more about me <span aria-hidden="true">↗</span></strong><span>I’m taken, but you can still read my About page.</span></a>
      </nav>
    </div>

  </section>

  <Section
    class="work"
    contained={false}
    id="work"
    title="Selected Case Studies"
    titleId="work-title"
    stop="Selected Case Studies"
    intro="From shared brand systems to AI tools and everyday planning. Here’s the problem, the decision, and what shipped."
    data-scene-focus
  >
      <ol class="work-list">
        {
          featuredProjects.map((project, i) => (
            <WorkItem
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              url={project.data.url}
              techStack={project.data.techStack}
              role={project.data.role}
              slug={project.slug}
              index={i}
              place={sceneForProject(project.slug)}
            />
          ))
        }
      </ol>
      <div class="container"><ArrowLink href="/projects" class="view-all">All Case Studies</ArrowLink></div>
  </Section>

  <Section
    class="contact"
    id="contact"
    title="Let’s Talk"
    titleId="contact-heading"
    intro="Open to design systems, brand and product design roles, remote in the US or in Portland. The fastest way to reach me is email."
    data-scene-stop="Let’s Talk"
    data-scene-backdrop={sections.contact}
  >
      <div class="contact-actions">
        <Button href={`mailto:${email}`}>Email Me</Button>
        <ArrowLink href="/resume">View Resume</ArrowLink>
      </div>
  </Section>
  <noscript><p class="container"><a href="/about/">About and How I Build →</a></p></noscript>
  <script>
    const intro = document.querySelector<HTMLElement>("[data-scene-intro]");
    if (intro) {
      const rows = [...intro.querySelectorAll<HTMLElement>("[data-intro-message]")];
      const control = intro.querySelector<HTMLButtonElement>("[data-intro-control]")!;
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const css = getComputedStyle(document.documentElement);
      const duration = (name: string) => { const value = css.getPropertyValue(name).trim(); return parseFloat(value) * (value.endsWith("ms") ? 1 : 1000); };
      const letterTime = duration("--motion-stagger-dense");
      const hold = duration("--motion-entry") * 2;
      let frame = 0;
      let playing = false;
      let seen = false;
      try { seen = sessionStorage.getItem("cello-hello-seen") === "yes"; } catch { /* Greeting works without storage. */ }
      const guide = document.querySelector<HTMLElement>("[data-scene-guide-foreground]");
      const hello = () => { if (!guide) return; guide.classList.remove("guide-hello"); void guide.offsetWidth; guide.classList.add("guide-hello"); };
      guide?.addEventListener("animationend", event => { if (event.animationName === "guide-hello") guide.classList.remove("guide-hello"); });
      const remember = () => { try { sessionStorage.setItem("cello-hello-seen", "yes"); } catch { /* Optional session preference. */ } };
      const finish = () => {
        cancelAnimationFrame(frame);
        playing = false;
        intro.classList.remove("intro-playing");
        intro.classList.toggle("intro-focused", !motion.matches);
        rows.forEach((row, i) => {
          row.classList.remove("message-revealed");
          row.classList.toggle("message-active", i === rows.length - 1);
          row.classList.toggle("message-past", i > 0 && i < rows.length - 1);
        });
        control.textContent = "Replay hello";
        control.hidden = motion.matches;
        remember();
      };
      const play = () => {
        if (motion.matches || document.hidden) { finish(); return; }
        cancelAnimationFrame(frame);
        playing = true;
        control.hidden = false;
        control.textContent = "Skip intro";
        intro.classList.add("intro-playing", "intro-focused");
        rows.forEach(row => { row.classList.remove("message-revealed", "message-active", "message-past"); row.querySelector(".message-visual")!.textContent = ""; });
        let index = 0;
        let start = performance.now() + duration("--motion-entry");
        let lastCount = -1;
        const tick = (now: number) => {
          if (!playing) return;
          if (now >= start) {
            const row = rows[index];
            if (!row.classList.contains("message-revealed")) hello();
            row.classList.add("message-revealed");
            if (index > 0) rows.forEach((item, i) => {
              item.classList.toggle("message-active", i === index);
              item.classList.toggle("message-past", i > 0 && i < index);
            });
            const text = Array.from(row.querySelector(".message-copy")!.textContent || "");
            const count = Math.min(text.length, Math.floor((now - start) / letterTime));
            if (count !== lastCount) { row.querySelector(".message-visual")!.textContent = text.slice(0, count).join(""); lastCount = count; }
            if (count === text.length) {
              index++;
              if (index === rows.length) { finish(); return; }
              start = now + hold;
              lastCount = -1;
            }
          }
          frame = requestAnimationFrame(tick);
        };
        frame = requestAnimationFrame(tick);
      };
      control.addEventListener("click", () => playing ? finish() : play());
      motion.addEventListener("change", () => { if (motion.matches) finish(); else control.hidden = false; });
      document.addEventListener("visibilitychange", () => { if (document.hidden && playing) finish(); });
      // Leaving the greeting or choosing a route should never leave unfinished text on return.
      intro.querySelector(".hero-routes")?.addEventListener("click", finish);
      const observer = new IntersectionObserver(entries => { if (!entries[0].isIntersecting && playing) finish(); });
      observer.observe(intro);
      addEventListener("pagehide", () => { finish(); observer.disconnect(); }, { once: true });
      if (!seen && !motion.matches && scrollY < innerHeight / 2 && !location.hash) play();
      else finish();
    }
  </script>
  <script is:inline>
    // URL fragments never reach the server. Keep historical section links usable.
    if (location.hash === "#about" || location.hash === "#how") location.replace("/about/" + location.hash);
    addEventListener("hashchange", () => {
      if (location.hash === "#about" || location.hash === "#how") location.replace("/about/" + location.hash);
    });
  </script>
</SceneLayout>



<style>
  /* ---------- arrival: identity, role and the route to work, over the scene at once ---------- */
  .hero {
    position: relative;
    overflow-x: clip; /* the copy scrim must not widen the page */
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    padding: var(--space-48) var(--scene-copy-end) var(--scene-copy-bottom) var(--scene-copy-start);
  }

  .hero-copy {
    display: grid;
    grid-template-columns: calc(var(--space-64) * 2 + var(--space-48)) minmax(0, 1fr);
    column-gap: var(--space-40);
    max-width: 44rem;
    color: var(--text-on-art);
  }

  .hero-bubbles::before, .hero-routes::before { inset: -12% -8%; }
  .hero-greeting { display: contents; }
  /* The guide stands beside what he says: feet level with the bottom of the chat.
     The negative top margin lets him rise above a short greeting without stretching its row. */
  .hero-avatar { grid-column: 1; grid-row: 1; align-self: end; margin-top: calc(var(--space-64) * -2); width: 100%; height: auto; position: relative; z-index: 2; pointer-events: none; transform-origin: 50% 100%; --enter-distance: var(--space-12); }
  /* He stays planted while the scenery takes the cursor: a slow breath, and a small sway as each message starts. */
  .hero-avatar { animation: enter-rise var(--motion-entry) var(--ease-out) both, guide-idle calc(var(--motion-entry) * 7) var(--ease-out) infinite alternate; }
  .hero-avatar.guide-hello { animation: enter-rise var(--motion-entry) var(--ease-out) both, guide-idle calc(var(--motion-entry) * 7) var(--ease-out) infinite alternate, guide-hello calc(var(--motion-entry) * 2) var(--ease-out); }
  .hero-bubbles { grid-column: 2; min-width: 0; }
  .hero-bubble { max-width: 48ch; margin: 0 0 var(--space-8); padding: var(--space-12) var(--space-16); background: var(--bg-plate); color: var(--text-primary); border: 1px solid var(--border-strong); border-radius: var(--space-12); font-size: var(--type-ui); line-height: var(--leading-read); }
  .message-row { display: grid; }
  .message-copy, .message-visual { grid-area: 1 / 1; min-width: 0; }
  .message-visual { display: none; }
  .intro-focused .message-deck { display: grid; }
  .intro-focused .message-deck .message-row { grid-area: 1 / 1; opacity: 0; transform: translateY(var(--space-8)); transition: opacity var(--motion-ui) var(--ease-out), transform var(--motion-ui) var(--ease-out); }
  .intro-focused .message-deck .message-past { transform: translateY(calc(var(--space-12) * -1)); }
  .intro-focused .message-deck .message-active { opacity: 1; transform: none; }
  .intro-playing .hero-name { opacity: 0; transform: translateY(var(--space-8)); transition: opacity var(--motion-ui) var(--ease-out), transform var(--motion-ui) var(--ease-out); }
  .intro-playing .hero-name.message-revealed { opacity: 1; transform: none; }
  .intro-playing .message-copy { opacity: 0; }
  .intro-playing .message-visual { display: block; }
  .intro-controls { grid-column: 2; margin: var(--space-8) 0 var(--space-24); min-height: var(--space-24); }
  .intro-controls:has(button[hidden]) { display: none; }
  .intro-controls button { padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: var(--type-small); text-decoration: underline; text-underline-offset: .25em; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) {
    .intro-focused .message-deck { display: block; }
    .intro-focused .message-deck .message-row, .intro-playing .hero-name, .intro-playing .message-copy { opacity: 1; transform: none; }
    .intro-playing .message-visual { display: none; }
    .hero-avatar, .hero-avatar.guide-hello { animation: none; }
  }
  .hero-routes { grid-column: 2; display: grid; gap: var(--space-12); margin: 0 0 var(--space-24); }
  .mobile-route-hint { display: none; }
  .hero-routes a { display: grid; gap: var(--space-4); color: inherit; text-decoration: none; }
  .hero-routes strong { text-decoration: underline; text-underline-offset: .25em; font-size: var(--type-ui); }
  .hero-routes a:hover strong { color: var(--text-accent); }
  .hero-routes a > span { font-size: var(--type-small); line-height: var(--leading-read); max-width: 48ch; }
  .work :global(.container) { max-width: var(--ds-container-wide); padding-inline: var(--layout-gutter); }
  @media (width <= 900px) {
    .hero-copy { grid-template-columns: calc(var(--space-64) + var(--space-24)) minmax(0, 1fr); column-gap: var(--space-12); }
    .hero-avatar { margin-top: calc(var(--space-64) * -1); }
    .hero-routes { grid-column: 1 / -1; }
  }
  .hero-name {
    margin: 0 0 var(--space-12);
    font-family: var(--font-title);
    text-shadow: 0 var(--stroke-control) var(--space-8) var(--bg-canvas);
    font-size: var(--type-page-title);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
  }

  /* ---------- reading: the content over the focused scene ---------- */
  .work {
    padding-block: var(--space-96) var(--space-64);
  }

  .work-list {
    width: 100%;
    max-width: var(--ds-container-wide);
    box-sizing: border-box;
    margin: var(--space-32) auto 0;
    padding-inline: var(--layout-gutter);
    list-style: none;
  }

  .view-all {
    margin-top: var(--space-32);
  }

  .contact {
    padding-block: var(--space-64);
  }

  .contact {
    padding-bottom: var(--space-96);
  }

  .contact-actions {
    margin-top: var(--space-24);
  }

  /* ---------- phones ---------- */
  @media (max-width: 768px) {
    :global(html:has(.chapter-rail)) { --scene-bar: 0px; }
    :global(body:has(.chapter-rail) .bar) { display: none; }
    :global(body:has(.chapter-rail) .place-label) { bottom: calc(var(--space-96) * 1.5); }
    .hero-routes a > span { display: none; }
    .mobile-route-hint { display: block; font-size: var(--type-small); line-height: var(--leading-read); }
    /* Phones: the guide leads and the chat steps back. */
    .hero-copy { grid-template-columns: calc(var(--space-96) + var(--space-24)) minmax(0, 1fr); }
    .hero-name { font-size: var(--type-section-title); }
    .hero-bubble { padding: var(--space-8) var(--space-12); font-size: var(--type-small); line-height: var(--leading-ui); }
    /* Three tiers: greeting, then a clear break before the routes, then the place caption on its own. */
    .intro-controls { margin-bottom: 0; }
    .hero-routes { margin: var(--space-32) 0 var(--space-64); }
    .hero {
      padding: var(--space-32) var(--layout-gutter) calc(var(--space-96) * 1.5);
    }

  }

  @media (width < 900px) {
    :global(body:has(.chapter-rail)) { padding-bottom: var(--space-96); }
    @media (width > 768px) { :global(body:has(.chapter-rail) .place-label) { bottom: var(--space-96); } }

  }
</style>
