---
/*
 * Home in the landscape (landscape build S1). The scene is Mirror Lake; the words are today's
 * home page, unchanged. Arrival: the hero copy over the scene, readable at first paint. Admire:
 * "Take in the view". Reading: once the Work section reaches the reading line, the scene
 * softens and dims and the bar names the project in view.
 * Retired from today's home: the typewriter lock-in and the marquee (proposal §10), and the
 * hero photo (a rewrite moves it to About).
 */
import { getCollection } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import WorkItem from "@/components/scene/WorkItem.astro";
import Button from "@/components/ui/Button.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Section from "@/components/ui/Section.astro";
import { loadScene } from "@/lib/scene/catalog";
import { homeScene } from "@/lib/scene/pairing";
import { basics } from "@cv";

const PLACE = homeScene(); // Mirror Lake (src/data/scene-pairings.json)
const scene = loadScene(PLACE);
const { email } = basics;

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured && p.data.complete)
  .sort((a, b) => a.data.order - b.data.order);

const homeTitle = "Cello — Digital Designer, Brand & Design Systems";
const homeDescription =
  "I lead design across three brands through a shared Figma system, then build the components and tools that carry it into everyday use.";
---

<SceneLayout title={homeTitle} description={homeDescription} place={PLACE}>
  <section class="hero" aria-labelledby="hero-name" data-scene-hero>
    <div class="hero-copy copy-scrim" data-scene-intro>
      <h1 class="hero-name" id="hero-name">Cello</h1>
      <Eyebrow class="kicker">
        <span class="kicker-dot" aria-hidden="true"></span>
        <span>Open to design systems, brand and product design roles</span>
      </Eyebrow>
      <p class="hero-line">
        Digital Designer
        <span class="hero-line-sub">Brand &amp; Design Systems</span>
      </p>
      <p class="hero-summary">
        I lead design across three brands through a shared Figma system, then build the
        components and tools that carry it into everyday use.
      </p>
      <div class="hero-actions">
        <Button href="#work">View Case Studies</Button>
        <ArrowLink href="/resume">View Resume</ArrowLink>
        <button class="admire-btn" type="button" data-admire-open>Take in the view</button>
      </div>
    </div>
    <div class="admire-view copy-scrim" data-admire-view hidden>
      <p class="admire-place">{scene.place} · {scene.month}</p>
      <div class="admire-actions">
        <button class="admire-return" type="button" data-admire-close>Back to Cello</button>
        <ArrowLink href="#work" variant="down" data-admire-work>View Case Studies</ArrowLink>
      </div>
    </div>
  </section>

  <Section
    class="work"
    id="work"
    title="Selected Case Studies"
    titleId="work-title"
    stop="Selected Case Studies"
    intro="Systems first: one shared system across three brands, and a design system whose tokens and checks keep AI coding agents inside it. Then the products I designed and built on the same rules."
    data-scene-focus
  >
      <ol class="work-list">
        {
          featuredProjects.map((project, i) => (
            <WorkItem
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              url={project.data.url}
              techStack={project.data.techStack}
              role={project.data.role}
              slug={project.slug}
              index={i}
            />
          ))
        }
      </ol>
      <ArrowLink href="/projects" class="view-all">All Case Studies</ArrowLink>
  </Section>

  <Section
    class="how"
    title="How I Build"
    titleId="how-heading"
    intro="I build what I design, so the system reaches production intact. Code does everything it can, the model gets the smallest job it can be trusted with, and a person approves wherever the consequences are."
    data-scene-stop="How I Build"
  >
      <div class="proof-strip">
        <a class="proof-item" href="/projects/asheville-dispensary">
          <h3>Code First</h3>
          <p>
            A script checks for new product drops before any model runs. An idle day costs about
            $0.30 instead of $12.
          </p>
          <span class="proof-link">Proof: Asheville automations →</span>
        </a>
        <a class="proof-item" href="/projects/ghosted">
          <h3>A Small, Checkable Job</h3>
          <p>
            The agent edits the resume, but every change arrives highlighted and versioned, for
            the person to accept or reject.
          </p>
          <span class="proof-link">Proof: Ghosted →</span>
        </a>
        <a class="proof-item" href="/projects/vegavengers">
          <h3>Approval Where It Matters</h3>
          <p>
            An AI checker proposes festival updates as ordinary CMS drafts. Editors publish; the
            AI never does.
          </p>
          <span class="proof-link">Proof: VegAvengers →</span>
        </a>
      </div>
  </Section>

  <Section
    class="about"
    id="about"
    title="About"
    titleId="about-heading"
    intro="I came to product design through visual journalism, brand systems, and front-end engineering. That range lets me translate creative intent into product rules, prototype behavior, make constraints legible, and speak the language of the team shipping it."
    data-scene-stop="About"
  />

  <Section
    class="contact"
    title="Let’s Talk"
    titleId="contact-heading"
    intro="Open to design systems, brand and product design roles, remote in the US or in Portland. The fastest way to reach me is email."
    data-scene-stop="Let’s Talk"
  >
      <div class="contact-actions">
        <Button href={`mailto:${email}`}>Email Me</Button>
        <ArrowLink href="/resume">View Resume</ArrowLink>
      </div>
  </Section>
</SceneLayout>

<script>
  // Case-study videos play only while they're on screen (and never under reduced motion, where
  // they show their first frame).
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-work-video]");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (still || !("IntersectionObserver" in window)) {
    videos.forEach((v) => (v.preload = "metadata"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: "200px 0px" },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  /* ---------- arrival: identity, role and the route to work, over the scene at once ---------- */
  .hero {
    position: relative;
    overflow-x: clip; /* the copy scrim must not widen the page */
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--scene-bar));
    padding: var(--space-48) var(--scene-copy-end) var(--scene-copy-bottom) var(--scene-copy-start);
  }

  .hero-copy {
    max-width: 42rem;
    color: var(--text-on-art);
  }

  .hero-name {
    margin: 0 0 var(--space-12);
    font-family: var(--font-title);
    font-size: var(--type-display-scene);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .kicker-dot {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-circle);
    background: var(--action-primary);
    transform: translateY(-1px);
  }

  .hero-line {
    max-width: 24ch;
    margin: 0 0 var(--space-16);
    font-family: var(--font-title);
    font-size: var(--type-hero-line);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hero-line-sub {
    display: block;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .hero-summary {
    max-width: var(--layout-measure-narrow);
    margin: 0 0 var(--space-24);
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
  }

  /* ---------- reading: the content over the focused scene ---------- */
  .work {
    padding-block: var(--space-96) var(--space-64);
  }

  .work-list {
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }

  .view-all {
    margin-top: var(--space-32);
  }

  .how,
  .about,
  .contact {
    padding-block: var(--space-64);
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-24);
    margin-top: var(--space-48);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-16);
    border-top: var(--stroke-frame) solid var(--border-strong);
    color: var(--text-on-art);
    transition: border-color var(--motion-ui) var(--ease-out);
  }

  .proof-item:hover,
  .proof-item:focus-visible {
    border-top-color: var(--action-primary);
  }

  .proof-item h3 {
    margin: 0 0 var(--space-12);
    font-size: var(--type-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-title);
    text-transform: uppercase;
  }

  .proof-item p {
    margin: 0 0 var(--space-16);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .proof-link {
    margin-top: auto;
    /* small text over the focused scene: green measured 4.46:1 on the still, so it reads in the
       on-art label color; the card's top rule turns green on hover instead */
    color: var(--text-on-art-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .contact {
    padding-bottom: var(--space-96);
  }

  .contact-actions {
    margin-top: var(--space-24);
  }

  /* ---------- phones ---------- */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-32) var(--layout-gutter) var(--space-96);
    }

    .hero-summary {
      font-size: var(--type-small);
      line-height: var(--leading-small);
    }
  }

  @media (width <= 900px) {
    .proof-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
