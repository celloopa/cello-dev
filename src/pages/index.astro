---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { basics } from "@cv";
import "@/styles/colors.css";
import Mail from "@/icons/Mail.astro";
import GitHub from "@/icons/GitHub.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import Bsky from "@/icons/Bsky.astro";
import Sun from "@/icons/Sun.astro";
import type { SocialIcon } from "@/types";

const { name, profiles, email } = basics;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  Bsky,
};

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured && p.data.complete)
  .sort((a, b) => a.data.order - b.data.order);

const homeTitle = "Cello — Digital Designer, Brand & Design Systems";
const homeDescription =
  "I lead design across three brands through a shared Figma system, then build the components and tools that carry it into everyday use.";

const marqueeWords = [
  "Design Systems",
  "Brand Systems",
  "Design Engineering",
  "Human-Centered AI",
];
---

<Layout title={homeTitle} description={homeDescription}>
  <section class="hero">
    <div class="title-block">
      <svg
        class="hero-construct"
        viewBox="0 0 640 260"
        fill="none"
        aria-hidden="true"
      >
        <path class="hc-line" pathLength="100" d="M0 224 H640"></path>
        <path class="hc-line hc-tick" pathLength="100" d="M16 210 V238"></path>
        <path class="hc-line hc-tick" pathLength="100" d="M624 210 V238"></path>
        <path
          class="hc-arc"
          pathLength="100"
          d="M598 18 a 46 46 0 1 0 46 46"></path>
        <path class="hc-cross" pathLength="100" d="M20 36 h44 M42 14 v44"
        ></path>
        <circle class="hc-dot" cx="42" cy="36" r="4"></circle>
      </svg>
      <h1 class="nickname" id="typewriter-name">
        <span class="typewriter-text"></span><span class="cursor">|</span>
      </h1>
      <div class="hero-bar" aria-hidden="true">
        <span class="hero-bar-heavy"></span>
        <span class="hero-bar-thin"></span>
      </div>
    </div>
    <div class="hero-copy">
      <p class="kicker">
        <span class="kicker-dot" aria-hidden="true"></span>
        <span class="kicker-text">Open to design systems, brand and product design roles</span>
      </p>
      <p class="title-line">
        Digital Designer
        <span class="title-line-sub">Brand &amp; Design Systems</span>
      </p>
      <p class="summary">
        I lead design across three brands through a shared Figma system, then
        build the components and tools that carry it into everyday use.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a href="/projects" class="cta primary" data-magnetic>View Case Studies</a>
        <a href="/resume" class="cta-link">
          <span>View Resume</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 12H19M19 12L12 5M19 12L12 19"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="image-frame">
        <img src="/images/profile.webp" alt={name} />
      </div>
      <div class="socials">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title="Email"
              aria-label="Email Marcelo Rondon"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            return (
              <a
                href={url}
                title={network}
                aria-label={network === "Bsky" ? "Bluesky" : network}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            );
          })
        }
        <button onclick="toggleTheme()" aria-label="Toggle theme">
          <Sun />
        </button>
      </div>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true" data-reveal="line"></div>

  <section id="about" class="about-section">
    <h2 data-reveal>About</h2>
    <div class="about-preview" data-reveal style="--reveal-i: 1">
      <p>
        I came to product design through visual journalism, brand systems, and
        front-end engineering. That range lets me translate creative intent into
        product rules, prototype behavior, make constraints legible, and speak
        the language of the team shipping it.
      </p>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-seq">
            {marqueeWords.map((word, i) => (
              <>
                <span class={`m-word ${i % 2 ? "outline" : ""}`}>{word}</span>
                <span class={`m-sep ${i % 2 ? "m-tri" : "m-sun"}`} />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="projects-section-wrapper">
    <Section title="Selected Case Studies">
      <div class="bar section-bar"></div>
      <p class="section-intro" data-reveal>
        Systems first: one shared system across three brands, and a design
        system whose tokens and checks keep AI coding agents inside it. Then
        the products I designed and built on the same rules.
      </p>
    </Section>
    <div class="carousel-frame" data-reveal style="--reveal-i: 1">
      <div class="featured-carousel">
        <div class="projects-grid">
          {
            featuredProjects.map((project, i) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                image={project.data.image}
                url={project.data.url}
                techStack={project.data.techStack}
                role={project.data.role}
                slug={project.slug}
                index={i}
              />
            ))
          }
        </div>
      </div>
      <span class="carousel-cue" aria-hidden="true">← SCROLL →</span>
    </div>
    <Section>
      <a href="/projects" class="view-all">
        <span>All Case Studies</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12H19M19 12L12 5M19 12L12 19"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </Section>
  </div>

  <div class="section-divider" aria-hidden="true" data-reveal="line"></div>

  <section class="how-section" aria-labelledby="how-heading">
    <h2 id="how-heading" data-reveal>How I Build</h2>
    <p class="how-intro" data-reveal style="--reveal-i: 1">
      I build what I design, so the system reaches production intact. Code
      does everything it can, the model gets the smallest job it can be
      trusted with, and a person approves wherever the consequences are.
    </p>
    <div class="proof-strip">
      <a
        class="proof-item"
        href="/projects/asheville-dispensary"
        data-reveal
        style="--reveal-i: 0"
      >
        <h3>Code First</h3>
        <p>
          A script checks for new product drops before any model runs. An idle
          day costs about $0.30 instead of $12.
        </p>
        <span class="proof-link">Proof: Asheville automations →</span>
      </a>
      <a
        class="proof-item"
        href="/projects/ghosted"
        data-reveal
        style="--reveal-i: 1"
      >
        <h3>A Small, Checkable Job</h3>
        <p>
          The agent edits the resume, but every change arrives highlighted and
          versioned, for the person to accept or reject.
        </p>
        <span class="proof-link">Proof: Ghosted →</span>
      </a>
      <a
        class="proof-item"
        href="/projects/vegavengers"
        data-reveal
        style="--reveal-i: 2"
      >
        <h3>Approval Where It Matters</h3>
        <p>
          An AI checker proposes festival updates as ordinary CMS drafts. Editors
          publish; the AI never does.
        </p>
        <span class="proof-link">Proof: VegAvengers →</span>
      </a>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true" data-reveal="line"></div>

  <section class="contact-section" aria-label="Contact">
    <h2 data-reveal>Let’s Talk</h2>
    <p data-reveal style="--reveal-i: 1">
      Open to design systems, brand and product design roles, remote in the US or in Portland.
      The fastest way to reach me is email.
    </p>
    <div class="contact-actions" data-reveal style="--reveal-i: 2">
      <a href={`mailto:${email}`} class="cta primary" data-magnetic>Email Me</a>
      <a href="/resume" class="cta-link">
        <span>View Resume</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 12H19M19 12L12 5M19 12L12 19"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  function toggleTheme() {
    const currentTheme = localStorage.getItem("theme") || "dark";
    const newTheme = currentTheme === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", newTheme);
    localStorage.setItem("theme", newTheme);
  }

  function initTypewriter() {
    const text = "Cello";
    const element = document.querySelector(".typewriter-text");
    const titleBlock = document.querySelector(".title-block");
    const cursor = document.querySelector(".cursor");
    if (!element) return;

    titleBlock?.classList.remove("is-locked");
    cursor?.classList.remove("is-hidden");

    function lockTitle() {
      titleBlock?.classList.add("is-locked");
      window.dispatchEvent(new CustomEvent("typewriter:done"));
      window.setTimeout(() => cursor?.classList.add("is-hidden"), 600);
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      element.textContent = text;
      titleBlock?.classList.add("is-locked");
      cursor?.classList.add("is-hidden");
      return;
    }

    const typeSpeed = 150;
    let charIndex = 0;

    function type() {
      if (charIndex < text.length) {
        element.textContent = text.substring(0, charIndex + 1);
        charIndex++;
        setTimeout(type, typeSpeed);
      } else {
        lockTitle();
      }
    }

    element.textContent = "";
    type();
  }

  function initHeroParallax() {
    if (
      !window.matchMedia("(pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }
    const hero = document.querySelector(".hero");
    const frame = document.querySelector(".image-frame");
    if (!hero || !frame || frame.dataset.parallaxBound) return;
    frame.dataset.parallaxBound = "true";

    let raf = 0;
    let pointerX = 0;
    let pointerY = 0;

    function apply() {
      raf = 0;
      const r = frame.getBoundingClientRect();
      const clamp = (v) => Math.max(-1, Math.min(1, v));
      const x = clamp((pointerX - (r.left + r.width / 2)) / r.width);
      const y = clamp((pointerY - (r.top + r.height / 2)) / r.height);
      frame.style.setProperty("--par-x", x.toFixed(3));
      frame.style.setProperty("--par-y", y.toFixed(3));
    }

    hero.addEventListener("pointermove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!raf) raf = requestAnimationFrame(apply);
    });

    hero.addEventListener("pointerleave", () => {
      frame.style.setProperty("--par-x", "0");
      frame.style.setProperty("--par-y", "0");
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initTypewriter();
    initHeroParallax();
  });

  document.addEventListener("astro:after-swap", () => {
    initTypewriter();
    initHeroParallax();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-areas:
      "title visual"
      "copy copy";
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: clamp(1.5rem, 4vh, 3rem);
    align-items: center;
    width: min(100%, 1100px);
    padding: clamp(1rem, 4vh, 3rem) var(--space-32) clamp(2rem, 5vh, 3.5rem);
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-copy {
    grid-area: copy;
    min-width: 0;
    max-width: 42rem;
    animation: slideLeft 0.8s var(--ease-out) backwards;
  }

  .title-block {
    position: relative;
    grid-area: title;
    margin-bottom: 0;
  }

  .hero-construct {
    position: absolute;
    inset: -12% -4%;
    width: 108%;
    height: 124%;
    z-index: -1;
    pointer-events: none;
    overflow: visible;
  }

  .hero-construct path {
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .hero-construct .hc-line {
    stroke: var(--accent-construction);
    opacity: 0.4;
  }

  .hero-construct .hc-arc {
    stroke: var(--color-accent-secondary);
    opacity: 0.5;
  }

  .hero-construct .hc-cross {
    stroke: var(--accent-construction);
    opacity: 0.45;
  }

  .hero-construct .hc-dot {
    fill: var(--color-accent);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out) 1s;
  }

  .title-block.is-locked .hero-construct path {
    animation: drawPath 0.9s var(--ease-out) forwards;
  }

  .title-block.is-locked .hero-construct .hc-tick {
    animation-delay: 0.25s;
  }

  .title-block.is-locked .hero-construct .hc-arc {
    animation-delay: 0.4s;
  }

  .title-block.is-locked .hero-construct .hc-cross {
    animation-delay: 0.55s;
  }

  .title-block.is-locked .hero-construct .hc-dot {
    opacity: 0.7;
  }

  @keyframes drawPath {
    to {
      stroke-dashoffset: 0;
    }
  }

  h1.nickname {
    font-size: clamp(4.5rem, 10vw, 10rem) !important;
    line-height: 1 !important;
    margin: 0;
    padding: 0;
    color: var(--color-accent);
    display: inline-flex;
    align-items: baseline;
    letter-spacing: normal;
    white-space: nowrap;
    position: relative;
  }

  .typewriter-text {
    display: inline-block;
    min-width: 5ch;
    font-size: inherit !important;
  }

  .title-block.is-locked .typewriter-text {
    animation: typeSettle 0.24s var(--ease-out);
  }

  .cursor {
    display: inline-block;
    color: var(--text-primary);
    font-weight: var(--weight-regular);
    font-size: inherit !important;
    animation: blink 0.7s step-end infinite;
    transition: opacity var(--motion-ui) var(--ease-out);
  }

  .cursor.is-hidden {
    opacity: 0;
  }

  @media (max-width: 700px) {
    .cursor {
      margin-left: -0.5ch;
      margin-right: -0.5ch;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes typeSettle {
    0%,
    100% {
      transform: scale(1);
    }
    55% {
      transform: scale(1.04);
    }
  }

  @keyframes barLockSweep {
    0% {
      transform: translateX(-101%);
    }
    45% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(101%);
    }
  }

  .bar {
    width: 100px;
    height: 6px;
    background: var(--color-accent);
    margin-top: var(--space-16);
    margin-left: 0.8rem;
    animation: wipeIn 0.5s var(--ease-out) 0.3s backwards;
  }

  .section-bar {
    margin-bottom: var(--space-24);
  }

  .hero-bar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-top: var(--space-16);
    margin-left: 0.8rem;
    animation: wipeIn 0.5s var(--ease-out) 0.3s backwards;
    transform-origin: left;
  }

  .hero-bar-heavy {
    position: relative;
    overflow: hidden;
    width: 60px;
    height: 8px;
    background: var(--color-accent);
  }

  .hero-bar-heavy::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--text-primary);
    transform: translateX(-101%);
  }

  .title-block.is-locked .hero-bar-heavy::after {
    animation: barLockSweep 0.42s var(--ease-out);
  }

  .hero-bar-thin {
    width: 140px;
    height: 2px;
    background: var(--text-primary);
    opacity: 0.7;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
    animation: slideUp var(--motion-entry) var(--ease-out) 0.2s backwards;
  }

  .kicker-text {
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--text-primary);
  }

  .kicker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: kickerPulse 2.4s ease-in-out infinite;
  }

  @keyframes kickerPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kicker-dot {
      animation: none;
    }
  }

  .title-line {
    color: var(--color-accent);
    font-size: 2rem;
    font-weight: var(--weight-black);
    line-height: 1.12;
    max-width: 24ch;
    margin: 0 0 var(--space-16);
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: normal;
    animation: slideUp var(--motion-entry) var(--ease-out) 0.25s backwards;
  }

  .title-line-sub {
    display: block;
    margin-block: 0.35rem 0;
    line-height: var(--leading-title);
    text-align: inherit;
    color: var(--text-primary);
    font-size: 0.55em;
    letter-spacing: var(--track-caps);
  }

  .summary {
    font-size: var(--type-body);
    line-height: 1.7;
    max-width: 58ch;
    overflow-wrap: break-word;
    animation: slideUp var(--motion-entry) var(--ease-out) 0.3s backwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-24);
    animation: slideUp var(--motion-entry) var(--ease-out) 0.4s backwards;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-12) var(--space-16);
    border: 3px solid var(--color-accent);
    font-size: var(--type-small);
    font-weight: var(--weight-extrabold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .cta.primary {
    background: var(--color-accent);
    color: var(--bg-canvas);
  }

  .cta:hover,
  .cta:focus-visible {
    transform: translateY(-2px);
  }

  .cta.primary:hover,
  .cta.primary:focus-visible {
    background: transparent;
    color: var(--color-accent);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-12) var(--space-4);
    color: var(--color-accent);
    font-size: var(--type-small);
    font-weight: var(--weight-extrabold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    transition: gap var(--motion-ui) var(--ease-out);
  }

  .cta-link:hover,
  .cta-link:focus-visible {
    gap: var(--space-12);
  }

  .hero-visual {
    grid-area: visual;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: end;
    min-width: 0;
    gap: var(--space-20);
    animation: slideRight 0.8s var(--ease-out) 0.2s backwards;
  }

  .image-frame {
    position: relative;
    border: 4px solid var(--text-primary);
  }

  .image-frame::before {
    content: "";
    position: absolute;
    top: 10px;
    left: 10px;
    right: -10px;
    bottom: -10px;
    border: 4px solid var(--color-accent);
    z-index: -1;
    transform: translate(
      calc(var(--par-x, 0) * -9px),
      calc(var(--par-y, 0) * -9px)
    );
    transition: transform 0.45s var(--ease-out);
  }

  .image-frame img {
    width: clamp(220px, 24vw, 300px);
    height: clamp(220px, 24vw, 300px);
    object-fit: cover;
    display: block;
    filter: grayscale(30%);
    transform: translate(
      calc(var(--par-x, 0) * 5px),
      calc(var(--par-y, 0) * 5px)
    );
    transition:
      filter 0.3s ease,
      transform 0.45s var(--ease-out);
  }

  .image-frame:hover img {
    filter: grayscale(0%);
  }

  .socials {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
    justify-content: center;
  }

  .socials a,
  .socials button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--text-primary);
    background: var(--bg-canvas);
    color: var(--text-primary);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .socials a:hover,
  .socials a:focus-visible,
  .socials button:focus-visible,
  .socials button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--bg-canvas);
    transform: translateY(-2px);
  }

  @media (hover: none), (pointer: coarse) {
    .image-frame:hover img,
    .socials a:hover,
    .socials button:hover {
      transform: none;
      filter: grayscale(30%);
    }
  }

  .how-section {
    max-width: 1100px;
    margin: 0 auto;
    padding-inline: var(--space-32);
  }

  .how-section > h2 {
    margin: 0 0 var(--space-12);
    color: var(--color-accent);
    font-size: var(--type-heading);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-transform: uppercase;
