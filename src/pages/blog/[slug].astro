---
/*
 * A post in the landscape (landscape build S2). It opens over a scene from the post rotation
 * (src/data/scene-pairings.json, stable per slug) already in the reading state: the focus dim, a
 * still scene, and the bar showing the post + "All posts". The words and the MDX are today's,
 * unchanged; the body is Prose (2c's Geist Sans reading measure), and the page ends on the next
 * story.
 */
import "@fontsource-variable/geist";
import "@fontsource-variable/geist/wght-italic.css";
import { getCollection, render } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import Prose from "@/components/ui/Prose.astro";
import Embed from "@/components/blog/Embed.astro";
import ReadHead from "@/components/scene/ReadHead.astro";
import StoryEnd from "@/components/scene/StoryEnd.astro";
import { sceneForPost } from "@/lib/scene/pairing";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishDate, image, tags, updatedDate } = post.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const formattedUpdatedDate = updatedDate && formatDate(updatedDate);

// newest first, like /blog; the next story is the next one down the list (wrapping)
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const i = posts.findIndex((p) => p.slug === post.slug);
const story = (p: (typeof posts)[number]) => ({
  href: `/blog/${p.slug}`,
  title: p.data.title,
  eyebrow: formatDate(p.data.publishDate),
  description: p.data.description,
});
const next = story(posts[(i + 1) % posts.length]);
const previous = story(posts[(i - 1 + posts.length) % posts.length]);
const all = { href: "/blog", label: "All posts" };
---

<SceneLayout
  title={`${title} - Marcelo Rondon`}
  description={description}
  image={image}
  canonicalPath={`/blog/${post.slug}`}
  place={sceneForPost(post.slug)}
  reading={{ title, all }}
>
  <article class="read">
    <ReadHead
      eyebrow={formatDate(publishDate)}
      eyebrowKind="date"
      title={title}
      lede={description}
      tags={tags}
      cover={image ? { src: image, alt: title } : undefined}
    >
      {formattedUpdatedDate && <p class="read-updated">Updated: {formattedUpdatedDate}</p>}
    </ReadHead>

    <div class="read-body container">
      <Prose>
        <Content components={{ Embed }} />
      </Prose>

      {posts.length > 1 && <StoryEnd next={next} previous={previous} all={all} />}
    </div>
  </article>
</SceneLayout>

<style>
  .read {
    padding-block: var(--space-64) var(--space-96);
    color: var(--text-on-art);
  }

  .read-updated {
    margin: 0;
    color: var(--text-on-art-muted);
    font-size: var(--type-small);
  }

  @media (width <= 700px) {
    .read {
      padding-top: var(--space-32);
    }
  }
</style>
