---
/*
 * /projects as the scene selector (landscape build S3; A3 item 7). Today's list, copy and
 * order: every complete case study by `order`, with today's card content. Each one carries the
 * swatch of the place it opens over (src/data/scene-pairings.json); pointing at one brings its
 * place in behind the list. Archived and retired case studies (complete: false) stay off the
 * list, as today.
 */
import { getCollection } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import SceneSelector from "@/components/scene/SceneSelector.astro";
import { sceneArt } from "@/lib/scene/catalog";
import { homeScene, sceneForProject } from "@/lib/scene/pairing";
import { projectEyebrow } from "@/lib/project-label";

const projects = await getCollection("projects");
const items = projects
  .filter((project) => project.data.complete)
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    href: `/projects/${project.id}`,
    title: project.data.title,
    eyebrow: projectEyebrow(project.data),
    description: project.data.description,
    tags: project.data.techStack,
    live: project.data.url,
    scene: sceneArt(sceneForProject(project.id)),
  }));
---

<SceneLayout
  title="Work - Marcelo Rondon"
  description="Product design case studies on design systems and human-centered AI tools: what code does, what the model does, and where people approve."
  canonicalPath="/projects"
  place={homeScene()}
  focus
  backdrops={items.map((item) => item.scene.id)}
>
  <div class="index container">
    <header class="index-head">
      <h1 class="index-title">My Work</h1>
      <p class="index-intro">
        Four case studies. In each one, code does everything it can, the model gets the smallest
        job it can be trusted with, and a person approves wherever the consequences are.
      </p>
    </header>
    <SceneSelector items={items} label="Case studies" preview />
  </div>
</SceneLayout>

<style>
  .index {
    padding-block: var(--space-64) var(--space-96);
  }

  .index-head {
    margin-bottom: var(--space-48);
  }

  .index-title {
    margin: 0 0 var(--space-16);
    color: var(--text-accent);
    font-family: var(--font-title);
    font-size: var(--type-page-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .index-intro {
    max-width: var(--layout-measure);
    margin: 0;
    color: var(--text-on-art);
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
  }
</style>
