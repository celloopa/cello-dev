---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist/wght-italic.css";
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import CaseMeta from "@/components/CaseMeta.astro";
import "@/styles/colors.css";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => project.data.complete)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const sectionLinks = headings.filter((h) => h.depth === 2);
const {
  title,
  description,
  image,
  ogImage,
  url,
  github,
  techStack,
  role,
  highlights,
  summary,
  media,
} = project.data;

const isVideo = (src: string) =>
  src?.endsWith(".webm") || src?.endsWith(".mp4");
const mainIsVideo = isVideo(image || "");
const allProjects = (await getCollection("projects"))
  .filter((item) => item.data.complete)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const projectIndex = allProjects.findIndex(
  (item) => item.slug === project.slug,
);
const previousProject =
  projectIndex > 0 ? allProjects[projectIndex - 1] : allProjects.at(-1);
const nextProject =
  projectIndex < allProjects.length - 1
    ? allProjects[projectIndex + 1]
    : allProjects[0];
---

<Layout
  title={`${title} - Marcelo Rondon`}
  description={description}
  image={ogImage || image}
  canonicalPath={`/projects/${project.slug}`}
>
  <article class="project-page">
    <Section>
      <div class="top-row">
        <div class="project-kicker">
          <span class="role-badge">{role}</span>
        </div>
        <a href="/projects" class="back-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path
              d="M19 12H5M5 12L12 5M5 12L12 19"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Back to work</span>
        </a>
      </div>

      <header class="project-header">
        <h1>{title}</h1>
        <div class="bar"></div>
        <p class="description">{description}</p>

        <ul class="tech-stack">
          {
            techStack
              .slice(0, 4)
              .map((tech, i) => <li style={`--i: ${i}`}>{tech}</li>)
          }
          {
            techStack.length > 4 && (
              <li class="tag-more" style={`--i: 4`}>
                +{techStack.length - 4}
              </li>
            )
          }
        </ul>

        <div class="links">
          {
            url && (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
              >
                <span>View Live</span>
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path
                    d="M13.5 9.75V14.25C13.5 15.4926 12.4926 16.5 11.25 16.5H3.75C2.50736 16.5 1.5 15.4926 1.5 14.25V6.75C1.5 5.50736 2.50736 4.5 3.75 4.5H8.25M11.25 1.5H16.5M16.5 1.5V6.75M16.5 1.5L7.5 10.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )
          }
          {
            github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="btn outline"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                <span>GitHub</span>
              </a>
            )
          }
        </div>
      </header>
    </Section>

    {
      image && (
        <Section>
          <div class="media-gallery media-full">
            {mainIsVideo ? (
              <video
                src={image}
                class="project-media"
                autoplay
                loop
                muted
                playsinline
              />
            ) : (
              <img src={image} alt={title} class="project-media" />
            )}
          </div>
        </Section>
      )
    }

    {
      media &&
        media.map((gallery) => (
          <Section>
            <div class={`media-gallery media-${gallery.layout}`}>
              {gallery.items.map((item, itemIndex) => (
                <figure class="media-item" style={`--i: ${itemIndex}`}>
                  {isVideo(item.src) ? (
                    <video
                      src={item.src}
                      class="project-media"
                      autoplay
                      loop
                      muted
                      playsinline
                    />
                  ) : (
                    <img
                      src={item.src}
                      alt={item.alt || title}
                      class="project-media"
                    />
                  )}
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </Section>
        ))
    }

    {
      (summary || sectionLinks.length > 2) && (
        <Section>
          <div class="case-open">
            {summary && <CaseMeta items={summary} />}
            {sectionLinks.length > 2 && (
              <nav class="section-links" aria-label="On this page">
                <span>On this page</span>
                <ul>
                  {sectionLinks.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </div>
        </Section>
      )
    }

    <Section>
      <div class="content">
        <Content />
      </div>
    </Section>

    {
      highlights.length > 0 && (
        <Section>
          <h2>Highlights</h2>
          <div class="bar" />
          <ul class="highlights">
            {highlights.map((highlight, i) => (
              <li style={`--i: ${i}`}>
                <p>{highlight}</p>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section>
      <div class="footer-nav">
        {
          previousProject && (
            <a
              href={`/projects/${previousProject.slug}`}
              class="nav-link nav-link--adjacent"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path
                  d="M19 12H5M5 12L12 19M5 12L12 5"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{previousProject.data.title}</span>
            </a>
          )
        }
        <a href="/projects" class="nav-link nav-link--all">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path
              d="M19 12H5M5 12L12 19M5 12L12 5"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>All Projects</span>
        </a>
        {
          nextProject && (
            <a
              href={`/projects/${nextProject.slug}`}
              class="nav-link nav-link--adjacent"
            >
              <span>{nextProject.data.title}</span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path
                  d="M5 12H19M19 12L12 5M19 12L12 19"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )
        }
      </div>
    </Section>
  </article>
</Layout>

<style>
  .project-page {
    padding-top: var(--space-16);
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: 0.8rem;
    margin-bottom: var(--space-24);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--text-primary);
    font-size: var(--type-ui);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    transition:
      color var(--motion-ui) var(--ease-out),
      gap var(--motion-ui) var(--ease-out);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-accent);
    gap: var(--space-12);
  }

  .project-header {
    padding-inline: 0.8rem;
  }

  .role-badge {
    display: inline-block;
    font-size: var(--type-small);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    padding: var(--space-8) var(--space-12);
  }

  .project-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  h1 {
    font-size: var(--type-page-title);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-16) 0;
    padding: 0;
    overflow-wrap: anywhere;
    animation: enter-rise var(--motion-entry) var(--ease-out) calc(var(--motion-stagger) * 2) backwards;
  }

  .bar {
    width: 80px;
    height: 5px;
    background: var(--color-accent);
    margin-bottom: var(--space-24);
    animation: enter-wipe var(--motion-entry) var(--ease-out) calc(var(--motion-stagger) * 3) backwards;
  }

  .description {
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
    max-width: 60ch;
    margin: 0 0 var(--space-32) 0;
    padding: 0;
    animation: enter-rise var(--motion-entry) var(--ease-out) calc(var(--motion-stagger) * 5) backwards;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-32);
  }

  .tech-stack li {
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--text-primary);
    border: 2px solid var(--text-primary);
    padding: var(--space-8) var(--space-12);
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
    animation: enter-rise var(--motion-entry) var(--ease-out) backwards;
    animation-delay: calc(var(--motion-stagger) * (7 + var(--i)));
  }

  .tech-stack li:hover {
    background: var(--text-primary);
    color: var(--bg-canvas);
  }

  .tech-stack .tag-more {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .tech-stack .tag-more:hover {
    background: var(--color-accent);
    color: var(--bg-canvas);
  }

  .links {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    animation: enter-rise var(--motion-entry) var(--ease-out) var(--motion-entry) backwards;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-12) var(--space-24);
    font-size: var(--type-small);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    background: var(--color-accent);
    color: var(--bg-canvas);
    border: 3px solid var(--color-accent);
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .btn:hover,
  .btn:focus-visible {
    background: var(--bg-canvas);
    color: var(--color-accent);
  }

  .btn.outline {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .btn.outline:hover,
  .btn.outline:focus-visible {
    background: var(--text-primary);
    color: var(--bg-canvas);
  }

  /* Media Gallery Layouts */
  .media-gallery {
    position: relative;
    padding-inline: 0.8rem;
    animation: enter-scale var(--motion-entry) var(--ease-out) backwards;
  }

  .media-full {
    display: block;
  }

  .media-full::before {
    content: "";
    position: absolute;
    top: 10px;
    left: calc(0.8rem + 10px);
    right: calc(0.8rem - 10px);
    bottom: -10px;
    z-index: -1;
    border: 4px solid var(--color-accent);
    pointer-events: none;
  }

  .media-two {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
  }

  .media-three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }

  .media-item {
    margin: 0;
    animation: enter-rise var(--motion-entry) var(--ease-out) backwards;
    animation-delay: calc(var(--i) * var(--motion-stagger));
  }

  .media-item figcaption {
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--text-primary);
    padding: var(--space-12) 0;
    border-bottom: 2px solid var(--color-accent);
    margin: 0;
  }

  .project-media {
    width: 100%;
    border: 4px solid var(--text-primary);
    filter: grayscale(20%);
    transition: filter var(--motion-ui) var(--ease-out);
  }

  .media-full .project-media {
    max-height: 600px;
    object-fit: cover;
  }

  .media-two .media-item,
  .media-three .media-item {
    position: relative;
  }

  .media-two .project-media,
  .media-three .project-media {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  .project-media:hover {
    filter: grayscale(0%);
  }

  @media (width <= 900px) {
    .media-three {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width <= 700px) {
    .media-two,
    .media-three {
      grid-template-columns: 1fr;
    }

    .media-full .project-media {
      max-height: 300px;
    }
  }

  h2 {
    font-size: var(--type-heading);
    line-height: var(--leading-heading);
    margin: 0 0 var(--space-12) 0;
    animation: enter-from-left var(--motion-entry) var(--ease-out) backwards;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    padding-inline: 0.8rem;
  }

  .highlights li {
    position: relative;
    min-height: 100%;
    padding: var(--space-16);
    border: 3px solid var(--text-primary);
    background: var(--bg-raised);
    font-size: var(--type-body);
    line-height: var(--leading-read);
    animation: enter-rise var(--motion-entry) var(--ease-out) backwards;
    animation-delay: calc(var(--i) * var(--motion-stagger));
    transition:
      border-color var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
  }

  .highlights li:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .highlights li p {
    margin: 0;
    padding: 0;
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  .case-open {
    padding-inline: 0.8rem;
    max-width: 72ch;
  }

  .case-open :global(.case-meta) {
    margin-top: 0;
  }

  .section-links {
    margin: 0 0 var(--space-16);
  }

  .section-links span {
    display: block;
    margin-bottom: var(--space-8);
    color: var(--color-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .section-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-links a {
    display: inline-block;
    padding: var(--space-4) var(--space-12);
    border: 2px solid var(--text-primary);
    color: var(--text-primary);
    font-size: var(--type-small);
    line-height: var(--leading-title);
    text-decoration: none;
  }

  .section-links a:hover,
  .section-links a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (width <= 700px) {
    .section-links ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: var(--space-8);
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }

    .section-links li {
      flex: none;
      scroll-snap-align: start;
    }
  }

  .content :global(h2),
  .content :global(h3) {
    scroll-margin-top: 5rem;
  }

  .content {
    padding-inline: 0.8rem;
    max-width: 72ch;
    animation: enter-rise var(--motion-entry) var(--ease-out) backwards;
  }

  /* Long reading (A2): the article's own paragraphs, lists and quotes set in Geist Sans, at a
     reading measure of about 69 characters. Media and headings keep the wider column.
     Embedded components (CaseMeta, FlowDiagram, media captions) keep Geist Mono. */
  .content > :global(p),
  .content > :global(ul),
  .content > :global(ol),
  .content > :global(blockquote) {
    font-family: var(--font-read);
    max-width: var(--layout-measure-read);
  }

  .content :global(h2) {
    font-size: var(--type-heading);
    line-height: var(--leading-heading);
    color: var(--color-accent);
    margin: var(--space-48) 0 var(--space-16) 0;
    padding: 0;
    text-transform: uppercase;
  }

  .content :global(h2:first-child) {
    margin-top: 0;
  }

  .content :global(p) {
    padding: 0;
    margin: 0 0 var(--space-20) 0;
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: var(--space-24);
    margin: 0 0 var(--space-20) 0;
  }

  .content :global(ul) {
    list-style: none;
  }

  .content :global(ul li) {
    position: relative;
    padding-left: var(--space-24);
  }

  .content :global(ul li::before) {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  .content :global(ol) {
    list-style: decimal;
  }

  .content :global(li) {
    margin-bottom: var(--space-8);
    line-height: var(--leading-read);
  }

  .content :global(code) {
    font-family: var(--font-mono); /* Was the browser's monospace (Courier); code stays Geist Mono inside Geist Sans prose. */
    background: var(--bg-muted);
    border: 1px solid var(--border-muted);
    padding: var(--space-4) var(--space-8);
    font-size: 0.9em;
  }

  .content :global(pre) {
    background: var(--text-primary);
    color: var(--bg-canvas);
    border: 3px solid var(--text-primary);
    padding: var(--space-24);
    overflow-x: auto;
    margin: 0 0 var(--space-24) 0;
  }

  .content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .content :global(blockquote) {
    border: 2px solid var(--color-accent);
    padding: var(--space-16) var(--space-20);
    margin: var(--space-24) 0;
    font-style: italic;
  }

  .footer-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-48) 0.8rem;
    border-top: 3px solid var(--text-primary);
    margin-top: var(--space-32);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    font-size: var(--type-body);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    padding: var(--space-12) var(--space-24);
    border: 3px solid var(--color-accent);
    text-align: center;
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out),
      gap var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
  }

  .nav-link--adjacent {
    max-width: 18rem;
    color: var(--text-primary);
    border-color: var(--text-primary);
    font-size: var(--type-small);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--color-accent);
    color: var(--bg-canvas);
    gap: var(--space-8);
  }

     @media (width <= 700px) {
    .project-page {
      padding-top: var(--space-8);
    }

    .top-row {
      flex-direction: column;
      align-items: center;
      gap: var(--space-12);
    }

    h1 {
      font-size: var(--type-page-title);
      text-align: center;
    }

    .bar {
      margin-left: auto;
      margin-right: auto;
    }

    .description {
      font-size: var(--type-body);
      text-align: center;
    }

    .tech-stack {
      justify-content: center;
    }

    .project-image {
      max-height: 300px;
    }

    .btn {
      padding: var(--space-8) var(--space-16);
      font-size: var(--type-small);
    }

    .links {
      flex-direction: column;
