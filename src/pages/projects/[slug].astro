---
/*
 * A case study in the landscape (landscape build S2). It opens over its paired scene
 * (src/data/scene-pairings.json) already in the reading state: the focus dim, a still scene, and
 * the bar showing the project + "All work". The words and the MDX are today's, unchanged; the
 * article body is Prose (2c's Geist Sans reading measure), and the page ends on the next story.
 */
import "@fontsource-variable/geist";
import "@fontsource-variable/geist/wght-italic.css";
import { getCollection, render } from "astro:content";
import SceneLayout from "@/layouts/SceneLayout.astro";
import Prose from "@/components/ui/Prose.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import CaseMeta from "@/components/CaseMeta.astro";
import MediaFull from "@/components/media/MediaFull.astro";
import MediaTwo from "@/components/media/MediaTwo.astro";
import MediaThree from "@/components/media/MediaThree.astro";
import ReadHead from "@/components/scene/ReadHead.astro";
import StoryEnd from "@/components/scene/StoryEnd.astro";
import { sceneForProject } from "@/lib/scene/pairing";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => project.data.complete)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const sectionLinks = headings.filter((h) => h.depth === 2);
const { title, description, image, ogImage, url, github, techStack, role, highlights, summary, media } = project.data;

const allProjects = (await getCollection("projects"))
  .filter((item) => item.data.complete)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const i = allProjects.findIndex((item) => item.slug === project.slug);
const story = (p: (typeof allProjects)[number]) => ({
  href: `/projects/${p.slug}`,
  title: p.data.title,
  eyebrow: p.data.role,
  description: p.data.description,
});
const next = story(allProjects[(i + 1) % allProjects.length]);
const previous = story(allProjects[(i - 1 + allProjects.length) % allProjects.length]);
const all = { href: "/projects", label: "All work" };
---

<SceneLayout
  title={`${title} - Marcelo Rondon`}
  description={description}
  image={ogImage || image}
  canonicalPath={`/projects/${project.slug}`}
  place={sceneForProject(project.slug)}
  reading={{ title, all }}
>
  <article class="read">
    <ReadHead
      eyebrow={role}
      title={title}
      lede={description}
      tags={techStack}
      maxTags={4}
      tagsLabel="Tools"
      cover={image ? { src: image, alt: title } : undefined}
    >
      {
        (url || github) && (
          <div class="read-links">
            {url && (
              <Button href={url} target="_blank" rel="noopener noreferrer">
                View Live
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path
                    d="M13.5 9.75V14.25C13.5 15.4926 12.4926 16.5 11.25 16.5H3.75C2.50736 16.5 1.5 15.4926 1.5 14.25V6.75C1.5 5.50736 2.50736 4.5 3.75 4.5H8.25M11.25 1.5H16.5M16.5 1.5V6.75M16.5 1.5L7.5 10.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </Button>
            )}
            {github && (
              <Button href={github} target="_blank" rel="noopener noreferrer" variant="secondary">
                GitHub
              </Button>
            )}
          </div>
        )
      }
    </ReadHead>

    <div class="read-body container">
      {
        media?.map((gallery) =>
          gallery.layout === "two" ? (
            <MediaTwo items={gallery.items} />
          ) : gallery.layout === "three" ? (
            <MediaThree items={gallery.items} />
          ) : (
            gallery.items.map((item) => <MediaFull src={item.src} alt={item.alt || title} caption={item.caption} />)
          ),
        )
      }

      {
        (summary || sectionLinks.length > 2) && (
          <div class="read-open">
            {summary && <CaseMeta items={summary} />}
            {sectionLinks.length > 2 && (
              <nav class="read-toc" aria-label="On this page">
                <Eyebrow as="span" tone="on-art" class="read-toc-label">
                  On this page
                </Eyebrow>
                <ul>
                  {sectionLinks.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </div>
        )
      }

      <Prose>
        <Content />
      </Prose>

      {
        highlights.length > 0 && (
          <section class="read-highlights" aria-labelledby="highlights-title">
            <h2 id="highlights-title">Highlights</h2>
            <ul>
              {highlights.map((highlight) => (
                <li>
                  <p>{highlight}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <StoryEnd next={next} previous={previous} all={all} />
    </div>
  </article>
</SceneLayout>

<style>
  /* ---------- the reading column, over the focused scene ---------- */
  .read {
    padding-block: var(--space-64) var(--space-96);
    color: var(--text-on-art);
  }

  .read-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
  }

  /* ---------- the opening: summary panels and the section links ---------- */
  .read-open {
    max-width: var(--layout-measure);
    margin-bottom: var(--space-48);
  }

  .read-open :global(.case-meta) {
    margin-top: 0;
  }

  .read-toc-label {
    margin-bottom: var(--space-8);
  }

  .read-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .read-toc a {
    display: inline-block;
    padding: var(--space-4) var(--space-12);
    border: var(--stroke-control) solid var(--border-strong);
    background: var(--bg-plate);
    color: var(--text-primary);
    font-size: var(--type-small);
    line-height: var(--leading-title);
    transition: border-color var(--motion-ui) var(--ease-out);
  }

  .read-toc a:hover,
  .read-toc a:focus-visible {
    border-color: var(--action-primary);
  }

  /* ---------- highlights ---------- */
  .read-highlights {
    max-width: var(--layout-measure);
    margin-top: var(--space-64);
  }

  .read-highlights h2 {
    margin: 0 0 var(--space-24);
    color: var(--text-accent);
    font-family: var(--font-title);
    font-size: var(--type-heading);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-heading);
    text-transform: uppercase;
  }

  .read-highlights ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .read-highlights li {
    padding: var(--space-16);
    border: var(--stroke-frame) solid var(--border-strong);
    background: var(--bg-plate);
    color: var(--text-primary);
  }

  .read-highlights p {
    margin: 0;
    font-size: var(--type-body);
    line-height: var(--leading-read);
  }

  @media (width <= 700px) {
    .read {
      padding-top: var(--space-32);
    }

    .read-toc ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: var(--space-8);
      scroll-snap-type: x proximity;
    }

    .read-toc li {
      flex: none;
      scroll-snap-align: start;
    }

    .read-highlights ul {
      grid-template-columns: 1fr;
    }
  }
</style>
