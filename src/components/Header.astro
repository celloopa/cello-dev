---
import "@/styles/colors.css";
import AnimatedLogo from "./AnimatedLogo.astro";

const navItems = [
  { label: "Work", href: "/projects" },
  // { label: "Lab", href: "/lab" },
  { label: "Writing", href: "/blog" },
  { label: "Design System", href: "/design-system" },
  // { label: "Visuals", href: "/visuals" },
  { label: "Resume", href: "/resume" },
];

const currentPath = Astro.url.pathname;
const activeNav = navItems.find(
  (item) =>
    currentPath === item.href ||
    (item.href !== "/" && currentPath.startsWith(item.href)),
);
const menuLabel = activeNav?.label ?? "Menu";
---

<header class="site-header">
  <nav class="nav-container">
    <a href="/" class="logo" aria-label="Home">
      <AnimatedLogo />
    </a>
    <div class="nav-right">
      <ul class="nav-links">
        {
          navItems.map((item, i) => (
            <li class="nav-item" style={`--delay: ${i * 0.1}s`}>
              <a
                href={item.href}
                class:list={[
                  "nav-link",
                  {
                    active:
                      currentPath === item.href ||
                      (item.href !== "/" && currentPath.startsWith(item.href)),
                  },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        id="header-menu-btn"
        class="menu-btn"
        aria-label="Menu"
        aria-haspopup="dialog"
        aria-controls="keyboard-shortcuts-menu"
      >
        <span class="menu-key"></span>
        <span class="menu-label">{menuLabel}</span>
      </button>
    </div>
  </nav>
</header>

<script>
  function initHeaderMenu() {
    const menuBtn = document.getElementById("header-menu-btn");
    const menuKey = menuBtn?.querySelector<HTMLElement>(".menu-key");
    const menuLabel = menuBtn?.querySelector<HTMLElement>(".menu-label");

    function detectOS() {
      const userAgent = navigator.userAgent.toLowerCase();
      if (
        userAgent.includes("mac") ||
        userAgent.includes("iphone") ||
        userAgent.includes("ipad")
      )
        return "mac";
      if (userAgent.includes("win")) return "windows";
      if (userAgent.includes("linux")) return "linux";
      return "other";
    }

    function isTouchDevice() {
      return "ontouchstart" in window || navigator.maxTouchPoints > 0;
    }

    const isMac = detectOS() === "mac";
    const isTouch = isTouchDevice();

    if (menuBtn && menuKey && menuLabel) {
      if (isTouch) {
        menuKey.textContent = "";
        menuKey.classList.add("menu-key--dot");
      } else {
        menuKey.textContent = isMac ? "⌘K" : "Ctrl+K";
      }

      menuBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toggleKeyboardMenu"));
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initHeaderMenu);
  document.addEventListener("astro:after-swap", initHeaderMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    overflow-x: clip;
    background: var(--scrim);
    backdrop-filter: blur(6px);
    margin-bottom: var(--space-32);
  }

  .site-header::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3rem;
    transform: translateY(100%);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg-canvas) 10%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .nav-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-32);
  }

  .logo {
    display: flex;
    align-items: center;
    opacity: 0;
    animation: headerSlideLeft var(--motion-entry) var(--ease-out) forwards;
    filter: drop-shadow(0 2px 8px var(--scrim));
    transition: transform var(--motion-ui) var(--ease-out);
  }

  .logo:hover,
  .logo:focus-visible {
    transform: scale(1.1);
  }

  .nav-right {
    display: flex;
    align-items: center;
    margin-left: auto;
    gap: var(--space-16);
  }

  .nav-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    opacity: 0;
    animation: headerSlideRight var(--motion-entry) var(--ease-out) forwards;
    animation-delay: var(--delay);
  }

  .nav-link {
    display: block;
    position: relative;
    padding: var(--space-8) var(--space-16);
    font-size: var(--type-small);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--text-primary);
    border: 2px solid transparent;
    transition:
      border-color var(--motion-ui) var(--ease-out),
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
    text-shadow: 0 2px 8px var(--scrim);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--motion-ui) var(--ease-out);
    transform: translateX(-50%);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    width: 80%;
  }

  .nav-link.active {
    background: var(--color-accent);
    color: var(--bg-canvas);
    border-color: var(--color-accent);
  }

  .nav-link.active::after {
    display: none;
  }

  .nav-link.active:hover,
  .nav-link.active:focus-visible {
    transform: none;
  }

  .menu-btn {
    display: flex;
    position: relative;
    z-index: 0;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.4rem;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-8) var(--space-12);
    background: transparent;
    border: 3px solid var(--text-primary);
    cursor: pointer;
    opacity: 0;
    animation: headerSlideRight var(--motion-entry) var(--ease-out) calc(var(--motion-stagger) * 3) forwards;
    transition:
      background-color var(--motion-ui) var(--ease-out),
      border-color var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
    box-shadow: 0 2px 8px var(--scrim);
  }

  .menu-btn::before {
    content: "";
    position: absolute;
    top: 4px;
    left: 4px;
    right: -4px;
    bottom: -4px;
    border: 3px solid var(--color-accent);
    z-index: -1;
    transition:
      top var(--motion-ui) var(--ease-out),
      right var(--motion-ui) var(--ease-out),
      bottom var(--motion-ui) var(--ease-out),
      left var(--motion-ui) var(--ease-out);
    pointer-events: none;
  }

  .menu-btn:hover::before,
  .menu-btn:focus-visible::before {
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .menu-btn:hover,
  .menu-btn:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .menu-btn:hover .menu-key,
  .menu-btn:focus-visible .menu-key {
    background: var(--bg-canvas);
    color: var(--color-accent);
  }

  .menu-btn:hover .menu-label,
  .menu-btn:focus-visible .menu-label {
    color: var(--bg-canvas);
  }

  .menu-key {
    display: inline-block;
    position: relative;
    z-index: 1;
    background: var(--text-primary);
    color: var(--bg-canvas);
    font-size: 0.7rem;
    font-weight: var(--weight-bold);
    padding: 0.15rem 0.35rem;
    letter-spacing: var(--track-caps);
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .menu-key--dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    background: var(--color-accent);
    align-self: center;
  }

  .menu-btn:hover .menu-key--dot,
  .menu-btn:focus-visible .menu-key--dot {
    background: var(--bg-canvas);
  }

  .menu-label {
    position: relative;
    z-index: 1;
    font-size: 0.8rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--text-primary);
    transition: color var(--motion-ui) var(--ease-out);
    text-shadow: 0 2px 8px var(--scrim);
  }

  @media (max-width: 900px) {
    .site-header {
      margin-bottom: var(--space-24);
    }

    .nav-links {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      margin-bottom: var(--space-16);
    }

    .nav-container {
      padding: var(--space-12) var(--space-16);
    }

    .nav-right {
      gap: var(--space-8);
    }

    .logo-img {
      width: 44px;
      height: 44px;
    }

    .menu-btn {
      padding: var(--space-8) 0.65rem;
    }

    .menu-label {
      font-size: var(--type-label);
    }
  }
</style>
