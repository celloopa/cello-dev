---
/*
 * MediaFull: one image or video across the article column, with an optional caption.
 * Videos go through MediaVideo: `mp4` adds a fallback source, `poster` a still (also what
 * reduced motion shows), `alt` the video's accessible name, and every video gets Pause / Play.
 * Existing single-`src` uses render as before.
 */
import MediaVideo from "./MediaVideo.astro";

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  poster?: string;
  mp4?: string;
  /** Preserve the entire image when its edges carry context, such as a concept screen. */
  uncropped?: boolean;
}

const { src, alt = "", caption, poster, mp4, uncropped = false } = Astro.props;
const isVideo = src?.endsWith(".webm") || src?.endsWith(".mp4");
---

<div class:list={["media-gallery", "media-full", { uncropped }]}>
  <figure class="media-item">
    {
      isVideo ? (
        <MediaVideo src={src} mp4={mp4} poster={poster} label={alt} class="project-media" />
      ) : (
        <img src={src} alt={alt} class="project-media" loading="lazy" decoding="async" />
      )
    }
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</div>

<style>
  .media-gallery {
    margin: var(--space-32) 0;
  }

  .media-item {
    margin: 0;
  }

  .media-item figcaption {
    margin: 0;
    padding: var(--space-12) 0;
    border-bottom: var(--stroke-control) solid var(--action-primary);
    color: var(--text-primary);
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .media-item :global(.project-media) {
    width: 100%;
    border: var(--stroke-bar) solid var(--border-strong);
  }

  .media-full img.project-media {
    max-height: 600px;
    object-fit: cover;
  }

  @media (width <= 700px) {
    .media-full img.project-media {
      max-height: 300px;
    }
  }
  .media-full.uncropped img.project-media {
    height: auto;
    max-height: none;
  }
</style>
