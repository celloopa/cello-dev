---
interface MediaItem {
	src: string;
	alt?: string;
	caption?: string;
}

interface Props {
	items: MediaItem[];
}

const { items } = Astro.props;
const isVideo = (src: string) => src?.endsWith('.webm') || src?.endsWith('.mp4');
---

<div class="media-gallery media-three">
	{items.map((item, index) => (
		<figure class="media-item" style={`--i: ${index}`}>
			{isVideo(item.src) ? (
				<video src={item.src} class="project-media" autoplay loop muted playsinline />
			) : (
				<img src={item.src} alt={item.alt || ""} class="project-media" />
			)}
			{item.caption && <figcaption>{item.caption}</figcaption>}
		</figure>
	))}
</div>

<style>
	.media-gallery {
		margin: var(--space-32) 0;
		animation: enter-scale 0.7s var(--ease-out) backwards;
	}

	.media-three {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-16);
	}

	.media-item {
		margin: 0;
		animation: enter-rise 0.5s var(--ease-out) backwards;
		animation-delay: calc(var(--i) * 0.1s);
	}

	.media-item figcaption {
		font-size: var(--type-small);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--track-caps);
		color: var(--text-primary);
		padding: var(--space-12) 0;
		border-bottom: 2px solid var(--color-accent);
		margin: 0;
	}

	.project-media {
		width: 100%;
		border: 4px solid var(--text-primary);
		filter: grayscale(20%);
		transition: filter var(--motion-ui) ease;
		aspect-ratio: 16/10;
		object-fit: cover;
	}

	video.project-media {
		height: auto;
		aspect-ratio: auto;
	}

	.project-media:hover {
		filter: grayscale(0%);
	}

	@media (width <= 900px) {
		.media-three {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (width <= 700px) {
		.media-three {
			grid-template-columns: 1fr;
		}
	}
</style>
