---
/* MediaTwo: two images or videos side by side (one column on phones). Videos go through
   MediaVideo (Pause / Play, reduced motion keeps the still). */
import MediaVideo from "./MediaVideo.astro";

interface MediaItem {
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
const isVideo = (src: string) => src?.endsWith(".webm") || src?.endsWith(".mp4");
---

<div class="media-gallery media-two">
  {
    items.map((item) => (
      <figure class="media-item">
        {isVideo(item.src) ? (
          <MediaVideo src={item.src} label={item.alt} class="project-media" />
        ) : (
          <img src={item.src} alt={item.alt || ""} class="project-media" loading="lazy" decoding="async" />
        )}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .media-gallery {
    margin: var(--space-32) 0;
  }

  .media-two {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
  }

  .media-item {
    margin: 0;
  }

  .media-item figcaption {
    margin: 0;
    padding: var(--space-12) 0;
    border-bottom: var(--stroke-control) solid var(--action-primary);
    color: var(--text-primary);
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .media-item :global(.project-media) {
    width: 100%;
    border: var(--stroke-bar) solid var(--border-strong);
  }

  img.project-media {
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  @media (width <= 700px) {
    .media-two {
      grid-template-columns: 1fr;
    }
  }
</style>
