---
/*
 * FlowDiagram: a titled sequence of steps (label + detail), with an optional caption.
 * The figure is a plate (A1 bg-plate), so its labels and text never sit on scene art.
 */
interface FlowItem {
  label: string;
  detail: string;
}

interface Props {
  title: string;
  items: FlowItem[];
  caption?: string;
}

const { title, items, caption } = Astro.props;
---

<figure class="flow-diagram">
  <figcaption>{title}</figcaption>
  <ol>
    {
      items.map((item) => (
        <li>
          <strong>{item.label}</strong>
          <p>{item.detail}</p>
        </li>
      ))
    }
  </ol>
  {caption && <p class="caption">{caption}</p>}
</figure>

<style>
  .flow-diagram {
    margin: var(--space-32) 0;
    padding: var(--space-16);
    border: var(--stroke-frame) solid var(--border-strong);
    background: var(--bg-plate);
  }

  figcaption {
    margin-bottom: var(--space-16);
    color: var(--text-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--track-wide);
    line-height: var(--leading-title);
    text-transform: uppercase;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-height: 100%;
    padding: var(--space-12);
    border: var(--stroke-control) solid var(--border-muted);
    background: var(--bg-raised);
  }

  li::before {
    content: "";
    display: block;
    width: var(--space-40);
    height: var(--stroke-bar);
    margin-bottom: var(--space-12);
    background: var(--action-primary);
  }

  strong {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--type-ui);
    line-height: var(--leading-title);
    text-transform: uppercase;
  }

  p {
    margin: 0;
    padding: 0;
    font-size: var(--type-ui);
    line-height: var(--leading-small);
  }

  .caption {
    margin-top: var(--space-16);
    padding-top: var(--space-16);
    border-top: var(--stroke-rule) solid var(--border-muted);
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }
</style>
