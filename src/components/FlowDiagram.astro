---
/*
 * FlowDiagram: a titled sequence of steps (label + detail), with an optional caption.
 * The figure is a Labeled Panel (a plate, A1 bg-plate), so its labels and text never sit on
 * scene art.
 */
import AccentBar from "@/components/ui/AccentBar.astro";
import Panel from "@/components/ui/Panel.astro";

interface FlowItem {
  label: string;
  detail: string;
}

interface Props {
  title: string;
  items: FlowItem[];
  caption?: string;
}

const { title, items, caption } = Astro.props;
---

<Panel as="figure" label={title} labelAs="figcaption" class="flow-diagram">
  <ol>
    {
      items.map((item) => (
        <li>
          <AccentBar class="flow-bar" />
          <strong>{item.label}</strong>
          <p>{item.detail}</p>
        </li>
      ))
    }
  </ol>
  {caption && <p class="caption">{caption}</p>}
</Panel>

<style>
  .flow-diagram {
    margin: var(--space-32) 0;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-height: 100%;
    padding: var(--space-12);
    border: var(--stroke-control) solid var(--border-muted);
    background: var(--bg-raised);
  }

  .flow-bar {
    margin-bottom: var(--space-12);
  }

  strong {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--type-ui);
    line-height: var(--leading-title);
    text-transform: uppercase;
  }

  p {
    margin: 0;
    padding: 0;
    font-size: var(--type-ui);
    line-height: var(--leading-small);
  }

  .caption {
    margin-top: var(--space-16);
    padding-top: var(--space-16);
    border-top: var(--stroke-rule) solid var(--border-muted);
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }
</style>
