---
/*
 * ChapterHead: a chapter's eyebrow and h2 on the left, its intro on the right (one column on
 * phones). The intro slot takes extra inline content such as a CelloWords slot.
 */
interface Props {
  eyebrow: string;
  title: string;
  titleId: string;
}

const { eyebrow, title, titleId } = Astro.props;
---

<div class="ak-chapter-head">
  <div>
    <span class="ak-eyebrow">{eyebrow}</span>
    <h2 class="ak-chapter-title" id={titleId}>{title}</h2>
  </div>
  <p class="ak-chapter-intro"><slot /></p>
</div>
