---
/*
 * Costs as a rate card: what to pay for, run locally or skip, from the kit's source table. A
 * full mark is yes; a half mark is optional or later, and says which in the cell, with a legend
 * above. On phones the table scrolls inside its own labelled, focusable container.
 */
import ChapterHead from "./ChapterHead.astro";
import CelloWords from "./CelloWords.astro";

type Mark = "yes" | "optional" | "later" | null;
const rows: { item: string; note: string; pay: Mark; local: Mark; skip: Mark }[] = [
  { item: "Claude plan", note: "The one worth paying for. Parallel workers use a lot, so a higher tier keeps the pipeline from stalling.", pay: "yes", local: null, skip: null },
  { item: "Local models", note: "Private chores: summaries, transcription, AI features inside your apps. Not a replacement for Claude as the coder.", pay: null, local: "yes", skip: null },
  { item: "Images", note: "ComfyUI runs free on a decent GPU. A ChatGPT plan helps with text in images and adds Codex as a second coder.", pay: "optional", local: "yes", skip: null },
  { item: "Firecrawl, Mobbin", note: "Skip at first. Built-in web search and screenshots of apps you like cover personal projects.", pay: null, local: null, skip: "yes" },
  { item: "Hosting", note: "Your own computer or home server is free. Rent a small server only when apps must run while yours is off.", pay: "later", local: "yes", skip: null },
  { item: "App stores", note: "Not needed. Web apps install to phone home screens.", pay: null, local: null, skip: "yes" },
];
const cols = ["pay", "local", "skip"] as const;
---

<section class="ak-chapter ak-wrap" id="rate-card" data-chapter="rate-card" aria-labelledby="rate-title">
  <ChapterHead eyebrow="Costs" title="Rate card" titleId="rate-title">
    What to pay for and what to run locally. <CelloWords />
  </ChapterHead>

  <div class="ak-rate">
    <ul class="ak-legend" aria-label="Legend">
      <li><i class="ak-mark" aria-hidden="true"></i> Yes</li>
      <li><i class="ak-mark ak-mark--half" aria-hidden="true"></i> Optional or later (the cell says which)</li>
    </ul>
    <p class="ak-scroll-hint" aria-hidden="true">Scroll the card sideways →</p>
    <div class="ak-rate-scroll" tabindex="0" role="region" aria-label="Rate card (scrolls sideways on small screens)">
      <table class="ak-stub ak-rate-table">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col" class="ak-c">Pay</th>
            <th scope="col" class="ak-c">Local</th>
            <th scope="col" class="ak-c">Skip</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">
                  {r.item}
                  <span class="ak-rate-note">{r.note}</span>
                </th>
                {cols.map((c) => {
                  const m = r[c];
                  return (
                    <td class="ak-c">
                      {m === "yes" && (
                        <>
                          <i class="ak-mark" aria-hidden="true" />
                          <span class="ak-sr">Yes</span>
                        </>
                      )}
                      {(m === "optional" || m === "later") && (
                        <>
                          <i class="ak-mark ak-mark--half" aria-hidden="true" />
                          <span class="ak-mark-word">{m}</span>
                        </>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .ak-rate {
    margin-top: var(--space-48);
  }

  .ak-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: 0 0 var(--space-16);
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: var(--type-small);
  }

  .ak-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  .ak-legend .ak-mark {
    background: var(--text-primary);
  }

  .ak-legend .ak-mark--half {
    border-color: var(--text-primary);
    background: linear-gradient(135deg, var(--text-primary) 50%, transparent 50%);
  }

  .ak-scroll-hint {
    display: none;
    margin-bottom: var(--space-8);
    color: var(--text-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .ak-rate-scroll {
    overflow-x: auto;
  }

  .ak-rate-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-rate-table th,
  .ak-rate-table td {
    padding: var(--space-12) var(--space-16);
    border-bottom: var(--stroke-rule) solid var(--border-muted);
    text-align: left;
    vertical-align: top;
  }

  .ak-rate-table thead th {
    border-bottom: var(--stroke-control) solid var(--text-on-stub);
    font-size: var(--type-label);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .ak-rate-table .ak-c {
    width: 6rem;
    border-left: var(--stroke-rule) solid var(--border-muted);
    text-align: center;
  }

  .ak-rate-table tbody th {
    font-weight: var(--weight-bold);
  }

  .ak-rate-note {
    display: block;
    max-width: 60ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-weight: var(--weight-regular);
  }

  .ak-rate-table tr:last-child th,
  .ak-rate-table tr:last-child td {
    border-bottom: 0;
  }

  .ak-mark {
    display: inline-block;
    width: var(--space-16);
    height: var(--space-16);
    border: var(--stroke-control) solid var(--text-on-stub);
    background: var(--text-on-stub);
    vertical-align: middle;
  }

  .ak-mark--half {
    background: linear-gradient(135deg, var(--text-on-stub) 50%, transparent 50%);
  }

  .ak-mark-word {
    display: block;
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--type-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .ak-scroll-hint {
      display: block;
    }

    .ak-rate-table {
      min-width: 34rem;
    }

    .ak-rate-table th,
    .ak-rate-table td {
      padding: var(--space-12) var(--space-8);
    }

    .ak-rate-table .ak-c {
      width: 4.5rem;
    }
  }
</style>
