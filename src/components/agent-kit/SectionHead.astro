---
/*
 * SectionHead: a section's h2, an optional accent eyebrow above it and an optional intro, centered. The intro is
 * the default slot, so it can hold a link.
 */
import Eyebrow from "@/components/ui/Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  titleId: string;
}

const { eyebrow, title, titleId } = Astro.props;
---

<div class="ak-head">
  {eyebrow && <Eyebrow tone="accent">{eyebrow}</Eyebrow>}
  <h2 class="ak-title" id={titleId}>{title}</h2>
  {Astro.slots.has("default") && <p class="ak-intro"><slot /></p>}
</div>
