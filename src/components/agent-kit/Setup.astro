---
/*
 * Setup: the three prompts as panels, 01 marked "Start here". The text of each comes from its one
 * source file (src/lib/agent-kit/prompts.ts).
 */
import SectionHead from "./SectionHead.astro";
import PromptPanel from "./PromptPanel.astro";
import { prompts, promptText } from "@/lib/agent-kit/prompts";
---

<section class="ak-section ak-wrap" id="setup" aria-labelledby="setup-title">
  <SectionHead title="Read the whole prompt before you paste it" titleId="setup-title">
    Each panel shows its version, the date I last checked it against my setup and what changed.
    Show full prompt opens the rest.
  </SectionHead>
  <div class="ak-body ak-prompts">
    {prompts.map((p, i) => <PromptPanel prompt={p} text={promptText(p.file)} start={i === 0} />)}
  </div>
</section>

<style>
  .ak-prompts {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
</style>
