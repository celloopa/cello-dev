---
/*
 * Lessons from running the kit (from the source page), and its caveat.
 */
import SectionHead from "./SectionHead.astro";

const lessons = [
  { title: "Get grilled before anything is built", body: "The most useful step is the agent asking you hard questions about the idea first. It saves rebuilding later." },
  { title: "Hooks for reliability, AI for writing", body: "If logging depends on an agent remembering, sessions get missed. A hook runs every time." },
  { title: "Approve before it's permanent", body: "Automated notes go somewhere private first. Otherwise the brain fills up with confident, half-right summaries." },
  { title: "One role ships, after review", body: "One role ships and everyone else builds. That stops agents from overwriting each other's work." },
  { title: "Prove the checker works", body: "Plant one deliberate bug. Trust the evaluator's passes once it has caught it." },
  { title: "Start small", body: "Prompt 01 plus a week of capturing gets you most of the benefit. Add the studio when you have an app to build." },
];
---

<section class="ak-section ak-wrap" id="lessons" aria-labelledby="lessons-title">
  <SectionHead eyebrow="Lessons" title="What I learned running it" titleId="lessons-title">
    Tool names and install steps change, so the prompts tell your agent to read each tool's README
    instead of trusting its memory.
  </SectionHead>

  <ol class="ak-body ak-lessons">
    {
      lessons.map((l, i) => (
        <li class="ak-lesson">
          <span class="ak-lesson-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="ak-lesson-title">{l.title}</h3>
          <p>{l.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ak-lessons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-40) var(--space-32);
    padding: 0;
    list-style: none;
  }

  .ak-lesson {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-16);
    border-top: var(--stroke-control) solid var(--accent-ground);
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-lesson-no {
    color: var(--text-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
  }

  .ak-lesson-title {
    font-family: var(--font-mono);
    font-size: var(--type-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-title);
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .ak-lessons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .ak-lessons {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
  }
</style>
