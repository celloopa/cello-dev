---
/*
 * Lessons from running the kit: each card says what happens, from the runs behind this page.
 */
import SectionHead from "./SectionHead.astro";

const lessons = [
  {
    title: "Let the agent grill you first",
    body: "Before this page had a layout, the agent asked me five questions, one at a time: the name and web address, the navigation, which stories, the downloads and the hands-on moment. Each answer went into the plan before a single ticket existed.",
  },
  {
    title: "A hook logs every session",
    body: "If logging depends on the agent remembering, sessions get missed. A hook fires every time a session ends, and the AI does only the part a script can't: writing the recap.",
  },
  {
    title: "You decide each morning what the brain keeps",
    body: "Recaps and the nightly digest land in a private folder that Git ignores. Nothing joins the brain until you approve it the next morning, so half-right summaries stay out.",
  },
  {
    title: "Only the shipper touches main",
    body: "Workers build on their own branches, and the lead merges them into a plan branch. The shipper moves main to the exact commit that was previewed, after a pass and my go.",
  },
  {
    title: "Trust the evaluator after it catches a bug you planted",
    body: "Break one thing on purpose, on a throwaway branch, and wait for the evaluator to send it back. The second story above is mine.",
  },
  {
    title: "Start with prompt 01 and a week of notes",
    body: "Run prompt 01 and use it for a week before adding anything. Prompts 02 and 03 build on that folder, and the studio is for when you have an app to build.",
  },
  {
    title: "The agent reads each tool's README first",
    body: "Tool names and install steps change, so prompt 03 tells your agent to read each tool's README instead of trusting what it remembers.",
  },
];
---

<section class="ak-section ak-wrap" id="lessons" aria-labelledby="lessons-title">
  <SectionHead eyebrow="Lessons" title="Where agents slip, and the check for each" titleId="lessons-title" />

  <ol class="ak-body ak-lessons">
    {
      lessons.map((l, i) => (
        <li class="ak-lesson">
          <span class="ak-lesson-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="ak-lesson-title">{l.title}</h3>
          <p>{l.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ak-lessons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-40) var(--space-32);
    padding: 0;
    list-style: none;
  }

  .ak-lesson {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-16);
    border-top: var(--stroke-control) solid var(--accent-ground);
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-lesson-no {
    color: var(--text-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
  }

  .ak-lesson-title {
    font-family: var(--font-mono);
    font-size: var(--type-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-title);
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .ak-lessons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .ak-lessons {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
  }
</style>
