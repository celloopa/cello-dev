---
/*
 * 04 · Proof: two ship stories as drawing sheets, with direction A's blueprint annotations (A, B,
 * C) hanging from leader lines. Each sheet reads trigger → what got done → outcome (the shape of
 * Runner's "workflow snapshot", from the Mobbin pass), with the marks of the rules it shows. The
 * facts are assembled from the real runs; the take under each is Cello's to write.
 */
import ChapterHead from "./ChapterHead.astro";
import CelloWords from "./CelloWords.astro";
import { eyebrowOf } from "./stops";

type Step = { text: string; mark?: "A" | "B" | "C" };
const stories: { id: string; sheet: string; title: string; trigger: string; done: Step[]; outcome: string }[] = [
  {
    id: "story-ghosted",
    sheet: "Sheet 1 of 2",
    title: "Ghosted's feature pipeline",
    trigger: "Ghosted, my AI resume editor, opened for early testing on October 8, 2026, and testers set the order of work from day one.",
    done: [
      { text: "Bigger features went through research, a grilling one question at a time, and a decision written down before any code." },
      { text: "Tickets carried acceptance criteria, and anything visible passed a design-system gate first.", mark: "A" },
      { text: "Layouts were picked from screens, not prose: the feedback flow had six prototypes, and I picked “B + 2”." },
      { text: "Only one shipping session merged, after its review and my go.", mark: "C" },
      { text: "On day four the process was written down as nine steps, each naming the feature it came from." },
    ],
    outcome: "70 production releases in the first four days of testing.",
  },
  {
    id: "story-page",
    sheet: "Sheet 2 of 2",
    title: "This page, built by the kit",
    trigger: "A draft page with three setup prompts, to become a section of this site.",
    done: [
      { text: "Five questions first, one at a time: name and web address, navigation, which stories, downloads, the hands-on moment." },
      { text: "A plan in the second brain with eight tickets, each with testable criteria.", mark: "A" },
      { text: "Three looks to choose from, then a persona test of the pick before anything was built." },
      { text: "The lead started a worker per ticket, each on its own branch. A separate evaluator, which never saw their reasoning, checked each one in a real browser at phone and desktop sizes." },
      { text: "I planted one bug: the second Copy button copied the first prompt. The evaluator sent it back for exactly that.", mark: "B" },
    ],
    outcome: "Lighthouse accessibility 100 on phone and desktop, 3.4 kB of page script, shipped after review and my go.",
  },
];

const notes = [
  { mark: "A", text: "Every ticket gets 2–5 testable acceptance criteria before a worker starts." },
  { mark: "B", text: "The evaluator never sees the worker's reasoning. An agent grading its own work usually passes itself." },
  { mark: "C", text: "Nothing reaches main without a PASS on that exact commit." },
];
---

<section class="ak-chapter ak-wrap" id="proof" data-chapter="proof" aria-labelledby="proof-title">
  <ChapterHead eyebrow={eyebrowOf("proof")} title="Two things it shipped" titleId="proof-title">
    Two ship stories from real runs of the pipeline. The letters mark where each rule shows up.
  </ChapterHead>

  <div class="ak-proof">
    <div class="ak-sheets">
      {
        stories.map((s) => (
          <article class="ak-sheet" aria-labelledby={s.id}>
            <span class="ak-sheet-no">{s.sheet}</span>
            <h3 class="ak-sheet-title" id={s.id}>{s.title}</h3>
            <dl class="ak-sheet-rows">
              <div class="ak-sheet-row">
                <dt>Trigger</dt>
                <dd>{s.trigger}</dd>
              </div>
              <div class="ak-sheet-row">
                <dt>What got done</dt>
                <dd>
                  <ul class="ak-sheet-done">
                    {s.done.map((d) => (
                      <li>
                        {d.text}
                        {d.mark && (
                          <span class="ak-sheet-mark">
                            <span class="ak-sr">Rule </span>
                            {d.mark}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div class="ak-sheet-row ak-sheet-row--outcome">
                <dt>Outcome</dt>
                <dd>{s.outcome}</dd>
              </div>
            </dl>
            <p class="ak-sheet-take"><CelloWords /></p>
          </article>
        ))
      }
    </div>
    <ol class="ak-annotations" aria-label="Rules marked in both stories">
      {
        notes.map((n) => (
          <li class="ak-annotation">
            <p><b>{n.mark}</b> {n.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ak-proof {
    margin-top: var(--space-48);
  }

  .ak-sheets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-32);
  }

  .ak-sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-height: 16rem;
    padding: var(--space-24);
    border: var(--stroke-frame) solid var(--border-strong);
    background: var(--bg-plate);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-ground);
  }

  .ak-sheet-no {
    color: var(--text-muted);
    font-size: var(--type-label);
    letter-spacing: var(--track-wide);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  .ak-sheet-title {
    text-wrap: balance;
    color: var(--text-primary);
    font-family: var(--font-title);
    font-size: var(--type-heading);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-heading);
    text-transform: uppercase;
  }

  .ak-sheet-rows {
    display: flex;
    flex-direction: column;
    margin: var(--space-8) 0 0;
  }

  .ak-sheet-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-12);
    border-top: var(--stroke-rule) solid var(--border-subtle);
  }

  .ak-sheet-row dt {
    color: var(--text-muted);
    font-size: var(--type-label);
    letter-spacing: var(--track-wide);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  .ak-sheet-row dd {
    margin: 0;
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-sheet-row--outcome dd {
    color: var(--text-primary);
    font-weight: var(--weight-bold);
  }

  .ak-sheet-done {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding-left: var(--space-16);
  }

  .ak-sheet-mark {
    display: inline-grid;
    place-items: center;
    min-width: var(--space-20);
    height: var(--space-20);
    margin-left: var(--space-8);
    border: var(--stroke-rule) solid var(--accent-construction);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    vertical-align: text-bottom;
  }

  .ak-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ak-sheet-take {
    margin-top: auto;
  }

  /* blueprint annotations: a leader line up to the sheets, the note on a plate */
  .ak-annotations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-32);
    margin: var(--space-48) 0 0;
    padding: 0;
    list-style: none;
  }

  .ak-annotation {
    position: relative;
    padding-top: var(--space-24);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-annotation::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-16);
    width: var(--stroke-rule);
    height: var(--space-24);
    background: var(--accent-construction);
    transform: translateY(-100%) scaleY(2);
    transform-origin: bottom;
  }

  .ak-annotation::after {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-12);
    width: var(--space-8);
    height: var(--space-8);
    border: var(--stroke-rule) solid var(--accent-construction);
    border-radius: var(--radius-circle);
    transform: translate(0, -50%);
  }

  .ak-annotation p {
    padding: var(--space-8) var(--space-12);
    border-left: var(--stroke-control) solid var(--accent-construction);
    background: var(--bg-plate);
  }

  .ak-annotation b {
    display: inline-grid;
    place-items: center;
    width: var(--space-24);
    height: var(--space-24);
    margin-right: var(--space-8);
    border: var(--stroke-control) solid var(--border-strong);
    font-weight: var(--weight-bold);
  }

  @media (max-width: 768px) {
    .ak-sheets,
    .ak-annotations {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }

    .ak-annotations {
      margin-top: var(--space-40);
    }

    /* stacked: the leader stays inside the gap above its note, never over the note before */
    .ak-annotation::before {
      transform: translateY(-100%);
    }
  }
</style>
