---
/*
 * Proof: the result row (this page's own numbers) and two ship stories in the card styling, each
 * in the shape its material has: Ghosted as a dated timeline, this page as a short story. The
 * facts come from the real runs (Brain projects/agent-kit.md).
 */
import SectionHead from "./SectionHead.astro";

const timeline = [
  {
    when: "October 8, 2026",
    text: "Ghosted, my AI resume editor, opens for early testing. From day one, testers set the order of work.",
  },
  {
    when: "Days one to three",
    text: "Every bigger feature goes through research, then a grilling one question at a time, then a decision written down before any code. Each ticket carries acceptance criteria, and anything visible passes a design-system gate first. The feedback flow gets six prototypes, and I pick “B + 2”. One shipping session does all the merging, after review and my go.",
  },
  {
    when: "Day four",
    text: "I ask for the process to be written down so the next feature can follow it. It comes out as nine steps, each naming the feature it came from.",
  },
];

const page = [
  "The second Copy button on this page once copied the first prompt. I had the lead put that bug there, on a throwaway branch, before trusting the evaluator with anything real. The evaluator sees only a ticket's acceptance criteria and a running preview, never the worker's reasoning. It sent the ticket back for exactly that button and passed everything else.",
  "The second send-back was real. On the redesign, the evaluator returned the copy: two understatements, a stat that contradicted the hero, and a privacy answer in the FAQ that promised more than the prompts do. Round two passed.",
  "The page shipped after that and my go.",
];

const stats = [
  { value: "100", label: "Lighthouse accessibility (this page, phone and desktop)" },
  { value: "3.4 kB", label: "of page script (this page)" },
  { value: "2", label: "send-backs before ship, 1 of them planted (this page)" },
];
---

<section class="ak-section ak-wrap" id="proof" aria-labelledby="proof-title">
  <SectionHead eyebrow="Ghosted, October 2026" title="70 production releases in four days" titleId="proof-title">
    That was Ghosted's first four days of early testing, run through this pipeline.
  </SectionHead>

  <dl class="ak-body ak-stats">
    {
      stats.map((s) => (
        <div class="ak-stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="ak-stories">
    <article class="ak-panel ak-story" aria-labelledby="story-ghosted">
      <span class="ak-meta">Story 1 of 2</span>
      <h3 class="ak-story-title" id="story-ghosted">Ghosted's process got written down on day four, after it worked</h3>
      <ol class="ak-timeline">
        {
          timeline.map((t) => (
            <li>
              <span class="ak-timeline-when">{t.when}</span>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ol>
    </article>
    <article class="ak-panel ak-story" aria-labelledby="story-page">
      <span class="ak-meta">Story 2 of 2</span>
      <h3 class="ak-story-title" id="story-page">The evaluator sent this page back twice. I'd planted one of them.</h3>
      <div class="ak-story-text">
        {page.map((para) => <p>{para}</p>)}
      </div>
    </article>
  </div>
</section>

<style>
  .ak-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-inline: 0;
    border-block: var(--stroke-rule) solid var(--border-muted);
  }

  .ak-stat {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-24) var(--space-16);
    text-align: center;
  }

  .ak-stat + .ak-stat {
    border-left: var(--stroke-rule) solid var(--border-muted);
  }

  .ak-stat dt {
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-stat dd {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--type-section-title);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
  }

  .ak-stories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-24);
    margin-top: var(--space-48);
  }

  .ak-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-24);
  }

  .ak-story-title {
    font-family: var(--font-title);
    font-size: var(--type-heading);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  /* story 1: a dated timeline, each date on a rule with the step under it */
  .ak-timeline {
    display: flex;
    flex-direction: column;
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .ak-timeline li {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-12);
    border-top: var(--stroke-rule) solid var(--border-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-timeline-when {
    color: var(--text-accent);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  /* story 2: plain paragraphs, read as one short story */
  .ak-story-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-8);
    padding-top: var(--space-12);
    border-top: var(--stroke-rule) solid var(--border-muted);
    font-size: var(--type-small);
    line-height: var(--leading-read);
  }

  @media (max-width: 768px) {
    .ak-stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .ak-stat {
      flex-direction: row-reverse;
      justify-content: flex-end;
      gap: var(--space-16);
      padding: var(--space-12) 0;
      text-align: left;
    }

    .ak-stat + .ak-stat {
      border-top: var(--stroke-rule) solid var(--border-muted);
      border-left: 0;
    }

    .ak-stat dd {
      min-width: 3ch;
      font-size: var(--type-heading);
    }

    .ak-stories {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-16);
      margin-top: var(--space-32);
    }

    .ak-story {
      padding: var(--space-16);
    }
  }
</style>
