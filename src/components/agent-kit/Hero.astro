---
/*
 * Hero: centered. Who it's by, a two-line headline on what the reader gets (AK-11), the studio in one sentence, one primary
 * action (prompt 01, in Setup) and a quiet link down to the studio demo.
 */
import Button from "@/components/ui/Button.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
---

<section class="ak-hero ak-wrap" id="top" aria-labelledby="ak-h1">
  <Eyebrow tone="accent">Agent Studio Kit · by Cello</Eyebrow>
  <!-- AK-11 A/B: a 50/50 headline per browser (local storage "ak-hero"); ?hero=a|b previews one without saving.
       Without script, A shows. Runs before the headline paints, and again on each ClientRouter swap. -->
  <script is:inline>
    (() => {
      const s = document.currentScript && document.currentScript.parentElement;
      let v = new URLSearchParams(location.search).get("hero");
      if (v !== "a" && v !== "b") {
        try {
          v = localStorage.getItem("ak-hero");
          if (v !== "a" && v !== "b") {
            v = Math.random() < 0.5 ? "a" : "b";
            localStorage.setItem("ak-hero", v);
          }
        } catch {
          v = Math.random() < 0.5 ? "a" : "b";
        }
      }
      if (s) s.dataset.hero = v;
    })();
  </script>
  <h1 class="ak-h1" id="ak-h1">
    <span class="ak-h1-a">
      <span>Hand off a ticket, go get pizza,</span>
      <span>come back to a checked build</span>
    </span>
    <span class="ak-h1-b">
      <span>A full software team in your hand,</span>
      <span>and nothing ships until you say so</span>
    </span>
  </h1>
  <p class="ak-lede">
    A lead plans, a worker builds, an evaluator sends back what fails, and a shipper waits for your go.
  </p>
  <div class="ak-hero-actions">
    <Button href="#setup" data-cta="ak-hero-setup">Get prompt 01</Button>
    <ArrowLink href="#studio" variant="down" data-cta="ak-hero-studio">Watch a ticket run</ArrowLink>
  </div>
  <p class="ak-meta ak-hero-meta">Three prompts for Claude Code · Plain Markdown</p>
</section>

<style>
  .ak-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--space-96) var(--space-32);
    text-align: center;
  }

  .ak-h1 {
    max-width: 24ch;
    text-align: center;
    margin-top: var(--space-24);
    font-family: var(--font-title);
    font-size: var(--type-page-title);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    text-wrap: balance;
  }

  .ak-h1 span {
    display: block;
  }

  .ak-h1 .ak-h1-b,
  .ak-hero[data-hero="b"] .ak-h1-a {
    display: none;
  }

  .ak-hero[data-hero="b"] .ak-h1-b {
    display: block;
  }

  .ak-lede {
    max-width: 40rem;
    text-align: center;
    margin-top: var(--space-24);
    color: var(--text-muted);
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
    text-wrap: pretty;
  }

  .ak-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-32);
    align-items: center;
    justify-content: center;
    margin-top: var(--space-40);
  }

  .ak-hero-meta {
    margin-top: var(--space-32);
    text-align: center;
  }

  @media (max-width: 768px) {
    .ak-hero {
      padding-block: var(--space-40) var(--space-8);
    }

    .ak-h1 span,
    .ak-hero[data-hero="b"] .ak-h1-b {
      display: inline;
    }

    .ak-h1 .ak-h1-b,
    .ak-hero[data-hero="b"] .ak-h1-a {
      display: none;
    }
  }
</style>
