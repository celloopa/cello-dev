---
/*
 * Hero: the title, what the kit is, the way in (prompt 01), a one-line proof teaser, and the
 * chapter index as five paper stubs hanging from the earth rail. The stubs are the in-page
 * chapter nav: real links, all five visible on a phone (they wrap, no sideways swipe). They come
 * from the one list of stops (stops.ts); the scroll story marks the current one aria-current=step.
 */
import Button from "@/components/ui/Button.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import CelloWords from "./CelloWords.astro";
import { stops } from "./stops";

---

<section class="ak-hero ak-wrap" id="hero" data-chapter="hero" aria-labelledby="ak-title">
  <p class="ak-crumb"><a href="/">cello.design</a> <span aria-hidden="true">/</span> agent-kit</p>
  <div class="ak-hero-top">
    <div>
      <span class="ak-eyebrow">Work order · a starter kit for Claude Code</span>
      <h1 class="ak-title" id="ak-title">Agent Studio Kit</h1>
    </div>
    <div class="ak-hero-copy">
      <p class="ak-lede">
        How I run AI agents like a small software studio: one folder of notes they all read, a note
        on every session, and a lead, evaluator and shipper on each project, with a worker for each
        ticket. Three prompts set it up on your computer.
      </p>
      <CelloWords />
      <div class="ak-hero-actions">
        <Button href="#setup">Start with prompt 01 →</Button>
      </div>
      <p class="ak-teaser">
        Two things it built: Ghosted's feature pipeline, and this page.
        <ArrowLink href="#proof" variant="down">See the proof</ArrowLink>
      </p>
    </div>
  </div>

  <nav class="ak-index" aria-label="Chapters">
    <div class="ak-rail" aria-hidden="true"></div>
    <ol class="ak-index-list">
      {
        stops.map((c) => (
          <li class="ak-hooked">
            <a class="ak-index-link" href={`#${c.id}`} data-stop-link={c.id}>
              <span class="ak-stub ak-stub--hole ak-index-stub">
                <span class="ak-index-no">No. {c.no}</span>
                <span class="ak-index-name">{c.name}</span>
                <span class="ak-index-note">{c.note}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .ak-hero {
    padding-block: var(--space-32) var(--space-64);
  }

  .ak-crumb {
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .ak-crumb a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--text-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--stroke-control);
    text-underline-offset: var(--space-4);
  }

  .ak-crumb a:hover {
    color: var(--text-primary);
  }

  .ak-hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: var(--space-48);
    align-items: end;
    margin-top: var(--space-32);
  }

  .ak-title {
    margin-top: var(--space-16);
    color: var(--text-primary);
    font-family: var(--font-title);
    font-size: var(--type-display-hero);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-display);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ak-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .ak-lede {
    font-size: var(--type-body-lg);
    line-height: var(--leading-read);
  }

  .ak-teaser {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-16);
    align-items: center;
    padding-top: var(--space-16);
    border-top: var(--stroke-rule) solid var(--border-muted);
    color: var(--text-muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .ak-index {
    margin-top: var(--space-48);
  }

  .ak-index-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-16);
    margin: 0;
    padding: 0 var(--space-16);
    list-style: none;
  }

  .ak-index-link {
    display: block;
    color: var(--text-on-stub);
    text-decoration: none;
  }

  .ak-index-stub {
    display: flex;
    flex-direction: column;
    min-height: 9.5rem;
    padding: var(--space-40) var(--space-16) var(--space-16);
    transition: box-shadow var(--motion-ui) var(--ease-out);
  }

  .ak-index-link:hover .ak-index-stub,
  .ak-index-link:focus-visible .ak-index-stub,
  .ak-index-link[aria-current="step"] .ak-index-stub {
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--action-primary);
  }

  .ak-index-no,
  .ak-index-note {
    color: var(--text-muted);
    font-size: var(--type-label);
    letter-spacing: var(--track-wide);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  .ak-index-name {
    margin-top: var(--space-4);
    font-family: var(--font-title);
    font-size: var(--type-title);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .ak-index-note {
    margin-top: auto;
    padding-top: var(--space-12);
    text-transform: none;
    letter-spacing: var(--track-caps);
  }

  @media (max-width: 768px) {
    .ak-hero-top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
      margin-top: var(--space-16);
    }

    /* phones: all five stay in view, three and two, no sideways swipe */
    .ak-index-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-12);
      padding: 0;
    }

    .ak-index-stub {
      min-height: 7rem;
      padding: var(--space-32) var(--space-8) var(--space-12);
    }

    .ak-index-name {
      font-size: var(--type-body);
    }
  }
</style>
