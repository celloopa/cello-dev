---
import { education } from "@cv";
---

<ul>
  {
    education.map(({ institution, startDate, endDate, area, minorType }) => {
      const startYear = startDate.slice(0, 4);
      const endYear = endDate != null ? endDate.slice(0, 4) : "Present";
      const isSameYear = startYear === endYear;
      const years = isSameYear ? startYear : `${startYear} - ${endYear}`;

      return (
        <li>
          <article>
            <header>
              <div class="edu-info">
                <h3>{institution}</h3>
                <h4>{area}</h4>
              </div>
              <time>{years}</time>
            </header>
            {minorType && (
              <footer>
                <p>{minorType}</p>
              </footer>
            )}
          </article>
        </li>
      );
    })
  }
</ul>
<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin: var(--space-16) 0 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: var(--space-16);
    border-top: 2px solid rgba(var(--color-accent-rgb), 0.5);
  }

  li:first-child {
    padding-top: 0;
    border-top: none;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .edu-info {
    flex: 1;
  }

  article h3 {
    font-size: var(--type-body-lg);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-heading);
    margin: 0;
    padding: 0;
  }

  article h4 {
    font-size: var(--type-ui);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    margin: var(--space-4) 0 0 0;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }

  article p {
    font-weight: var(--weight-regular);
    font-size: var(--type-small);
    margin: var(--space-8) 0 0 0;
    padding: 0;
    opacity: 0.85;
  }

  footer {
    margin-top: var(--space-8);
  }

  time {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: var(--weight-black);
    white-space: nowrap;
    padding: var(--space-4) var(--space-8);
    border: 2px solid var(--color-accent);
    line-height: var(--leading-tight);
  }

  @media (width <= 700px) {
    header {
      flex-direction: column;
      gap: var(--space-4);
    }

    .edu-info {
      width: 100%;
    }

    article h3,
    article h4 {
      text-align: center !important;
    }

    time {
      font-size: var(--type-label);
      display: inline-flex;
      width: 100%;
    }
  }
</style>
