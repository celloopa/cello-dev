---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import "@/styles/colors.css";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import Sun from "@/icons/Sun.astro";
import type { SocialIcon } from "@/types";
import Bsky from "@/icons/Bsky.astro";

const { name, label, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
	GitHub,
	LinkedIn,
	Bsky,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
	<div class="container">
		<div class="info">
			<h1>{name}</h1>
			<h2>{label}</h2>
			<span>
				<WorldMap />
				{city}, {region}
				<WorldMap />
			</span>
			<footer class="print">
				{printInfo}
			</footer>
			<footer class="no-print">
				{
					email && (
						<a
							href={`mailto:${email}`}
							title={`Send an email to ${name} at ${email}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Mail />
						</a>
					)
				}
				{
					phone && (
						<a
							href={`tel:${phone}`}
							title={`Call ${name} at ${phone}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Phone />
						</a>
					)
				}
				{
					profiles.map(
						({
							network,
							url,
							username,
						}) => {
							const Icon =
								SOCIAL_ICONS[
									network
								];

							return (
								<a
									href={
										url
									}
									title={`Visit ${name}'s profile in ${network} at ${username}`}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon />
								</a>
							);
						},
					)
				}
				<button type="button" data-theme-toggle aria-label="Switch between Day and Dusk"><Sun /></button>
			</footer>
		</div>
		<figure class="image-frame">
			<img src="/images/profile.webp" alt={name} />
		</figure>
	</div>
</Section>

<style>
	.container {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-32);
	}

	.info {
		display: flex;
		flex-direction: column;
		align-items: left;
		padding-right: 32px;
	}

	.info h1 {
		font-size: clamp(2rem, 6vw, 3rem);
		margin: 0;
	}

	.info h2 {
		font-family: var(--font-mono); /* A label, not a title: stays Geist Mono (I4). */
		font-size: clamp(0.9rem, 2.5vw, 1.1rem);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--track-caps);
		color: var(--color-accent);
		text-wrap: balance;
		margin-top: var(--space-8);
	}

	.image-frame {
		position: relative;
		border: 3px solid var(--text-primary);
		margin: 0;
	}

	.image-frame::before {
		content: "";
		position: absolute;
		top: 8px;
		left: 8px;
		right: -8px;
		bottom: -8px;
		border: 3px solid var(--color-accent);
		z-index: -1;
	}

	img {
		aspect-ratio: 1 / 1;
		object-fit: cover;
		width: 240px;
		display: block;
		filter: grayscale(30%);
		transition: filter var(--motion-ui) var(--ease-out);
	}

	.image-frame:hover img {
		filter: grayscale(0%);
	}

	span,
	p {
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-size: var(--type-ui);
		letter-spacing: -0.05rem;
	}

	button {
		background: var(--bg-canvas);
		color: var(--text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--text-primary);
		padding: 0;
		height: 36px;
		width: 36px;
		cursor: pointer;
		transition: all var(--motion-ui) var(--ease-out);
	}

	button:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--bg-canvas);
	}

	footer {
		color: var(--color-accent);
		font-size: var(--type-label);
		display: flex;
		gap: var(--space-8);
		margin-top: var(--space-12);
	}

	footer a {
		color: var(--text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--text-primary);
		padding: 0;
		height: 36px;
		width: 36px;
		transition: all var(--motion-ui) var(--ease-out);
	}

	footer a:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--bg-canvas);
	}

	@media (width <= 700px) {
		.container {
			flex-direction: column-reverse;
			padding-top: 0;
			margin-top: -0.4rem;
		}

		.info {
			justify-content: center;
			padding-right: 0;
			align-items: center;
			text-align: center;
		}

		.image-frame {
			display: block;
			margin: 0 auto;
		}

		h2 {
			text-wrap: balance;
		}
	}
</style>
