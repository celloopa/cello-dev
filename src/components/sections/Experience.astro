---
import { work } from "@cv";
import "@/styles/colors.css";
---

<ul>
  {
    work.map(
      ({ name, startDate, endDate, position, summary, highlights, url }) => {
        const startYear = startDate.slice(0, 4);
        const endYear = endDate ? endDate.slice(0, 4) : "Present";
        const isSameYear = startYear === endYear;

        return (
          <li>
            <article>
              <header>
                <div class="job-info">
                  <h3>
                    {url ? (
                      <a href={url} title={`View ${name}`} target="_blank">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <h4>{position}</h4>
                </div>
                <time class="date-range">
                  {isSameYear ? startYear : `${startYear} - ${endYear}`}
                </time>
              </header>
              <footer>
                <h5>{summary}</h5>
                <ul class="highlights">
                  {highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </footer>
            </article>
          </li>
        );
      },
    )
  }
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin: var(--space-16) 0 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: var(--space-16);
    border-top: 2px solid rgba(var(--color-accent-rgb), 0.5);
  }

  li:first-child {
    padding-top: 0;
    border-top: none;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .job-info {
    flex: 1;
    margin: 0;
  }

  article h3 {
    font-size: var(--type-body-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    margin: 0;
    padding: 0;
  }

  article a {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  article a:hover {
    color: var(--color-accent);
  }

  article h4 {
    font-size: var(--type-ui);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    margin: var(--space-4) 0 0 0;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }

  article h5 {
    font-weight: var(--weight-medium);
    font-size: var(--type-ui);
    color: var(--text-primary);
    margin: var(--space-12) 0 var(--space-8) 0;
    padding: 0;
    line-height: 1.5;
  }

  article p {
    font-weight: var(--weight-regular);
    font-size: var(--type-small);
    line-height: 1.6;
    margin: var(--space-4) 0;
    padding: 0;
    opacity: 0.85;
  }

  footer {
    margin-top: var(--space-8);
  }

  footer > div {
    margin-top: var(--space-8);
  }

  .date-range {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: var(--weight-black);
    white-space: nowrap;
    padding: var(--space-4) var(--space-8);
    margin: 0;
    border: 2px solid var(--color-accent);
    line-height: var(--leading-tight);
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: var(--space-8) 0 0 0;
  }

  .highlights li {
    position: relative;
    padding: 0 0 0 1.35rem;
    border: none;
    font-size: var(--type-small);
    line-height: 1.6;
    opacity: 0.85;
  }

  .highlights li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  @media (width <= 700px) {
    header {
      flex-direction: column;
      gap: var(--space-4);
    }

    .job-info {
      width: 100%;
    }

    article h3,
    article h4 {
      text-align: center !important;
    }

    .date-range {
      font-size: var(--type-label);
      display: inline-flex;
      width: 100%;
    }
  }
</style>
