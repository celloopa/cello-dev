---
import { skills } from "@cv";
import "@/styles/colors.css";
import AdobeAe from "@/icons/adobe_ae.astro";
import AdobeIl from "@/icons/adobe_il.astro";
import AdobeIndd from "@/icons/adobe_indd.astro";
import AdobePr from "@/icons/adobe_pr.astro";
import AdobePs from "@/icons/adobe_ps.astro";
import AdobeXd from "@/icons/adobe_xd.astro";
import Astro from "@/icons/astro.astro";
import HTML from "@/icons/html.astro";
import CSS from "@/icons/css.astro";
import Figma from "@/icons/figma.astro";
import JavaScript from "@/icons/javascript.astro";
import TypeScript from "@/icons/typescript.astro";
import React from "@/icons/react.astro";
import MySQL from "@/icons/sql.astro";
import Go from "@/icons/go.astro";
import Git from "@/icons/git.astro";
import GitHub from "@/icons/GitHub.astro";
import Php from "@/icons/php.astro";
import Python from "@/icons/python.astro";
import Tailwind from "@/icons/tailwind.astro";

const SKILLS_ICONS: Record<string, any> = {
  "Adobe After Effects": AdobeAe,
  "Adobe Illustrator": AdobeIl,
  "Adobe InDesign": AdobeIndd,
  "Adobe Premiere": AdobePr,
  "Adobe Photoshop": AdobePs,
  "Adobe XD": AdobeXd,
  Astro,
  HTML,
  CSS,
  Figma,
  JavaScript,
  TypeScript,
  React,
  MySQL,
  Go,
  Git,
  GitHub,
  PHP: Php,
  Python,
  Tailwind,
};

const getIconName = (name: string) => {
  switch (name) {
    case "Photoshop":
      return "Adobe Photoshop";
    case "Illustrator":
      return "Adobe Illustrator";
    case "After Effects":
      return "Adobe After Effects";
    case "InDesign":
      return "Adobe InDesign";
    case "Premiere":
      return "Adobe Premiere";
    case "XD":
      return "Adobe XD";
    default:
      return name;
  }
};
---

<ul>
  {
    skills.map(({ name }, i) => {
      const iconName = getIconName(name);
      const Icon = SKILLS_ICONS[iconName];

      return (
        <li style={`--i: ${i}`}>
          {Icon && <Icon />}
          <span>{name}</span>
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin: var(--space-16) 0 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--type-small);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--text-primary);
    background: transparent;
    border: 3px solid var(--text-primary);
    padding: var(--space-8) var(--space-12);
    cursor: default;
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
    animation: skillSlideUp var(--motion-entry) var(--ease-out) backwards;
    animation-delay: calc(var(--i) * var(--motion-stagger-dense));
  }

  li:hover {
    background: var(--text-primary);
    color: var(--bg-canvas);
    transform: translateY(-2px);
  }

  li :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform var(--motion-ui) var(--ease-out);
  }

  li:hover :global(svg) {
    transform: scale(1.1);
  }

  span {
    font-size: var(--type-small);
    padding: 0;
    margin: 0;
    line-height: var(--leading-tight);
  }

  @media (width <= 700px) {
    ul {
      justify-content: center;
    }

    li {
      font-size: var(--type-label);
      padding: var(--space-4) var(--space-8);
    }

    li :global(svg) {
      width: 14px;
      height: 14px;
    }

    span {
      font-size: var(--type-label);
    }
  }
</style>
