---
/*
 * CaseMeta: a case study's opening facts (problem, role, decision, result) as Labeled Panels.
 * Each Panel is a plate (A1 bg-plate): opaque, so its labels and text never sit on scene art.
 */
import Panel from "@/components/ui/Panel.astro";

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

<aside class="case-meta" aria-label="Case study summary">
  {
    items.map((item) => (
      <Panel label={item.label}>
        <p>{item.value}</p>
      </Panel>
    ))
  }
</aside>

<style>
  .case-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-12);
    margin: var(--space-32) 0;
  }

  p {
    margin: 0;
    padding: 0;
    font-size: var(--type-ui);
    line-height: var(--leading-small);
  }
</style>
