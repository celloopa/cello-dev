---
import "@/styles/colors.css";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  image?: string;
  tags?: string[];
  slug: string;
  index?: number;
}

const {
  title,
  description,
  publishDate,
  image,
  tags,
  slug,
  index = 0,
} = Astro.props;

const formattedDate = publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const isVideo = image?.endsWith(".webm") || image?.endsWith(".mp4");
---

<article class="card" style={`--i: ${index}`}>
  <a href={`/blog/${slug}`} class="card-link">
    {
      image && (
        <div class="image-box">
          {isVideo ? (
            <video src={image} autoplay loop muted playsinline />
          ) : (
            <img src={image} alt={title} loading="lazy" />
          )}
          <div class="image-accent" />
        </div>
      )
    }
    <div class="content">
      <span class="date">{formattedDate}</span>
      <h3>{title}</h3>
      <div class="bar"></div>
      <p>{description}</p>
    </div>
  </a>
  {
    tags && tags.length > 0 && (
      <footer>
        <ul class="tags">
          {tags.slice(0, 2).map((tag) => (
            <li>{tag}</li>
          ))}
          {tags.length > 2 && <li class="tag-more">+{tags.length - 2}</li>}
        </ul>
      </footer>
    )
  }
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-canvas);
    border: 3px solid var(--text-primary);
    overflow: hidden;
    animation: enter-rise var(--motion-entry) var(--ease-out) backwards;
    --enter-distance: 40px;
    animation-delay: calc(var(--i) * var(--motion-stagger));
  }

  .card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-accent);
    transform: translateX(-101%);
    transition: transform var(--motion-ui) var(--ease-out);
    z-index: 0;
  }

  .card:hover::before,
  .card:focus-within::before {
    transform: translateX(0);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-accent);
  }

  .card:hover .content,
  .card:hover footer,
  .card:focus-within .content,
  .card:focus-within footer {
    color: var(--bg-canvas);
  }

  .card:hover .date,
  .card:focus-within .date {
    color: var(--bg-canvas);
    border-color: var(--bg-canvas);
  }

  .card:hover .bar,
  .card:focus-within .bar {
    background: var(--bg-canvas);
  }

  .card:hover .tags li,
  .card:focus-within .tags li {
    border-color: var(--bg-canvas);
    color: var(--bg-canvas);
  }

  .card-link {
    display: block;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .image-box {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/10;
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-entry) var(--ease-out);
    filter: grayscale(20%);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-entry) var(--ease-out);
    filter: grayscale(20%);
  }

  .card:hover img,
  .card:hover video,
  .card:focus-within img,
  .card:focus-within video {
    transform: scale(1.08);
    filter: grayscale(0%);
  }

  .image-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(
      to top,
      var(--bg-canvas) 0%,
      transparent 100%
    );
    pointer-events: none;
    transition: opacity var(--motion-ui) var(--ease-out);
  }

  .card:hover .image-accent,
  .card:focus-within .image-accent {
    opacity: 0;
  }

  .content {
    padding: var(--space-20);
    position: relative;
    z-index: 1;
    transition: color var(--motion-ui) var(--ease-out);
  }

  .date {
    display: inline-block;
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    padding: var(--space-4) var(--space-8);
    margin-bottom: var(--space-12);
    transition:
      border-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  h3 {
    font-size: var(--type-heading);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 var(--space-12);
    padding: 0;
    letter-spacing: 0;
  }

  .bar {
    width: 60px;
    height: 4px;
    background: var(--color-accent);
    margin-bottom: var(--space-12);
    transition: background var(--motion-ui) var(--ease-out);
  }

  p {
    font-size: var(--type-ui);
    line-height: 1.5;
    margin: 0;
    padding: 0;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-16) var(--space-20);
    border-top: 2px solid var(--text-primary);
    position: relative;
    z-index: 1;
    transition:
      color var(--motion-ui) var(--ease-out),
      border-color var(--motion-ui) var(--ease-out);
  }

  .card:hover footer,
  .card:focus-within footer {
    border-color: var(--bg-canvas);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tags li {
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--text-primary);
    transition:
      border-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .tags .tag-more {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (width <= 700px) {
    h3 {
      font-size: var(--type-title);
    }

    .content {
      padding: var(--space-16);
    }

    footer {
      padding: var(--space-12) var(--space-16);
    }
  }
</style>
