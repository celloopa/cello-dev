---
/*
 * Card (proposal §7): one story (a case study or a post) as a block of copy: the eyebrow, the
 * title linking to the story, its description, then its meta (two tags and a "+N" count, and
 * the live site). Shared by home's Work list (WorkItem) and the indexes (SceneSelector), which
 * add their own media (the poster media, the place swatch) and layout around it. Replaces the
 * copy of WorkItem and SceneSelector, and ProjectCard/BlogCard's role on the live site.
 *
 *   variant  project  with the live site as an IconButton when `live` is set
 *            post     the same card without the live link (a post has none)
 *   size     lg       a poster row (home's Work list): the title at section-title size
 *            md       an index row (/projects, /blog): the title at heading size
 *   heading  the title's element, h2 or h3, to fit the page's outline
 *   stretch  the title link covers the whole row (its nearest positioned ancestor), so the row
 *            is one target; the live link stays its own target above it
 *   slot "meta"  anything that leads the meta row (the index rows' place name)
 *
 * One hover language, the accent sweep: on hover or focus the title turns green and a 2px rule
 * sweeps in under it. The ring is the global one, on the title link. Copy sits in the text
 * color around it (--text-on-art on scene pages); the eyebrow uses the on-art label color.
 */
import Eyebrow from "./Eyebrow.astro";
import Tag from "./Tag.astro";
import IconButton from "./IconButton.astro";

interface Props {
  variant?: "project" | "post";
  size?: "lg" | "md";
  heading?: "h2" | "h3";
  href: string;
  title: string;
  eyebrow: string;
  description: string;
  tags?: string[];
  live?: string;
  stretch?: boolean;
  class?: string;
}

const {
  variant = "project",
  size = "md",
  heading: Heading = "h3",
  href,
  title,
  eyebrow,
  description,
  tags = [],
  live,
  stretch = false,
  class: className,
  ...rest
} = Astro.props;
const liveUrl = variant === "project" ? live : undefined;
const hasMeta = tags.length > 0 || !!liveUrl || Astro.slots.has("meta");
---

<div class:list={["card", `card--${size}`, stretch && "card--stretch", className]} {...rest}>
  <Eyebrow tone="on-art" class="card-eyebrow">{eyebrow}</Eyebrow>
  <Heading class="card-title"><a href={href}>{title}</a></Heading>
  <p class="card-desc">{description}</p>
  {
    hasMeta && (
      <div class="card-meta">
        <slot name="meta" />
        {tags.length > 0 && (
          <ul class="card-tags">
            {tags.slice(0, 2).map((tag) => (
              <Tag>{tag}</Tag>
            ))}
            {tags.length > 2 && <Tag variant="count">+{tags.length - 2}</Tag>}
          </ul>
        )}
        {liveUrl && (
          <IconButton
            href={liveUrl}
            label={`Visit live site for ${title}`}
            target="_blank"
            rel="noopener noreferrer"
            class="card-live"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path
                d="M13.5 9.75V14.25C13.5 15.4926 12.4926 16.5 11.25 16.5H3.75C2.50736 16.5 1.5 15.4926 1.5 14.25V6.75C1.5 5.50736 2.50736 4.5 3.75 4.5H8.25M11.25 1.5H16.5M16.5 1.5V6.75M16.5 1.5L7.5 10.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </IconButton>
        )}
      </div>
    )
  }
</div>

<style>
  .card-eyebrow {
    margin-bottom: var(--space-8);
  }

  .card-title {
    margin: 0;
    font-family: var(--font-title);
    font-weight: var(--weight-semibold);
  }

  .card--lg .card-title {
    margin-bottom: var(--space-16);
    font-size: var(--type-section-title);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
  }

  .card--md .card-title {
    margin-bottom: var(--space-12);
    font-size: var(--type-heading);
    line-height: var(--leading-heading);
  }

  /* the accent sweep */
  .card-title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% var(--stroke-control);
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      color var(--motion-ui) var(--ease-out),
      background-size var(--motion-ui) var(--ease-out);
  }

  .card-title a:hover,
  .card-title a:focus-visible,
  .card--stretch:hover .card-title a {
    color: var(--action-primary);
    background-size: 100% var(--stroke-control);
  }

  .card--stretch .card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-desc {
    margin: 0;
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .card--lg .card-desc {
    max-width: var(--layout-measure-narrow);
    margin-bottom: var(--space-24);
  }

  .card--md .card-desc {
    max-width: var(--layout-measure);
    margin-bottom: var(--space-16);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-16);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* above a stretched title link, so it stays its own target */
  .card-live {
    position: relative;
    z-index: 1;
  }
</style>
