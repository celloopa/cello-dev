---
/*
 * SceneSelector (A3 item 7, storyboard frame 04; landscape build S3): an index of stories, each
 * with the swatch of the place it opens over. The list sits over the focused scene of an index
 * page (SceneLayout `focus`). With `preview`, pointing at or focusing a story brings its place
 * in behind the list (focused like the scene, so the words keep their contrast); a click or a
 * tap opens the story. Phones just open it.
 * Each row: the swatch and its place name, then today's card content: the eyebrow (role or
 * date), the title, the description, two tags + a count, and the live link if there is one.
 */
import type { SceneArt } from "@/lib/scene/catalog";

export interface SelectorItem {
  href: string;
  title: string;
  eyebrow: string;
  description: string;
  tags?: string[];
  /** The live product, opened in a new tab (case studies only). */
  live?: string;
  scene: SceneArt;
}

interface Props {
  items: SelectorItem[];
  /** Bring the hovered or focused story's place in behind the list (pointer devices). */
  preview?: boolean;
  label: string;
}

const { items, preview = false, label } = Astro.props;
---

<ol class="selector" aria-label={label} data-selector={preview ? "preview" : undefined}>
  {
    items.map((item) => (
      <li class="selector-item" data-preview={preview ? (item.scene.flat ?? item.scene.swatch) : undefined}>
        <a class="selector-swatch" href={item.href} tabindex="-1" aria-hidden="true">
          <img src={item.scene.swatch} alt="" width="480" height="320" loading="lazy" decoding="async" />
        </a>
        <div class="selector-copy">
          <p class="selector-eyebrow">{item.eyebrow}</p>
          <h2 class="selector-title">
            <a href={item.href}>{item.title}</a>
          </h2>
          <p class="selector-desc">{item.description}</p>
          <div class="selector-meta">
            <p class="selector-place">
              {item.scene.place} · {item.scene.month}
            </p>
            {
              item.tags && item.tags.length > 0 && (
                <ul class="selector-tags">
                  {item.tags.slice(0, 2).map((tag) => (
                    <li>{tag}</li>
                  ))}
                  {item.tags.length > 2 && <li>+{item.tags.length - 2}</li>}
                </ul>
              )
            }
            {
              item.live && (
                <a
                  href={item.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="selector-live"
                  aria-label={`Visit live site for ${item.title}`}
                >
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path
                      d="M13.5 9.75V14.25C13.5 15.4926 12.4926 16.5 11.25 16.5H3.75C2.50736 16.5 1.5 15.4926 1.5 14.25V6.75C1.5 5.50736 2.50736 4.5 3.75 4.5H8.25M11.25 1.5H16.5M16.5 1.5V6.75M16.5 1.5L7.5 10.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </li>
    ))
  }
</ol>
{
  preview && (
    <div class="selector-preview" aria-hidden="true" data-selector-preview>
      <img alt="" decoding="async" />
    </div>
  )
}

<script>
  // Preview: the place of the story under the pointer or keyboard focus fades in behind the
  // list. Only on devices that hover; a tap opens the story.
  const list = document.querySelector<HTMLElement>("[data-selector=preview]");
  const layer = document.querySelector<HTMLElement>("[data-selector-preview]");
  const img = layer?.querySelector("img");
  if (list && layer && img && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let current = "";
    const show = (src: string) => {
      if (src === current) return;
      current = src;
      layer.classList.remove("is-on");
      if (!src) return;
      const on = () => current === src && layer.classList.add("is-on");
      img.onload = on;
      img.src = src;
      if (img.complete && img.naturalWidth) on();
    };
    const from = (t: EventTarget | null) => (t instanceof Element ? (t.closest<HTMLElement>("[data-preview]")?.dataset.preview ?? "") : "");
    list.addEventListener("pointerover", (e) => show(from(e.target)));
    list.addEventListener("pointerleave", () => show(from(document.activeElement)));
    list.addEventListener("focusin", (e) => show(from(e.target)));
    list.addEventListener("focusout", (e) => {
      if (!list.contains(e.relatedTarget as Node | null)) show("");
    });
  }
</script>

<style>
  .selector {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--stroke-rule) solid var(--border-muted);
  }

  .selector-item {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: var(--space-32);
    align-items: start;
    padding-block: var(--space-32);
    border-bottom: var(--stroke-rule) solid var(--border-muted);
  }

  .selector-swatch {
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--bg-plate);
    border: var(--stroke-frame) solid var(--text-on-art);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-ground);
    transition:
      transform var(--motion-ui) var(--ease-out),
      box-shadow var(--motion-ui) var(--ease-out);
  }

  .selector-swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .selector-item:hover .selector-swatch,
  .selector-item:focus-within .selector-swatch {
    transform: translate(calc(var(--space-4) * -1), calc(var(--space-4) * -1));
    box-shadow: calc(var(--shadow-offset) + var(--space-4)) calc(var(--shadow-offset) + var(--space-4)) 0 var(--action-primary);
  }

  .selector-copy {
    color: var(--text-on-art);
  }

  .selector-eyebrow,
  .selector-place {
    margin: 0;
    color: var(--text-on-art-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .selector-eyebrow {
    margin-bottom: var(--space-8);
  }

  .selector-place {
    font-family: var(--font-place);
    font-weight: var(--weight-regular);
    letter-spacing: var(--track-caps);
  }

  .selector-title {
    margin: 0 0 var(--space-12);
    font-family: var(--font-title);
    font-size: var(--type-heading);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
  }

  .selector-title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% var(--stroke-control);
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      color var(--motion-ui) var(--ease-out),
      background-size var(--motion-ui) var(--ease-out);
  }

  .selector-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .selector-item {
    position: relative;
  }

  .selector-title a:hover,
  .selector-title a:focus-visible,
  .selector-item:hover .selector-title a {
    color: var(--action-primary);
    background-size: 100% var(--stroke-control);
  }

  .selector-desc {
    max-width: var(--layout-measure);
    margin: 0 0 var(--space-16);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .selector-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-16);
  }

  .selector-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .selector-tags li {
    padding: var(--space-4) var(--space-8);
    border: var(--stroke-control) solid var(--border-strong);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  /* above the row's stretched title link, so it stays its own target */
  .selector-live {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: var(--stroke-control) solid var(--border-strong);
    transition:
      background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .selector-live:hover,
  .selector-live:focus-visible {
    background: var(--action-primary);
    border-color: var(--action-primary);
    color: var(--text-inverse);
  }

  /* the previewed place, behind the list and focused like the page's own scene */
  .selector-preview {
    position: fixed;
    inset: var(--scene-bar) 0 0 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-scene-fade) var(--ease-out);
  }

  .selector-preview.is-on {
    opacity: 1;
  }

  .selector-preview img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: var(--focus-filter);
    transform: scale(var(--focus-scale));
  }

  .selector-preview::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--atmos-read);
  }

  @media (width <= 700px) {
    .selector-item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-20);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selector-item:hover .selector-swatch,
    .selector-item:focus-within .selector-swatch {
      transform: none;
    }
  }
</style>
