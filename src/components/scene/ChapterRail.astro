---
import { projectStories } from "@/data/project-stories";
import Mail from "@/icons/Mail.astro";
interface Props { projects: { slug: string; title: string }[] }
const { projects } = Astro.props;

const stops = [
  { id: "arrival", title: "Home", mark: undefined },
  ...projects.map(p => ({ id: `project-${p.slug}`, title: p.title, mark: projectStories[p.slug]?.mark })),
  { id: "contact", title: "Contact", mark: undefined },
];
---
<nav class="chapter-rail" aria-label="Project timeline">
  <span class="rail-current" aria-hidden="true" data-rail-title>Home</span>
  <ol class="rail-stops">
    {stops.map((stop, i) => <li><a draggable="false" href={`#${stop.id}`} aria-label={stop.title} aria-current={i === 0 ? "location" : undefined}><span class="rail-node" aria-hidden="true">{stop.id === "arrival" ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z" /></svg> : stop.id === "contact" ? <Mail /> : stop.mark?.endsWith(".webp") ? <img src={stop.mark} alt="" width="20" height="20" draggable="false" /> : stop.mark ? <span class="rail-mark" style={`--rail-mark: url('${stop.mark}')`}></span> : null}</span><span class="rail-label" aria-hidden="true">{stop.title}</span></a></li>)}
  </ol>
</nav>
<script>
  const rail = document.querySelector<HTMLElement>(".chapter-rail");
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = links.map(link => document.getElementById(link.hash.slice(1))!);
    const title = rail.querySelector<HTMLElement>("[data-rail-title]")!;
    const list = rail.querySelector<HTMLElement>("ol")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let pending = false;
    const update = () => {
      pending = false;
      const line = innerHeight * .35;
      let current = 0;
      targets.forEach((target, i) => { if (target.getBoundingClientRect().top <= line) current = i; });
      links.forEach((link, i) => { if (i === current) link.setAttribute("aria-current", "location"); else link.removeAttribute("aria-current"); });
      title.textContent = links[current].getAttribute("aria-label");
      const progress = document.documentElement.classList.contains("scene-reading") ? 1 : Math.min(1, Math.max(0, scrollY / (innerHeight * .65)));
      rail.style.setProperty("--rail-rest-scale", String(1.15 * (1 - .1 * progress)));
    };
    const schedule = () => { if (!pending) { pending = true; requestAnimationFrame(update); } };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    addEventListener("pageshow", schedule);
    update();
    // Anchors remain ordinary links with keyboard/no-JS support. Enhance click and drag only.
    const go = (index: number, smooth: boolean) => {
      targets[index].scrollIntoView({ block: "start", behavior: smooth && !reduced.matches ? "smooth" : "instant" });
    };
    let start: { x: number; y: number; id: number } | null = null;
    let dragged = false;
    let last = -1;
    list.addEventListener("pointerdown", event => {
      if (event.button !== 0 || !event.isPrimary) return;
      start = { x: event.clientX, y: event.clientY, id: event.pointerId };
      dragged = false; last = -1;
    });
    list.addEventListener("pointermove", event => {
      if (!start || start.id !== event.pointerId) return;
      const horizontal = matchMedia("(width < 900px)").matches;
      const distance = horizontal ? Math.abs(event.clientX - start.x) : Math.abs(event.clientY - start.y);
      if (!dragged && distance < 6) return;
      dragged = true;
      list.setPointerCapture(event.pointerId);
      const position = horizontal ? event.clientX : event.clientY;
      const centers = links.map(link => { const r = link.getBoundingClientRect(); return horizontal ? r.x + r.width / 2 : r.y + r.height / 2; });
      const index = centers.reduce((best, center, i) => Math.abs(center - position) < Math.abs(centers[best] - position) ? i : best, 0);
      if (index !== last) { last = index; go(index, false); }
    });
    const release = () => { start = null; };
    addEventListener("pointerup", release);
    list.addEventListener("pointercancel", () => { release(); dragged = false; });
    list.addEventListener("click", event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (dragged) { event.preventDefault(); dragged = false; return; }
      const link = (event.target as Element).closest("a");
      if (!link) return;
      event.preventDefault();
      history.replaceState(null, "", link.hash);
      go(links.indexOf(link), true);
    });
  }
</script>
<style>
  .chapter-rail {
    position: fixed;
    z-index: 90;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-primary);
  }
  .rail-current { display: none; }
  .rail-stops { transform: scale(var(--rail-rest-scale, 1.15)); transform-origin: center; transition: transform var(--motion-ui) var(--ease-out); position: relative; margin: 0; padding: 0; list-style: none; touch-action: pan-x; user-select: none; }
  a { position: relative; display: flex; align-items: center; justify-content: center; width: var(--touch-target); height: var(--touch-target); font-size: var(--type-label); font-weight: var(--weight-bold); }
  .rail-stops::before { content: ""; position: absolute; top: calc(var(--touch-target) / 2); bottom: calc(var(--touch-target) / 2); left: 50%; width: var(--stroke-control); transform: translateX(-50%); background: var(--text-muted); box-shadow: 0 0 0 var(--stroke-control) var(--bg-canvas); }
  .rail-node { display: grid; place-items: center; width: var(--space-24); height: var(--space-24); color: var(--text-primary); border-radius: var(--radius-circle); background: var(--bg-canvas); border: var(--stroke-control) solid transparent; box-shadow: 0 0 0 var(--stroke-frame) var(--bg-canvas); }
  a[aria-current] .rail-node { color: var(--action-primary); border-color: var(--action-primary); }
  a:hover .rail-node, a:focus-visible .rail-node { border-color: var(--action-primary); }
  .rail-node :global(svg), .rail-node img, .rail-mark { display: block; width: var(--space-16); height: var(--space-16); }
  .rail-node img { object-fit: contain; }
  .rail-mark { background: currentColor; mask: var(--rail-mark) center / contain no-repeat; -webkit-mask: var(--rail-mark) center / contain no-repeat; }
  .rail-label { position: absolute; right: 100%; padding: var(--space-12) var(--space-16); background: var(--bg-canvas); color: var(--text-primary); border: var(--stroke-control) solid var(--border-strong); white-space: nowrap; visibility: hidden; }
  a:hover .rail-label, a:focus-visible .rail-label { visibility: visible; }
  @media (width < 900px) {
    .chapter-rail { inset: auto auto max(var(--space-12),env(safe-area-inset-bottom)) 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - var(--space-24)); padding-inline: var(--space-12); background: var(--bg-canvas); }
    .rail-current { display: block; padding: var(--space-8) 0 0; text-align: center; max-width: calc(var(--touch-target) * 6); font-size: var(--type-label); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rail-stops { display: flex; touch-action: pan-y; }
    li { flex: 1; min-width: 0; }
    a { width: var(--touch-target); }
    .rail-stops::before { top: 50%; bottom: auto; left: calc(var(--touch-target) / 2); right: calc(var(--touch-target) / 2); width: auto; height: var(--stroke-control); transform: translateY(-50%); }
    .rail-label { display: none; }
  }
  @media (hover: hover) { .chapter-rail:hover .rail-stops { transform: scale(1.15); } }
  .chapter-rail:has(a:focus-visible) .rail-stops { transform: scale(1.15); }
  @media (prefers-reduced-motion: reduce) { .rail-stops { transition: none; } }
  @media print { .chapter-rail { display: none; } }
</style>
