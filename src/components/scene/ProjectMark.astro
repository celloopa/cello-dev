---
import { projectStories } from '@/data/project-stories';
interface Props { slug: string }
const mark = projectStories[Astro.props.slug]?.mark;
---
{mark && <span class="project-mark" aria-hidden="true">{mark.endsWith('.webp') ? <img src={mark} alt="" width="48" height="48" /> : <span style={`--project-mark: url('${mark}')`}></span>}</span>}
<style>
.project-mark { display: inline-flex; flex: none; width: 48px; height: 48px; align-items: center; justify-content: center; }
.project-mark img { width: 100%; height: 100%; object-fit: contain; }
.project-mark > span { display: block; width: 100%; height: 100%; background: currentColor; mask: var(--project-mark) center / contain no-repeat; }
</style>
