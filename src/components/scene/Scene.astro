---
import { loadScene } from "@/lib/scene/catalog";
import SceneFrame from "./SceneFrame.astro";
interface Props { place: string; guide?: boolean; focused?: boolean; backdrops?: string[]; choices?: string[]; }
const { place, guide, focused, backdrops, choices = [] } = Astro.props;
const options = [...new Set(choices)];
---
{options.length > 0 ? <>
  <noscript><SceneFrame scene={loadScene(place)} {guide} {focused} {backdrops} /></noscript>
  {options.map(id => <template data-scene-choice={id}><SceneFrame scene={loadScene(id)} {guide} {focused} {backdrops} /></template>)}
  <script is:inline>
    (() => {
      const templates = [...document.querySelectorAll("template[data-scene-choice]")];
      if (!templates.length) return;
      const ids = templates.map(t => t.dataset.sceneChoice);
      const requested = new URLSearchParams(location.search).get("scene");
      let selected = ids.includes(requested) ? requested : null;
      if (!selected) {
        let previous;
        try { previous = sessionStorage.getItem("cello-hero-scene"); } catch { /* storage is optional */ }
        const candidates = ids.filter(id => id !== previous);
        selected = candidates[Math.floor(Math.random() * candidates.length)] || ids[0];
        try { sessionStorage.setItem("cello-hero-scene", selected); } catch { /* storage is optional */ }
      }
      const chosen = templates.find(t => t.dataset.sceneChoice === selected) || templates[0];
      // Inert templates fetch no art. Mount one complete scene before the greeting or modules.
      chosen.before(chosen.content.cloneNode(true));
      templates.forEach(t => t.remove());
    })();
  </script>
</> : <SceneFrame scene={loadScene(place)} {guide} {focused} {backdrops} />}
<script>
  import { start } from "@/lib/scene/scenery.js";
  start();
</script>
