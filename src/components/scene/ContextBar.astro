---
/*
 * ContextBar (amendment A3; D5): the dark green top bar on scene pages.
 *   exploring  identity + Work, with About and the other utilities kept separate
 *   reading    the project in view + "All work" (scenery.js fills the title and sets
 *              html.scene-reading)
 * A reading page (a case study or a post) is in the reading context from the first paint: its
 * title and "All" link are server-rendered here, and the menu and theme buttons stay, since
 * the page never returns to exploring.
 * The menu button and ⌘K open today's KeyboardShortcutsMenu. Scene pages hold one grade, so there
 * is no theme button here (Layout pages keep theirs).
 */
import Mark from "./Mark.astro";
import Button from "@/components/ui/Button.astro";

interface Props {
  /** A reading page's title, shown from the first paint (else scenery.js names the stop in view). */
  context?: string;
  /** Where the reading context's "All" link goes: All work, or All posts on a post. */
  all?: { href: string; label: string };
}

const { context = "", all = { href: "/projects", label: "All work" } } = Astro.props;

const utilities = [
  { label: "About", href: "/about" },
  { label: "Writing", href: "/blog" },
  { label: "Design System", href: "/design-system" },
  { label: "Resume", href: "/resume" },
];
const path = Astro.url.pathname;
// the current item (aria-current, §7): "page" on the page itself, "true" under it
const current = (href: string) => {
  const p = path.replace(/\/$/, "");
  return p === href ? "page" : p.startsWith(`${href}/`) ? "true" : undefined;
};
---

<header class="bar">
  <nav class="bar-inner" aria-label="Main">
    <div class="bar-start">
      <a class="bar-brand" href="/" aria-label="Cello, home">
        <Mark class="bar-mark" />
      </a>
      <div class="bar-actions">
        <Button
          class="bar-menu"
          variant="secondary"
          size="sm"
          data-bar-menu
          aria-haspopup="dialog"
          aria-controls="keyboard-shortcuts-menu"
          aria-keyshortcuts="Meta+K Control+K"
        >
          <span class="bar-key" data-bar-key></span>
          <span class="bar-menu-word">Menu</span>
        </Button>
      </div>
      <div class="bar-context" data-scene-context>
        <span class="bar-context-title" data-scene-context-title>{context}</span>
        <a class="bar-allwork" href={all.href}>{all.label}</a>
      </div>
    </div>
    <ul class="bar-utils">
      <li class="bar-work"><a class="bar-link" href="/projects" aria-current={current("/projects")}>Work</a></li>
      {
        utilities.map((u) => (
          <li>
            <a class="bar-link" href={u.href} aria-current={current(u.href)}>
              {u.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // The key label (⌘K / Ctrl+K, or a dot on touch screens) is set before paint by SceneLayout's
  // head script (html.touch and --bar-kbd), so the bar never shifts when this runs.
  const menu = document.querySelector<HTMLButtonElement>("[data-bar-menu]");
  if (menu) {
    menu.setAttribute("aria-expanded", "false");
    // focus first, so the menu hands focus back here when it closes (touch taps don't focus buttons)
    menu.addEventListener("click", () => { menu.focus(); window.dispatchEvent(new CustomEvent("toggleKeyboardMenu")); });
    addEventListener("menuVisibilityChanged", (event) => {
      menu.setAttribute("aria-expanded", String((event as CustomEvent<{ isVisible: boolean }>).detail.isVisible));
    });
  }</script>

<style>
  /* Corners, not a band: the scene runs to the top edge. Identity and the menu hold the top-left
     corner while you scroll; the page links stack in the top-right and scroll away with the page.
     Phones (< 900px) put the logo and menu in one fixed top row; home's project rail sits between. */
  :global(html.scene-page) {
    --scene-bar: 0px;
  }

  :global(html.scene-page:not(:has(.chapter-rail)) main) {
    padding-top: var(--space-64);
  }

  .bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--text-primary);
    pointer-events: none;
  }

  .bar-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-24);
    padding: var(--space-16);
  }

  .bar-start {
    position: fixed;
    top: var(--space-16);
    left: var(--space-16);
    display: flex;
    align-items: center;
    gap: var(--space-8);
    pointer-events: auto;
  }

  .bar-utils {
    display: grid;
    justify-items: end;
    gap: var(--space-8);
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  /* home reaches the work by its rail and greeting; every other page lists it first */
  :global(html:has(.chapter-rail)) .bar-work {
    display: none;
  }

  .bar-brand {
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    background: var(--bg-canvas);
  }

  .bar-brand :global(.bar-mark) {
    width: var(--space-24);
    height: var(--space-24);
  }

  .bar-link,
  .bar-allwork {
    display: block;
    padding: var(--space-8) var(--space-12);
    background: var(--bg-canvas);
    border-bottom: var(--stroke-control) solid transparent;
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    transition:
      border-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .bar-link {
    color: var(--text-muted);
  }

  .bar-link:hover,
  .bar-link:focus-visible,
  .bar-link[aria-current] {
    color: var(--text-primary);
    border-bottom-color: var(--action-primary);
  }

  .bar-actions {
    display: flex;
    flex: none;
    gap: var(--space-8);
  }


  .bar-key {
    padding-inline: var(--space-4);
    background: var(--text-primary);
    color: var(--bg-canvas);
  }

  .bar-menu:hover .bar-key,
  .bar-menu:focus-visible .bar-key {
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  .bar-key::before {
    content: var(--bar-kbd, "");
  }

  :global(html:not(.js)) .bar-key {
    display: none;
  }

  :global(html.touch) .bar-key {
    width: var(--space-8);
    height: var(--space-8);
    padding: 0;
    background: var(--action-primary);
  }

  :global(html.touch) .bar-key::before {
    content: none;
  }

  /* reading: the project in view + All work join the corner; the page links step aside */
  .bar-context {
    display: none;
    min-width: 0;
    align-items: center;
    gap: var(--space-8);
  }

  .bar-context-title {
    max-width: 28ch;
    padding: var(--space-8) var(--space-12);
    overflow: hidden;
    background: var(--bg-canvas);
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-on-art-muted);
  }

  .bar-context-title:empty {
    display: none;
  }

  .bar-allwork {
    flex: none;
    border-bottom-color: var(--action-primary);
  }

  :global(html.scene-reading) .bar-context {
    display: flex;
    animation: enter-fade var(--motion-handoff) var(--ease-out);
  }

  :global(html.scene-reading) .bar-utils {
    display: none;
  }

  :global(html.scene-read-page) .bar-context {
    animation: none;
  }

  /* a reading page already names itself in its heading */
  :global(html.scene-read-page) .bar-context-title {
    display: none;
  }

  @media (width < 900px) {
    .bar-start {
      inset: max(var(--space-12), env(safe-area-inset-top)) var(--space-12) auto;
      justify-content: space-between;
      pointer-events: none; /* the row's empty middle belongs to home's rail */
    }

    .bar-start > * {
      pointer-events: auto;
    }

    .bar-utils {
      display: none;
    }

    .bar-actions {
      order: 3;
    }

    .bar-context-title {
      display: none;
    }

    /* the menu keeps its dot and its name, not its word */
    .bar-actions :global(.bar-menu) {
      min-width: var(--touch-target);
      padding-inline: var(--space-12);
      justify-content: center;
    }

    .bar-menu-word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* home: the rail takes the middle of the row */
    :global(html:has(.chapter-rail)) .bar-context {
      display: none;
    }
  }
</style>
