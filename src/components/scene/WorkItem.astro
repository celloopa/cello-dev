---
/*
 * One case study in the scene's Work list: today's ProjectCard content (media, role, title,
 * description, two tech tags + count, the live-site link), set as a poster row over the focused
 * scene. A reading stop: the bar names it while it's in view.
 */
import IconButton from "@/components/ui/IconButton.astro";
import Tag from "@/components/ui/Tag.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  techStack: string[];
  role: string;
  slug: string;
  index?: number;
}

const { title, description, image, url, techStack, role, slug, index = 0 } = Astro.props;
const isVideo = image?.endsWith(".webm") || image?.endsWith(".mp4");
const href = `/projects/${slug}`;
---

<li class="work-item" data-scene-stop={title} data-flip={index % 2 === 1 ? "" : undefined}>
  <a class="work-media" href={href} tabindex="-1" aria-hidden="true">
    {
      image ? (
        isVideo ? (
          <video src={image} muted loop playsinline preload="none" data-work-video />
        ) : (
          <img src={image} alt="" loading="lazy" decoding="async" />
        )
      ) : (
        <span class="work-media-empty" />
      )
    }
  </a>
  <div class="work-copy">
    <p class="work-role">{role}</p>
    <h3 class="work-title"><a href={href}>{title}</a></h3>
    <p class="work-desc">{description}</p>
    <div class="work-meta">
      <ul class="work-tags">
        {techStack.slice(0, 2).map((tech) => (
          <Tag>{tech}</Tag>
        ))}
        {techStack.length > 2 && <Tag variant="count">+{techStack.length - 2}</Tag>}
      </ul>
      {
        url && (
          <IconButton href={url} target="_blank" rel="noopener noreferrer" label={`Visit live site for ${title}`}>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path
                d="M13.5 9.75V14.25C13.5 14.8467 13.2629 15.419 12.841 15.841C12.419 16.2629 11.8467 16.5 11.25 16.5H3.75C3.15326 16.5 2.58097 16.2629 2.15901 15.841C1.73705 15.419 1.5 14.8467 1.5 14.25V6.75C1.5 6.15326 1.73705 5.58097 2.15901 5.15901C2.58097 4.73705 3.15326 4.5 3.75 4.5H8.25M11.25 1.5H16.5M16.5 1.5V6.75M16.5 1.5L7.5 10.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </IconButton>
        )
      }
    </div>
  </div>
</li>

<style>
  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-48);
    align-items: center;
    min-height: 72svh;
    padding-block: var(--space-32);
  }

  .work-item[data-flip] .work-media {
    order: 2;
  }

  .work-media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-canvas);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-ground);
    transition: transform var(--motion-ui) var(--ease-out);
  }

  .work-item:hover .work-media {
    transform: translate(-4px, -4px);
  }

  .work-media img,
  .work-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-role {
    margin: 0 0 var(--space-12);
    color: var(--text-on-art-muted);
    font-size: var(--type-label);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }

  .work-title {
    margin: 0 0 var(--space-16);
    color: var(--text-on-art);
    font-family: var(--font-title);
    font-size: var(--type-section-title);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
  }

  .work-title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% var(--stroke-control);
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      color var(--motion-ui) var(--ease-out),
      background-size var(--motion-ui) var(--ease-out);
  }

  .work-title a:hover,
  .work-title a:focus-visible {
    color: var(--action-primary);
    background-size: 100% var(--stroke-control);
  }

  .work-desc {
    max-width: var(--layout-measure-narrow);
    margin: 0 0 var(--space-24);
    color: var(--text-on-art);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width <= 700px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: var(--space-24);
      min-height: auto;
      padding-block: var(--space-48);
    }

    .work-item[data-flip] .work-media {
      order: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-item:hover .work-media {
      transform: none;
    }
  }
</style>
