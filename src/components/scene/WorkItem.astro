---
/* Large product artifacts stay in the DOM; project marks repeat the rail’s destinations. */
import MediaVideo from "@/components/media/MediaVideo.astro";
import ArrowLink from "@/components/ui/ArrowLink.astro";
import ProjectMark from "./ProjectMark.astro";
import { projectStories } from "@/data/project-stories";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  techStack: string[];
  role: string;
  slug: string;
  index?: number;
  /** The scene this case study is paired with (a backdrop on home's Scene). */
  place?: string;
}

const { title, description, image, url, role, slug, index = 0, place } = Astro.props;
const isVideo = image?.endsWith(".webm") || image?.endsWith(".mp4");
const story = projectStories[slug];
const href = `/projects/${slug}`;
---

<li id={`project-${slug}`} class="work-item" data-scene-stop={title} data-scene-backdrop={place} data-flip={index % 2 === 1 ? "" : undefined}>
  <div class="work-media">
    {
      image ? (
        isVideo ? (
          <MediaVideo src={image} label={`${title} preview`} />
        ) : (
          <a href={href} tabindex="-1" aria-hidden="true"><img src={image} alt="" loading="lazy" decoding="async" /></a>
        )
      ) : (
        <span class="work-media-empty" />
      )
    }
  </div>
  <div class="work-copy">
    <p class="work-role">{role}</p>
    <h3><a href={href}><ProjectMark slug={slug} />{title}</a></h3>
    <p>{story?.problem || description}</p>
    {story && <p class="work-outcome">{story.outcome}</p>}
    <div class="work-actions">
      <ArrowLink href={href}>Read case study</ArrowLink>
      {url && <a href={url} target="_blank" rel="noopener noreferrer">View live ↗</a>}
    </div>
  </div>
</li>

<style>
  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr);
    gap: var(--space-48);
    align-items: center;
    min-height: 72svh;
    padding-block: var(--space-32);
  }

  .work-item[data-flip] { grid-template-columns: minmax(0, 1fr) minmax(0, 2.3fr); }

  .work-item[data-flip] .work-media {
    order: 2;
  }

  .work-media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-canvas);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-ground);
    transition: transform var(--motion-ui) var(--ease-out);
  }

  .work-copy { min-width: 0; color: var(--text-on-art); }
  .work-role { font-size: var(--type-small); text-transform: uppercase; letter-spacing: var(--track-caps); }
  h3 { font-family: var(--font-title); font-size: var(--type-hero-line); line-height: var(--leading-tight); margin: var(--space-12) 0 var(--space-24); }
  h3 a { display: flex; align-items: center; gap: var(--space-12); color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--text-accent); }
  .work-copy > p { line-height: var(--leading-read); }
  .work-outcome { font-size: var(--type-small); }
  .work-actions { display: flex; flex-wrap: wrap; gap: var(--space-16); margin-top: var(--space-24); align-items: center; }
  .work-actions > a { color: inherit; font-size: var(--type-small); }

  .work-media :global(img),
  .work-media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .work-media :global(.media-video),
  .work-media > a { display: block; height: 100%; }

  @media (width <= 900px) {
    .work-item, .work-item[data-flip] {
      grid-template-columns: 1fr;
      gap: var(--space-24);
      min-height: auto;
      padding-block: var(--space-48);
    }

    .work-item[data-flip] .work-media {
      order: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-item:hover .work-media {
      transform: none;
    }
  }
</style>
