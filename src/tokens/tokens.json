    {
      "family": "Switchback",
      "src": "/fonts/switchback/Switchback-Regular.woff2",
      "weight": "400",
      "$description": "the place-name role (I4). NPS-inspired open set, OFL 1.1, self-hosted beside its OFL.txt (files approved by Cello, 2026-10-12)."
    },
    {
      "family": "Switchback Rough",
      "src": "/fonts/switchback/Switchback-Rough.woff2",
      "weight": "400",
      "$description": "Switchback's weathered sibling, for lettering inside art only (I4). OFL 1.1."
    }
  ],
