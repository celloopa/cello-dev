        { "css": "--ds-color-paper-100", "$value": "#f3ede2", "$description": "Paper 100. The light canvas from stage 3 (Q3)." },
        { "css": "--ds-color-paper-200", "$value": "#e0e0e0", "$description": "Starlight. Dark-mode text; today's light canvas." },
        { "css": "--ds-color-earth-500", "$value": "#887850", "$description": "Earth. The logo triangle." },
        { "css": "--ds-color-earth-600", "$value": "#6f613e", "$description": "Deep Earth. Light-mode accent today." },
