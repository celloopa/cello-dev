{
  "$description": "The only hand-edited source for cello.dev's design tokens. Run `pnpm tokens` after editing; it writes src/styles/tokens.css. Values with {dark, light} are theme modes: dark is the :root default, light applies under [data-theme=\"light\"]. See docs/design-system/proposal.md.",
  "groups": [
    {
      "name": "Primitives: color",
      "tokens": [
        { "css": "--ds-color-ink-950", "$value": "#001a11", "$description": "Midnight Ink. Dark canvas, light-mode text." },
