        { "css": "--ds-color-signal-500", "$value": "#00bc44", "$description": "Signal Green. Action in dark mode, the logo sun." },
        { "css": "--ds-color-blueprint-500", "$value": "#42a5ff", "$description": "Blueprint. Construction lines only, never text or action (Q6)." },
        { "css": "--ds-color-coral-500", "$value": "#ff6b4a", "$description": "Coral. Being removed (Q6); still shown on /design-system." }
